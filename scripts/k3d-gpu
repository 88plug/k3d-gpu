#!/usr/bin/env bash
# k3d-gpu — bootstrap an accelerator-ready k3d cluster using the cryptoandcoffee/k3d-gpu image
# Manage GPU/HPU-ready k3d clusters. https://github.com/88plug/k3d-gpu
#
# Supported accelerators (auto-detected on the host, no flags needed):
#   nvidia  NVIDIA GPUs                                   -> nvidia.com/gpu
#   intel   Intel GPUs: Arc/Battlemage/Crescent Island and the integrated GPU in
#           Core Ultra APUs (xe or i915)                  -> gpu.intel.com/xe, gpu.intel.com/i915
#   npu     Intel NPU in Core Ultra (Meteor/Arrow/Lunar/Panther Lake and newer)
#                                                         -> npu.intel.com/accel
#   gaudi   Intel Gaudi (HPU, Gaudi 3)                    -> habana.ai/gaudi
#   dsa     Intel DSA work queues (Xeon)                  -> dsa.intel.com/wq-user-*
#   iaa     Intel IAA work queues (Xeon, Panther Lake)    -> iaa.intel.com/wq-user-*
#   qat     Intel QAT virtual functions (Xeon)            -> qat.intel.com/<services>
#   amx     Intel AMX (Xeon CPU instructions)             -> node labels feature.node.kubernetes.io/cpu-cpuid.AMX*
#   hybrid  Intel hybrid CPUs (P-cores + E-cores, Alder Lake and newer)
#                                                         -> node label k3d-gpu.io/hybrid-cpu=true; pods
#           labelled k3d-gpu.io/cores=performance|efficient are pinned to P- or E-cores by
#           the NRI balloons policy (nri-plugins), everything else keeps every CPU
#   numa    more than one NUMA node (multi-socket or SNC Xeon, HBM/CXL memory nodes)
#                                                         -> node labels k3d-gpu.io/numa-nodes=<n>,
#           k3d-gpu.io/snc=<nodes per L3>; pods labelled k3d-gpu.io/cores=replica get a
#           balloon inside one NUMA node, memory pinned to it, near their devices
#           DSA/IAA/QAT need host setup first (work queues / SR-IOV VFs); doctor says what is missing.
#   up also labels nodes with CPU ISA extensions (NFD cpu-cpuid names), Intel GPU XMX and
#   media engine counts, and the NPU generation; doctor prints the labels.
#
# Subcommands:
#   up      create cluster, verify each detected accelerator is schedulable
#   down    delete cluster
#   test    run a pod per detected accelerator and print the device view
#   detect  print the accelerators found on this host and their k8s resources
#   doctor  preflight: accelerators present, docker running, runtimes, k3d installed
#           --perf: read-only host tuning advisor for inference serving
#   logs    tail server container logs
#   host-setup  check the host userspace and print (--apply: run) the pinned install commands

set -euo pipefail

CLUSTER="${K3D_GPU_CLUSTER:-gpu}"
IMAGE="${K3D_GPU_IMAGE:-cryptoandcoffee/k3d-gpu:latest}"
SHARE_DIR="${K3D_GPU_SHARE:-/usr/share/k3d-gpu}"
PLUGIN_MANIFEST="${K3D_GPU_PLUGIN:-${SHARE_DIR}/nvidia-device-plugin.yml}"
INTEL_PLUGIN_MANIFEST="${K3D_GPU_INTEL_PLUGIN:-${SHARE_DIR}/intel-gpu-plugin.yml}"
GAUDI_PLUGIN_MANIFEST="${K3D_GPU_GAUDI_PLUGIN:-${SHARE_DIR}/gaudi-device-plugin.yml}"
NPU_PLUGIN_MANIFEST="${K3D_GPU_NPU_PLUGIN:-${SHARE_DIR}/intel-npu-plugin.yml}"
DSA_PLUGIN_MANIFEST="${K3D_GPU_DSA_PLUGIN:-${SHARE_DIR}/intel-dsa-plugin.yml}"
IAA_PLUGIN_MANIFEST="${K3D_GPU_IAA_PLUGIN:-${SHARE_DIR}/intel-iaa-plugin.yml}"
QAT_PLUGIN_MANIFEST="${K3D_GPU_QAT_PLUGIN:-${SHARE_DIR}/intel-qat-plugin.yml}"
HYBRID_PLUGIN_MANIFEST="${K3D_GPU_HYBRID_PLUGIN:-${SHARE_DIR}/nri-balloons.yml}"
SYSROOT="${K3D_GPU_SYSROOT:-}" # prefix for /sys and /dev reads (tests point it at a fake tree)
TEST_IMAGE="${K3D_GPU_TEST_IMAGE:-nvidia/cuda:13.4.2-base-ubuntu26.04}"
DEVICE_TEST_IMAGE="${K3D_GPU_DEVICE_TEST_IMAGE:-busybox:1.37}"
VENDORS_REQUEST="${K3D_GPU_VENDORS:-auto}"
FAIL=0           # set by doctor_* checks
INTEL_DRIVERS=() # "<driver> <pci-device-id>" per Intel render node (filled by detect_intel)
NPU_IDS=()       # PCI device id per Intel NPU accel node (filled by detect_npu)
VERSION="0.1.14"  # kept in lockstep with packaging/aur PKGBUILD by auto-release.yml

RED=$'\e[31m' GRN=$'\e[32m' YLW=$'\e[33m' RST=$'\e[0m'
err()  { echo "${RED}ERROR:${RST} $*" >&2; exit 1; }
info() { echo "${GRN}==>${RST} $*"; }
warn() { echo "${YLW}WARN:${RST} $*" >&2; }

usage() {
    cat <<EOF
k3d-gpu ${VERSION} — accelerator-ready k3d clusters (NVIDIA, Intel GPU/iGPU/NPU/Gaudi, Xeon DSA/IAA/QAT/AMX/NUMA, hybrid P/E cores)

Usage: k3d-gpu <command>

  up        Create cluster '${CLUSTER}' with passthrough for every detected accelerator
  down      Delete cluster '${CLUSTER}'
  test      Run a pod per detected accelerator and print its device view
  detect    Print accelerators found on this host and their Kubernetes resources
  doctor    Diagnostic preflight checks
  doctor --perf [--model-gb N]
            Read-only host tuning advisor for inference (CPU/GPU clocks, power
            limits, THP, swap, IRQs, persistence): evidence, why, apply + revert
  logs      Tail k3s server container logs
  host-setup [--apply] [--distro D]
            Check the host drivers/userspace (vainfo, clinfo, libva, libstdc++) and print
            the pinned install commands for Intel GPU/NPU and the NVIDIA container
            toolkit + CDI (Ubuntu 24.04/26.04, Fedora, Arch, Manjaro). --apply runs
            them after a y/N prompt
  version   Show version
  help      Show this message

Environment:
  K3D_GPU_CLUSTER       cluster name         (default: gpu)
  K3D_GPU_IMAGE         k3s node image       (default: cryptoandcoffee/k3d-gpu:latest)
  K3D_GPU_VENDORS       auto | comma list of nvidia,intel,npu,gaudi,dsa,iaa,qat,amx,hybrid,numa (default: auto)
  K3D_GPU_SHARE         dir holding the fallback plugin yamls (default: /usr/share/k3d-gpu)
  K3D_GPU_PLUGIN        NVIDIA plugin yaml   (default: ${SHARE_DIR}/nvidia-device-plugin.yml)
  K3D_GPU_INTEL_PLUGIN  Intel GPU plugin yaml  (default: ${SHARE_DIR}/intel-gpu-plugin.yml)
  K3D_GPU_GAUDI_PLUGIN  Gaudi plugin yaml    (default: ${SHARE_DIR}/gaudi-device-plugin.yml)
  K3D_GPU_NPU_PLUGIN    Intel NPU plugin yaml  (default: ${SHARE_DIR}/intel-npu-plugin.yml)
  K3D_GPU_DSA_PLUGIN    Intel DSA plugin yaml  (default: ${SHARE_DIR}/intel-dsa-plugin.yml)
  K3D_GPU_IAA_PLUGIN    Intel IAA plugin yaml  (default: ${SHARE_DIR}/intel-iaa-plugin.yml)
  K3D_GPU_QAT_PLUGIN    Intel QAT plugin yaml  (default: ${SHARE_DIR}/intel-qat-plugin.yml)
  K3D_GPU_HYBRID_PLUGIN NRI balloons yaml for hybrid and numa (default: ${SHARE_DIR}/nri-balloons.yml)
  K3D_GPU_MODEL_GB      model size checked by doctor --perf (same as --model-gb)

Docs: https://github.com/88plug/k3d-gpu
EOF
}

require() {
    command -v "$1" >/dev/null 2>&1 || err "'$1' not found in PATH — see 'k3d-gpu doctor'"
}

# ---- accelerator detection --------------------------------------------------
# Each detector reads the host only (device nodes / sysfs), never the cluster.

# NVIDIA: device nodes appear only after first use on some hosts, so also accept
# the loaded kernel module.
has_nvidia() {
    [ -e "${SYSROOT}/dev/nvidiactl" ] || [ -e "${SYSROOT}/dev/nvidia0" ] || [ -d "${SYSROOT}/sys/module/nvidia" ]
}

# Name of the kernel driver bound to a sysfs device dir, or empty.
bound_driver() {
    local link
    link=$(readlink -f "$1/driver" 2>/dev/null) || return 0
    [ -n "${link}" ] && [ -e "${link}" ] && basename "${link}"
    return 0
}

# Fills INTEL_DRIVERS with "<driver> <pci-device-id>" per Intel DRM render node
# bound to xe or i915.
detect_intel() {
    INTEL_DRIVERS=()
    local dev drv
    for dev in "${SYSROOT}"/sys/class/drm/renderD*/device; do
        [ -r "${dev}/vendor" ] || continue
        [ "$(cat "${dev}/vendor")" = "0x8086" ] || continue
        drv=$(bound_driver "${dev}")
        case "${drv}" in xe|i915) INTEL_DRIVERS+=("${drv} $(cat "${dev}/device" 2>/dev/null)") ;; esac
    done
    return 0
}

# Print "<pci-vendor> <driver> <pci-device-id>" per /dev/accel/accelN compute
# node. The Intel NPU (intel_vpu, 0x8086) and Gaudi (habanalabs, 0x1da3) both
# register here, so the node name alone never identifies the accelerator.
# A sysfs PCI id attribute ("0x8086"), or "-" when it is missing or malformed.
# Callers split the output on whitespace, so nothing else may pass through.
pci_id() {
    local v
    v=$(cat "$1" 2>/dev/null) || v=""
    [[ "${v}" =~ ^0x[0-9a-fA-F]{4}$ ]] && echo "${v}" || echo "-"
}

accel_nodes() {
    local dev drv
    for dev in "${SYSROOT}"/sys/class/accel/accel[0-9]*/device; do
        [ -r "${dev}/vendor" ] || continue
        drv=$(bound_driver "${dev}")
        echo "$(pci_id "${dev}/vendor") ${drv:--} $(pci_id "${dev}/device")"
    done
}

# Fills NPU_IDS with the PCI device id of each Intel NPU bound to intel_vpu.
detect_npu() {
    NPU_IDS=()
    local vendor drv id
    while read -r vendor drv id; do
        [ "${vendor}" = "0x8086" ] && [ "${drv}" = "intel_vpu" ] && NPU_IDS+=("${id}")
    done < <(accel_nodes)
    return 0
}

# Gaudi: an accel node owned by a Habana device, a loaded habanalabs driver, or
# legacy /dev/hl* nodes from older out-of-tree drivers.
has_gaudi() {
    # Not grep -q: an early exit SIGPIPEs accel_nodes and pipefail turns a match into failure.
    accel_nodes | grep '^0x1da3 ' >/dev/null \
        || [ -d "${SYSROOT}/sys/module/habanalabs" ] \
        || compgen -G "${SYSROOT}/dev/hl[0-9]*" >/dev/null
}

# Habana PCI device present (vendor 0x1da3) regardless of driver state.
has_gaudi_pci() {
    local v
    for v in "${SYSROOT}"/sys/bus/pci/devices/*/vendor; do
        [ -r "${v}" ] || continue
        [ "$(cat "${v}")" = "0x1da3" ] && return 0
    done
    return 1
}

# DSA/IAA: user work queues configured on the host (accel-config) show up as
# /dev/dsa/wqX.Y and /dev/iax/wqX.Y. Devices without queues expose nothing.
has_dsa() { compgen -G "${SYSROOT}/dev/dsa/wq*" >/dev/null; }
has_iaa() { compgen -G "${SYSROOT}/dev/iax/wq*" >/dev/null; }

# QAT physical function ids (C62x, 4xxx, 401xx, 402xx, 420xx, 6xxx) and the PF
# drivers the plugin pairs with its kernel VF drivers.
QAT_PF_IDS="0x37c8 0x4940 0x4942 0x4944 0x4946 0x4948"
QAT_PF_DRIVERS="c6xx 4xxx 420xx 6xxx"

# QAT: a PF bound to its QAT driver with SR-IOV VFs created. The plugin binds the
# VFs to vfio-pci itself, so creating them is the only host step it needs.
has_qat() {
    local dev
    for dev in "${SYSROOT}"/sys/bus/pci/devices/*; do
        [[ " ${QAT_PF_DRIVERS} " == *" $(bound_driver "${dev}") "* ]] || continue
        compgen -G "${dev}/virtfn*" >/dev/null && return 0
    done
    return 1
}

# The first CPU's /proc/cpuinfo flags, one per line.
cpu_flags() {
    local flags
    flags=$(grep -m1 '^flags[[:space:]]*:' "${SYSROOT}/proc/cpuinfo" 2>/dev/null || true)
    tr ' ' '\n' <<< "${flags#*:}"
}

# AMX feature flags from /proc/cpuinfo, sorted, one line (empty when absent).
amx_flags() {
    # Kernel flag names are [a-z0-9_]; anything else is not a flag and must not
    # become a node label.
    cpu_flags | LC_ALL=C grep -E '^amx_[a-z0-9_]+$' | sort | paste -sd' ' || true
}

# NFD-style node labels for the host's AMX flags (amx_tile -> ...cpu-cpuid.AMXTILE=true).
amx_labels() {
    local f
    for f in $(amx_flags); do
        f=${f//_/}
        echo "feature.node.kubernetes.io/cpu-cpuid.${f^^}=true"
    done
}

# NFD's cpuid label name for a /proc/cpuinfo flag, or nothing. NFD names its
# cpu-cpuid labels after klauspost/cpuid feature ids (NFD v0.20.0
# source/cpu/cpuid_amd64.go: cpuid.CPU.FeatureSet(), cpuid v2.4.0). Listed: the
# flags that kernels 6.6 and newer print (arch/x86/include/asm/cpufeatures.h) and
# that NFD names. avx_ifma and amx_fp16 are hidden from cpuinfo, avx_vnni_int8,
# avx_vnni_int16 and avx_ne_convert are KVM-only, and pku has no NFD feature, so
# none of them is here. amx_* flags belong to the amx vendor (amx_labels).
nfd_cpuid_name() {
    case "$1" in
        avx_vnni)    echo AVXVNNI ;;
        avx512f)     echo AVX512F ;;
        avx512_vnni) echo AVX512VNNI ;;
        avx512_bf16) echo AVX512BF16 ;;
        vaes)        echo VAES ;;
        gfni)        echo GFNI ;;
        sha_ni)      echo SHA ;;
        ibt)         echo CETIBT ;;
        user_shstk)  echo CETSS ;;
    esac
}

# NFD-style node labels for the CPU's ISA extensions (avx_vnni -> ...cpu-cpuid.AVXVNNI=true), sorted.
cpu_isa_labels() {
    local f n
    while IFS= read -r f; do
        n=$(nfd_cpuid_name "${f}")
        [ -z "${n}" ] || echo "feature.node.kubernetes.io/cpu-cpuid.${n}=true"
    done < <(cpu_flags) | LC_ALL=C sort -u
}

# "<cpu family> <model>" of the first CPU in decimal; nothing when cpuinfo lacks either.
cpu_family_model() {
    awk -F: '/^cpu family[[:space:]]*:/ && f == "" { f = $2 + 0 }
             /^model[[:space:]]*:/ && m == "" { m = $2 + 0 }
             END { if (f != "" && m != "") print f, m }' "${SYSROOT}/proc/cpuinfo" 2>/dev/null || true
}

# Hybrid CPUs register one PMU per core type; each lists its online CPUs.
hybrid_cpus() { cat "${SYSROOT}/sys/devices/cpu_$1/cpus" 2>/dev/null || true; }
has_hybrid() { [ -n "$(hybrid_cpus core)" ] && [ -n "$(hybrid_cpus atom)" ]; }
HYBRID_LABEL="k3d-gpu.io/hybrid-cpu=true"

# Kernel CPU list ("0-3,8,10-11") -> one CPU number per line. Only what the
# kernel prints is accepted (decimal, no leading zeros, a <= b, CPU ids below
# CPULIST_MAX); anything else prints nothing and fails, so a garbled list can
# never pass a check by expanding to an empty set or an unbounded range.
CPULIST_MAX=65536
cpulist_expand() {
    local n='(0|[1-9][0-9]{0,4})' part lo hi parts
    [[ "$1" =~ ^${n}(-${n})?(,${n}(-${n})?)*$ ]] || return 1
    IFS=',' read -r -a parts <<< "$1"
    for part in "${parts[@]}"; do
        lo=${part%-*} hi=${part#*-}
        { [ "${lo}" -le "${hi}" ] && [ "${hi}" -lt "${CPULIST_MAX}" ]; } || return 1
    done
    for part in "${parts[@]}"; do seq "${part%-*}" "${part#*-}"; done
}

# True when list $1 is a valid, non-empty list whose every CPU is also in list $2.
cpulist_within() {
    local a b
    a=$(cpulist_expand "$1") && [ -n "${a}" ] || return 1
    b=$(cpulist_expand "$2") || return 1
    ! grep -qvxF -f <(printf '%s\n' "${b}") <<< "${a}"
}

# ---- NUMA / SNC -------------------------------------------------------------------
# NUMA nodes from /sys/devices/system/node/node<N>, sorted, one per line. Nodes
# with memory and no CPUs (HBM in flat mode, CXL expanders) count too.
numa_nodes() {
    local d n
    for d in "${SYSROOT}"/sys/devices/system/node/node[0-9]*; do
        n=${d##*/node}
        if [ -d "${d}" ] && [[ "${n}" =~ ^(0|[1-9][0-9]{0,4})$ ]]; then echo "${n}"; fi
    done | sort -n
}
numa_count() { numa_nodes | awk 'END {print NR}'; }
has_numa() { [ "$(numa_count)" -gt 1 ]; }

# numa_cpus <node>: the node's CPU list, empty for a memory-only node.
numa_cpus() { head -n1 "${SYSROOT}/sys/devices/system/node/node$1/cpulist" 2>/dev/null || true; }

# node_package <node>: physical package (socket) of the node's first CPU, or empty.
node_package() {
    local cpu pkg
    cpu=$(numa_cpus "$1")
    cpu=${cpu%%[-,]*}
    [[ "${cpu}" =~ ^(0|[1-9][0-9]{0,4})$ ]] || return 0
    pkg=$(head -n1 "${SYSROOT}/sys/devices/system/cpu/cpu${cpu}/topology/physical_package_id" 2>/dev/null || true)
    [[ "${pkg}" =~ ^(0|[1-9][0-9]{0,3})$ ]] && echo "${pkg}"
    return 0
}

# Distinct sockets of the CPU nodes, sorted, one per line.
numa_sockets() {
    local n
    for n in $(numa_nodes); do node_package "${n}"; done | sort -un
}

# Sub-NUMA clustering: CPUs sharing CPU 0's L3 divided by the CPUs of CPU 0's node,
# the rule snc_get_config() in arch/x86/kernel/cpu/resctrl/monitor.c used through
# Linux 6.19 (7.0 divides NUMA nodes by packages instead, which also counts HBM/CXL
# memory-only nodes). Like the kernel, 1, 2, 3, 4 and 6 are accepted and anything
# else reads as 1. Empty when either list is missing or malformed.
snc_per_l3() {
    local l3 n cpus="" ratio
    l3=$(cpulist_expand "$(head -n1 "${SYSROOT}/sys/devices/system/cpu/cpu0/cache/index3/shared_cpu_list" 2>/dev/null)") || return 0
    for n in $(numa_nodes); do
        cpus=$(cpulist_expand "$(numa_cpus "${n}")") || continue
        grep -qx 0 <<< "${cpus}" && break
        cpus=""
    done
    [ -n "${cpus}" ] && [ -n "${l3}" ] || return 0
    ratio=$(( $(wc -l <<< "${l3}") / $(wc -l <<< "${cpus}") ))
    case "${ratio}" in 1|2|3|4|6) echo "${ratio}" ;; *) echo 1 ;; esac
}

# Node labels for a NUMA host: node count, and SNC when it can be read.
numa_labels() {
    local snc
    echo "k3d-gpu.io/numa-nodes=$(numa_count)"
    snc=$(snc_per_l3)
    [ -z "${snc}" ] || echo "k3d-gpu.io/snc=${snc}"
}

# ---- accelerators per socket (doctor only) -----------------------------------------
# Xeon processor number -> "<number> <DSA> <IAA> <QAT>": default devices per socket
# from each SKU's ark.intel.com specifications page (Advanced Technologies).
#   8480+ https://www.intel.com/content/www/us/en/products/sku/231746/intel-xeon-platinum-8480-processor-105m-cache-2-00-ghz/specifications.html
#   6980P https://www.intel.com/content/www/us/en/products/sku/240777/intel-xeon-6980p-processor-504m-cache-2-00-ghz/specifications.html
#   6960P https://www.intel.com/content/www/us/en/products/sku/240775/intel-xeon-6960p-processor-432m-cache-2-70-ghz/specifications.html
#   6780E https://www.intel.com/content/www/us/en/products/sku/240362/intel-xeon-6780e-processor-108m-cache-2-20-ghz/specifications.html
xeon_ark_accels() {
    case " $1 " in
        *" 8480+ "*) echo "8480+ 1 1 1" ;;
        *" 6980P "*) echo "6980P 4 4 4" ;;
        *" 6960P "*) echo "6960P 4 4 4" ;;
        *" 6780E "*) echo "6780E 2 2 2" ;;
    esac
}

cpu_model() {
    sed -n 's/^model name[[:space:]]*:[[:space:]]*//p' "${SYSROOT}/proc/cpuinfo" 2>/dev/null | head -n1
}

# pci_socket <pci dev dir>: socket of the device's NUMA node; 0 on a one-socket
# host when the node is unknown (numa_node -1); "?" otherwise.
pci_socket() {
    local node pkg=""
    node=$(head -n1 "$1/numa_node" 2>/dev/null || true)
    [[ "${node}" =~ ^(0|[1-9][0-9]{0,4})$ ]] && pkg=$(node_package "${node}")
    if [ -z "${pkg}" ]; then
        if [ "$(numa_sockets | awk 'END {print NR}')" -le 1 ]; then pkg=0; else pkg="?"; fi
    fi
    echo "${pkg}"
}

# DSA and IAA PCI ids: idxd_pci_tbl in drivers/dma/idxd/init.c (SPR0, GNRD, DMR;
# IAX SPR0, DMR, PTL, WCL) with the values from include/linux/pci_ids.h and
# drivers/dma/idxd/registers.h.
DSA_PCI_IDS="0x0b25 0x11fb 0x1212"
IAA_PCI_IDS="0x0cfe 0x1216 0xb02d 0xfd2d"

# "<socket> <DSA|IAA|QAT>" per DSA/IAA PCI function and QAT physical function, by
# PCI id, so a device counts whether or not its driver is loaded.
accel_sockets() {
    local dev id kind
    for dev in "${SYSROOT}"/sys/bus/pci/devices/*; do
        [ "$(cat "${dev}/vendor" 2>/dev/null)" = "0x8086" ] || continue
        id=$(cat "${dev}/device" 2>/dev/null) || continue
        if [[ " ${DSA_PCI_IDS} " == *" ${id} "* ]]; then kind=DSA
        elif [[ " ${IAA_PCI_IDS} " == *" ${id} "* ]]; then kind=IAA
        elif [[ " ${QAT_PF_IDS} " == *" ${id} "* ]]; then kind=QAT
        else continue
        fi
        echo "$(pci_socket "${dev}") ${kind}"
    done
}

# Doctor lines, appended to the caller's ${lines}: DSA/IAA/QAT per socket next to
# the SKU's ARK default, a warning for each socket below it, and a note when the
# On Demand (SDSi) interface exists.
doctor_accel_sockets() {
    local pairs sockets s k n want sku="" d_dsa="" d_iaa="" d_qat="" below line="" extra="" sdsi
    pairs=$(accel_sockets)
    if [ -n "${pairs}" ]; then
        sockets=$({ numa_sockets; awk '{print $1}' <<< "${pairs}"; } | LC_ALL=C sort -u)
        read -r sku d_dsa d_iaa d_qat <<< "$(xeon_ark_accels "$(cpu_model)")"
        while read -r s; do
            line+="${line:+; }socket ${s}:"
            below=""
            for k in DSA IAA QAT; do
                n=$(grep -cxF "${s} ${k}" <<< "${pairs}" || true)
                line+=" ${k} ${n},"
                case "${k}" in DSA) want=${d_dsa} ;; IAA) want=${d_iaa} ;; *) want=${d_qat} ;; esac
                if [ -n "${want}" ] && [ "${n}" -lt "${want}" ]; then below+="${below:+, }${k} ${n}"; fi
            done
            line=${line%,}
            [ -z "${below}" ] || extra+="  ${YLW}warn${RST}: socket ${s}: ${below} below the ARK default for ${sku} — the BIOS may have the device disabled; check its accelerator settings"$'\n'
        done <<< "${sockets}"
        if [ -n "${sku}" ]; then
            line+=" (ARK default for ${sku}: DSA ${d_dsa}, IAA ${d_iaa}, QAT ${d_qat} per socket)"
        else
            line+=" (no ARK default on file for this CPU)"
        fi
        lines+="  info: per socket: ${line}"$'\n'"${extra}"
    fi
    sdsi=$({ compgen -G "${SYSROOT}/sys/bus/auxiliary/devices/intel_vsec.sdsi.*" || true; } | sed 's#.*/##' | sort -V | paste -sd, | sed 's/,/, /g')
    [ -z "${sdsi}" ] || lines+="  info: Intel On Demand interface present (${sdsi}): on On Demand SKUs, instances above the ARK default are activated by a license (https://github.com/intel/intel-sdsi); ask the platform vendor whether activation is offered"$'\n'
}

# ---- platform tables (doctor only) --------------------------------------------
# IDs, default-driver kernels and firmware names from the kernel's
# include/drm/intel/pciids.h, i915_pci.c, intel_uc_fw.c, xe_pci.c, xe_uc_fw.c and
# drivers/accel/ivpu.

# Intel GPU id -> "<name>|<first kernel binding it by default>|<GuC firmware glob>".
# An empty kernel field means the kernel still requires xe.force_probe. For an
# i915 part the kernel is the first release whose pciids header lists the id and
# whose i915_pci.c no longer sets require_force_probe for its platform (ADL-S
# from 5.16; ADL-P, and so ADL-N and RPL-P/U, from 5.17; MTL from 6.7).
intel_gpu_platform() {
    case "$1" in
        0x468[028a]|0x469[023])             echo "Alder Lake-S|5.16|i915/tgl_guc_" ;;
        0x468b)                             echo "Alder Lake-S|6.1|i915/tgl_guc_" ;;
        0x46a[0-368a]|0x462[68a]|0x46b[0-3]|0x46c[0-3]) echo "Alder Lake-P|5.17|i915/adlp_guc_" ;;
        0x46d[0-2])                         echo "Alder Lake-N|5.18|i915/adlp_guc_" ;;
        0x46d[34])                          echo "Alder Lake-N|6.9|i915/adlp_guc_" ;;
        0xa78[0-389])                       echo "Raptor Lake-S|5.17|i915/tgl_guc_" ;;
        0xa78[ab])                          echo "Raptor Lake-S|5.19|i915/tgl_guc_" ;;
        0xa72[01]|0xa7a[0189])              echo "Raptor Lake-P/U|5.19|i915/adlp_guc_" ;;
        0xa7a[a-d])                         echo "Raptor Lake-P/U|6.7|i915/adlp_guc_" ;;
        0x7d40|0x7d45|0x7d55|0x7d60|0x7dd5) echo "Meteor Lake|6.7|i915/mtl_guc_" ;;
        0x7d51|0x7dd1)                      echo "Arrow Lake-H|6.9|i915/mtl_guc_" ;;
        0x7d41)                             echo "Arrow Lake-U|6.9|i915/mtl_guc_" ;;
        0x7d67)                             echo "Arrow Lake-S|6.7|i915/mtl_guc_" ;;
        0xb640)                             echo "Arrow Lake-S|6.12|i915/mtl_guc_" ;;
        0x6420|0x64a0|0x64b0)               echo "Lunar Lake|6.12|xe/lnl_guc_" ;;
        0xe20[29bcd]|0xe21[0126]|0xe22[0-3]) echo "Battlemage|6.12|xe/bmg_guc_" ;;
        0xb08[0-7f]|0xb090|0xb0a0|0xb0b0)   echo "Panther Lake|6.17|xe/ptl_guc_" ;;
        0xfd80|0xfd81)                      echo "Wildcat Lake|6.18|xe/ptl_guc_" ;;
        0xd74[0-35ab])                      echo "Nova Lake-S|7.3|xe/nvl_guc_" ;;
        0xd75[0-7f])                        echo "Nova Lake-P||" ;;
        0x674[c-f]|0x6750)                  echo "Crescent Island||" ;;
    esac
}

# Whether a GPU platform (an intel_gpu_platform name) has XMX systolic matrix
# engines: Mesa's has_systolic (src/intel/dev/intel_device_info.c) for the ids in
# include/pci_ids/iris_pci_ids.h. Prints nothing for a platform Mesa does not list.
gpu_xmx() {
    case "$1" in
        "Arrow Lake-H"|"Lunar Lake"|Battlemage|"Panther Lake"|"Wildcat Lake"|"Nova Lake-S"|"Nova Lake-P") echo true ;;
        "Alder Lake-S"|"Alder Lake-P"|"Alder Lake-N"|"Raptor Lake-S"|"Raptor Lake-P/U"|"Meteor Lake"|"Arrow Lake-U"|"Arrow Lake-S") echo false ;;
    esac
}

# NPU 0x7d1d (ivpu PCI_DEVICE_ID_MTL) ships in Meteor Lake and Arrow Lake-H; the
# CPU family and model (arch/x86/include/asm/intel-family.h) say which.
npu_7d1d_name() {
    case "$(cpu_family_model)" in
        "6 170"|"6 172") echo "Meteor Lake" ;;   # INTEL_METEORLAKE_L 0xAA, INTEL_METEORLAKE 0xAC
        "6 197")         echo "Arrow Lake-H" ;;  # INTEL_ARROWLAKE_H 0xC5
        *)               echo "Meteor Lake / Arrow Lake-H" ;;
    esac
}

# Intel NPU id -> "<name>|<first kernel with the id>|<firmware generation>".
npu_platform() {
    case "$1" in
        0x7d1d) echo "$(npu_7d1d_name)|6.3|37xx" ;;
        0xad1d) echo "Arrow Lake|6.6|37xx" ;;
        0x643e) echo "Lunar Lake|6.6|40xx" ;;
        0xb03e) echo "Panther Lake|6.13|50xx" ;;
        0xfd3e) echo "Wildcat Lake|6.17|50xx" ;;
        0xd71d) echo "Nova Lake|6.19|60xx" ;;
    esac
}

kernel_release() { cat "${SYSROOT}/proc/sys/kernel/osrelease" 2>/dev/null || uname -r; }

# kernel_lt <major.minor>: true when the running kernel is older.
kernel_lt() {
    local maj min wmaj wmin
    IFS=. read -r maj min _ <<< "$(kernel_release)"
    IFS=. read -r wmaj wmin <<< "$1"
    # Leading digits only: "9-rc3" is minor 9, "12" of "6.12.108-1-MANJARO" is 12.
    maj=${maj%%[!0-9]*} min=${min%%[!0-9]*}
    [ "${maj:-0}" -lt "${wmaj}" ] || { [ "${maj:-0}" -eq "${wmaj}" ] && [ "${min:-0}" -lt "${wmin}" ]; }
}

# firmware_present <path prefix under lib/firmware>: matches .bin, .zst, .xz, ...
# Also looks in firmware/updates, where Intel's own packages (intel-fw-npu) install.
firmware_present() {
    local d
    for d in lib/firmware lib/firmware/updates usr/lib/firmware usr/lib/firmware/updates; do
        compgen -G "${SYSROOT}/${d}/$1*" >/dev/null && return 0
    done
    return 1
}

# Intel DRM cards with an i915 per-engine directory, /sys/class/drm/cardN/engine
# (drivers/gpu/drm/i915/gt/sysfs_engines.c). xe has no such directory.
intel_engine_cards() {
    local card
    for card in "${SYSROOT}"/sys/class/drm/card[0-9]*; do
        [[ "${card##*/}" =~ ^card[0-9]+$ ]] || continue
        if [ "$(cat "${card}/device/vendor" 2>/dev/null)" = 0x8086 ] && [ -d "${card}/engine" ]; then
            echo "${card}"
        fi
    done
    return 0
}

# engine_count <card dir> <class prefix>: engines named <prefix><instance> (vcs0, vcs1, ...).
engine_count() { local n; n=$({ compgen -G "$1/engine/$2[0-9]*" || true; } | wc -l); echo $((n)); }

# Node labels for the detected Intel GPUs. gpu.intel.com/xmx is true when any GPU
# has XMX and false when every GPU is known to lack it. gpu.intel.com/media-vcs and
# media-vecs count the video decode/encode and video enhancement engines of the
# i915 card with the most video engines.
intel_gpu_labels() {
    local e name x xmx=false unknown=0 card vcs best=-1 vecs=0
    for e in ${INTEL_DRIVERS[@]+"${INTEL_DRIVERS[@]}"}; do
        IFS='|' read -r name _ <<< "$(intel_gpu_platform "${e#* }")"
        x=$(gpu_xmx "${name}")
        case "${x}" in true) xmx=true ;; false) ;; *) unknown=1 ;; esac
    done
    if [ "${#INTEL_DRIVERS[@]}" -gt 0 ] && { [ "${xmx}" = true ] || [ "${unknown}" -eq 0 ]; }; then
        echo "gpu.intel.com/xmx=${xmx}"
    fi
    while read -r card; do
        [ -n "${card}" ] || continue
        vcs=$(engine_count "${card}" vcs)
        if [ "${vcs}" -gt "${best}" ]; then best=${vcs}; vecs=$(engine_count "${card}" vecs); fi
    done <<< "$(intel_engine_cards)"
    if [ "${best}" -ge 0 ]; then
        echo "gpu.intel.com/media-vcs=${best}"
        echo "gpu.intel.com/media-vecs=${vecs}"
    fi
}

# Node label for the NPU firmware generation (37xx, 40xx, ...), when every
# detected NPU has the same known one.
npu_labels() {
    local id gen gens=""
    for id in ${NPU_IDS[@]+"${NPU_IDS[@]}"}; do
        IFS='|' read -r _ _ gen <<< "$(npu_platform "${id}")"
        [ -z "${gen}" ] || gens+="${gen}"$'\n'
    done
    gens=$(printf '%s' "${gens}" | sort -u)
    if [ -n "${gens}" ] && [ "${gens}" = "${gens%%$'\n'*}" ]; then
        echo "k3d-gpu.io/npu.gen=${gens}"
    fi
    return 0
}

# Resolve the active vendor list into ACTIVE (array). Honors K3D_GPU_VENDORS.
resolve_vendors() {
    ACTIVE=()
    VENDORS_REQUEST="${VENDORS_REQUEST//[[:space:]]/}" # any whitespace, newlines included, is ignored
    [ -n "${VENDORS_REQUEST}" ] || VENDORS_REQUEST=auto
    detect_intel
    detect_npu
    local v req
    if [ "${VENDORS_REQUEST}" = "auto" ]; then
        if has_nvidia; then ACTIVE+=(nvidia); fi
        if [ "${#INTEL_DRIVERS[@]}" -gt 0 ]; then ACTIVE+=(intel); fi
        if [ "${#NPU_IDS[@]}" -gt 0 ]; then ACTIVE+=(npu); fi
        if has_gaudi; then
            ACTIVE+=(gaudi)
        elif has_gaudi_pci; then
            warn "Gaudi PCI device found but the habanalabs driver is not loaded — skipping Gaudi (Gaudi 3 needs Intel's out-of-tree habanalabs driver; mainline only covers up to Gaudi 2)"
        fi
        if has_dsa; then ACTIVE+=(dsa); fi
        if has_iaa; then ACTIVE+=(iaa); fi
        if has_qat; then ACTIVE+=(qat); fi
        if [ -n "$(amx_flags)" ]; then ACTIVE+=(amx); fi
        if has_hybrid; then ACTIVE+=(hybrid); fi
        if has_numa; then ACTIVE+=(numa); fi
    else
        IFS=',' read -r -a req <<< "${VENDORS_REQUEST}"
        for v in "${req[@]}"; do
            case "${v}" in
                "") ;;
                nvidia|intel|npu|gaudi|dsa|iaa|qat|amx|hybrid|numa) is_active "${v}" || ACTIVE+=("${v}") ;;
                *) err "unknown vendor '${v}' in K3D_GPU_VENDORS (use nvidia,intel,npu,gaudi,dsa,iaa,qat,amx,hybrid,numa)" ;;
            esac
        done
    fi
    return 0
}

is_active() {
    local v
    for v in ${ACTIVE[@]+"${ACTIVE[@]}"}; do [ "${v}" = "$1" ] && return 0; done
    return 1
}

# Kubernetes extended resources a vendor advertises (one per line). A trailing *
# is a prefix: DSA/IAA name resources after the queue mode, QAT after the PF's
# configured services (cy, dc, asym-dc, ... or generic). AMX, hybrid and numa have
# no resource; they list the node labels the launcher sets instead.
vendor_resources() {
    case "$1" in
        nvidia) echo "nvidia.com/gpu" ;;
        npu)    echo "npu.intel.com/accel" ;;
        gaudi)  echo "habana.ai/gaudi" ;;
        dsa)    echo "dsa.intel.com/*" ;;
        iaa)    echo "iaa.intel.com/*" ;;
        qat)    echo "qat.intel.com/*" ;;
        amx)    amx_labels ;;
        hybrid) echo "${HYBRID_LABEL}" ;;
        numa)   numa_labels ;;
        intel)
            # One resource per bound driver; both when nothing is detected
            # (explicit K3D_GPU_VENDORS=intel on a host we cannot read).
            local e drivers=""
            for e in ${INTEL_DRIVERS[@]+"${INTEL_DRIVERS[@]}"}; do
                drivers+="${e%% *}"$'\n'
            done
            [ -n "${drivers}" ] || drivers=$'xe\ni915\n'
            printf '%s' "${drivers}" | sort -u | sed 's#^#gpu.intel.com/#'
            ;;
    esac
}

vendor_daemonset() {  # prints: namespace name manifest
    case "$1" in
        nvidia) echo "kube-system nvidia-device-plugin-daemonset ${PLUGIN_MANIFEST}" ;;
        intel)  echo "kube-system intel-gpu-plugin ${INTEL_PLUGIN_MANIFEST}" ;;
        npu)    echo "kube-system intel-npu-plugin ${NPU_PLUGIN_MANIFEST}" ;;
        gaudi)  echo "habana-system habanalabs-device-plugin-daemonset ${GAUDI_PLUGIN_MANIFEST}" ;;
        dsa)    echo "kube-system intel-dsa-plugin ${DSA_PLUGIN_MANIFEST}" ;;
        iaa)    echo "kube-system intel-iaa-plugin ${IAA_PLUGIN_MANIFEST}" ;;
        qat)    echo "kube-system intel-qat-plugin ${QAT_PLUGIN_MANIFEST}" ;;
        hybrid) echo "kube-system nri-resource-policy-balloons ${HYBRID_PLUGIN_MANIFEST}" ;;
        # The same balloons policy; listed once when the host is hybrid too.
        numa)   is_active hybrid || echo "kube-system nri-resource-policy-balloons ${HYBRID_PLUGIN_MANIFEST}" ;;
    esac
}

doctor_common() {
    info "Checking docker..."
    if command -v docker >/dev/null 2>&1; then
        if docker info >/dev/null 2>&1; then
            echo "  ok: docker running"
        else
            echo "  ${RED}fail${RST}: docker installed but daemon unreachable (sudo systemctl start docker)"
            FAIL=1
        fi
    else
        echo "  ${RED}fail${RST}: docker not installed (sudo pacman -S docker)"
        FAIL=1
    fi

    info "Checking k3d..."
    if command -v k3d >/dev/null 2>&1; then
        echo "  ok: $(k3d version | head -1)"
    else
        echo "  ${RED}fail${RST}: k3d not installed (yay -S k3d-git)"
        FAIL=1
    fi

    info "Checking kubectl..."
    command -v kubectl >/dev/null 2>&1 && echo "  ok" || { echo "  ${RED}fail${RST}: kubectl not installed (sudo pacman -S kubectl)"; FAIL=1; }
}

doctor_nvidia() {
    info "Checking NVIDIA GPU..."
    if [ -e "${SYSROOT}/dev/nvidiactl" ] || [ -e "${SYSROOT}/dev/nvidia0" ]; then
        echo "  ok: /dev/nvidia* present"
    elif has_nvidia; then
        echo "  ${YLW}warn${RST}: nvidia module loaded but no /dev/nvidia* yet (run: sudo nvidia-modprobe -u -c0)"
    else
        echo "  ${RED}fail${RST}: no /dev/nvidia* devices (driver not loaded?)"
        FAIL=1
    fi

    info "Checking nvidia-container-toolkit..."
    if command -v nvidia-container-runtime >/dev/null 2>&1 \
       || command -v nvidia-ctk >/dev/null 2>&1; then
        echo "  ok"
    else
        echo "  ${RED}fail${RST}: nvidia-container-toolkit not installed"
        echo "         install: https://github.com/NVIDIA/nvidia-container-toolkit"
        FAIL=1
    fi

    # Match the runtime name exactly: Docker 29 also lists CDI devices
    # (cdi: nvidia.com/gpu=all) in `docker info`, which is not a runtime. Either
    # one is enough for --gpus=all; Docker falls back to the CDI spec.
    info "Checking docker NVIDIA runtime..."
    if docker info --format '{{range $k, $v := .Runtimes}}{{$k}}{{"\n"}}{{end}}' 2>/dev/null | grep -qx nvidia; then
        echo "  ok: nvidia runtime registered"
    elif docker info --format '{{range .DiscoveredDevices}}{{.ID}}{{"\n"}}{{end}}' 2>/dev/null | grep -q '^nvidia\.com/gpu='; then
        echo "  ok: no nvidia runtime, but nvidia.com/gpu CDI devices are registered (--gpus uses CDI)"
    else
        echo "  ${YLW}warn${RST}: nvidia runtime not listed (sudo nvidia-ctk runtime configure --runtime=docker && sudo systemctl restart docker)"
    fi
}

doctor_intel() {
    info "Checking Intel GPU (Arc, Battlemage, Core Ultra iGPU, Crescent Island)..."
    if [ "${#INTEL_DRIVERS[@]}" -eq 0 ]; then
        echo "  ${RED}fail${RST}: no Intel DRM render node bound to xe/i915 (driver not loaded? check /dev/dri and /sys/class/drm)"
        FAIL=1
        return
    fi
    local e drv id name mink fw opt card eng caps engines labels
    for e in "${INTEL_DRIVERS[@]}"; do
        read -r drv id <<< "${e}"
        IFS='|' read -r name mink fw <<< "$(intel_gpu_platform "${id}")"
        echo "  ok: Intel ${name:-GPU} (${id:-?}) bound to ${drv}"
        if [ -n "${mink}" ] && kernel_lt "${mink}"; then
            opt=xe
            [ "${fw#i915/}" = "${fw}" ] || opt=i915
            echo "  ${YLW}warn${RST}: ${name} (${id}) needs kernel ${mink}+ (running $(kernel_release)); older kernels need ${opt}.force_probe=${id#0x}"
        fi
        if [ -n "${fw}" ]; then
            if firmware_present "${fw}"; then
                echo "  ok: ${fw}* firmware present"
            else
                echo "  ${YLW}warn${RST}: ${fw}* firmware not found (update linux-firmware)"
            fi
        fi
    done
    while read -r card; do
        [ -n "${card}" ] || continue
        engines=""
        for eng in "${card}"/engine/vcs[0-9]* "${card}"/engine/vecs[0-9]*; do
            [ -d "${eng}" ] || continue
            caps=$(cat "${eng}/capabilities" 2>/dev/null || true)
            engines+="${engines:+, }${eng##*/}${caps:+ (${caps})}"
        done
        echo "  ok: ${card##*/} media engines: ${engines:-none}"
    done <<< "$(intel_engine_cards)"
    labels=$(intel_gpu_labels | paste -sd' ')
    [ -z "${labels}" ] || echo "  ok: up labels the node ${labels}"
}

doctor_npu() {
    info "Checking Intel NPU (Core Ultra)..."
    local id name mink gen
    if [ "${#NPU_IDS[@]}" -eq 0 ]; then
        echo "  ${RED}fail${RST}: no Intel NPU accel node bound to intel_vpu (driver not loaded? lsmod | grep intel_vpu)"
        FAIL=1
        return
    fi
    for id in ${NPU_IDS[@]+"${NPU_IDS[@]}"}; do
        IFS='|' read -r name mink gen <<< "$(npu_platform "${id}")"
        echo "  ok: Intel NPU ${name:-(unknown generation)} (${id}) bound to intel_vpu"
        if [ -n "${mink}" ] && kernel_lt "${mink}"; then
            echo "  ${YLW}warn${RST}: ${name} NPU needs kernel ${mink}+ (running $(kernel_release))"
        fi
        [ -n "${gen}" ] || continue
        if firmware_present "intel/vpu/vpu_${gen}_"; then
            echo "  ok: intel/vpu/vpu_${gen}_* firmware present"
        else
            echo "  ${YLW}warn${RST}: intel/vpu/vpu_${gen}_* firmware not found (install linux-firmware or intel-fw-npu)"
        fi
    done
    gen=$(npu_labels)
    [ -z "${gen}" ] || echo "  ok: up labels the node ${gen}"
    echo "  note: workload images need the NPU user-space driver (github.com/intel/linux-npu-driver) and Level Zero"
}

doctor_gaudi() {
    info "Checking Intel Gaudi (HPU)..."
    local n
    n=$(accel_nodes | grep -c '^0x1da3 ' || true)
    if [ "${n}" -gt 0 ]; then
        echo "  ok: ${n} Gaudi accel node(s) under /dev/accel"
    elif compgen -G "${SYSROOT}/dev/hl[0-9]*" >/dev/null; then
        echo "  ${YLW}warn${RST}: legacy /dev/hl* nodes only — the Gaudi plugin expects /dev/accel/accel*; update the habanalabs driver"
    else
        echo "  ${RED}fail${RST}: no Gaudi accel node (habanalabs driver not loaded? lsmod | grep habanalabs)"
        FAIL=1
    fi
    if compgen -G "${SYSROOT}/dev/accel/accel_controlD*" >/dev/null; then
        echo "  ok: /dev/accel/accel_controlD* present"
    else
        echo "  ${YLW}warn${RST}: no /dev/accel/accel_controlD* nodes"
    fi
}

# Intel GPUs and NPUs the kernel saw but no driver claimed. They have no device
# node, so detection cannot see them; the usual cause is a part newer than the
# kernel's default support (xe.force_probe) or a driver module that is not loaded.
doctor_intel_unbound() {
    local dev id class name mink gen fw lines=""
    for dev in "${SYSROOT}"/sys/bus/pci/devices/*; do
        [ "$(cat "${dev}/vendor" 2>/dev/null)" = "0x8086" ] || continue
        class=$(cat "${dev}/class" 2>/dev/null) || continue
        case "${class}" in 0x03*|0x12*) ;; *) continue ;; esac
        [ -z "$(bound_driver "${dev}")" ] || continue
        id=$(cat "${dev}/device" 2>/dev/null) || continue
        if [ -n "$(npu_platform "${id}")" ]; then
            IFS='|' read -r name mink gen <<< "$(npu_platform "${id}")"
            lines+="  ${YLW}warn${RST}: Intel NPU ${name} (${id}) has no driver — load intel_vpu (kernel ${mink}+): sudo modprobe intel_vpu"$'\n'
        elif IFS='|' read -r name mink fw <<< "$(intel_gpu_platform "${id}")" && [ "${fw#i915/}" != "${fw}" ]; then
            # A GuC firmware under i915/ means i915 is the default driver for the part.
            lines+="  ${YLW}warn${RST}: Intel ${name} (${id}) has no driver — load i915 (kernel ${mink}+): sudo modprobe i915"$'\n'
        else
            lines+="  ${YLW}warn${RST}: Intel ${name:-GPU/accelerator} (${id}) has no driver — if dmesg says xe does not support it yet, boot with xe.force_probe=${id#0x} i915.force_probe=!${id#0x}"$'\n'
        fi
    done
    [ -n "${lines}" ] || return 0
    info "Intel devices with no driver bound..."
    printf '%s' "${lines}"
}

# NUMA placement and RDT, appended to the caller's ${lines}. RDT is guidance only:
# turning it on rewrites the host's resctrl groups, which the launcher never does.
doctor_numa() {
    local count cpu_nodes="" mem_only="" n snc sockets flags rdt=""
    count=$(numa_count)
    for n in $(numa_nodes); do
        if [ -n "$(numa_cpus "${n}")" ]; then cpu_nodes+=" ${n}"; else mem_only+=" ${n}"; fi
    done
    if has_numa; then
        snc=$(snc_per_l3)
        sockets=$(numa_sockets | awk 'END {print NR}')
        [ "${sockets}" -gt 0 ] || sockets="?"
        lines+="  ok: NUMA: ${count} node(s) ($(wc -w <<< "${cpu_nodes}") with CPUs), SNC ${snc:-unknown} per L3, ${sockets} socket(s) — up deploys the NRI balloons policy; label pods k3d-gpu.io/cores=replica for a balloon inside one NUMA node, memory pinned to it, near the pod's devices"$'\n'
        [ -z "${mem_only}" ] || lines+="  info: NUMA node(s)$(sed 's/ /, /g; s/^,//' <<< "${mem_only}") have memory but no CPUs (HBM flat mode or CXL); replica pods follow the kernel's node distances, and a balloon type with memoryTypes [HBM] or [DRAM] narrows them"$'\n'
    elif is_active numa; then
        lines+="  ${RED}fail${RST}: NUMA requested but the host has ${count} NUMA node(s) (/sys/devices/system/node)"$'\n'
        FAIL=1
    fi
    flags=$(grep -m1 '^flags[[:space:]]*:' "${SYSROOT}/proc/cpuinfo" 2>/dev/null || true)
    if [[ " ${flags#*:} " == *" rdt_a "* ]]; then
        for n in cat_l2 cat_l3 cdp_l2 cdp_l3 mba; do
            [[ " ${flags#*:} " == *" ${n} "* ]] && rdt+=" ${n}"
        done
        lines+="  info: RDT allocation (rdt_a:${rdt}) — resctrl classes are available but left off: the balloons policy ships control.rdt.enable: false because enabling it rewrites the host's /sys/fs/resctrl. To opt in, mount resctrl on the host (mount -t resctrl resctrl /sys/fs/resctrl) and set control.rdt.enable: true in nri-balloons.yml; usePodQoSAsDefaultClass then gives BestEffort/Burstable/Guaranteed pods 33%/66%/100% of the L3"$'\n'
    fi
}

# Xeon built-in accelerators. `up` deploys DSA/IAA/QAT plugins once the host
# side is set up (work queues, SR-IOV VFs); this says what is still missing.
doctor_cpu_accels() {
    local amx isa dev bdf vfs n wqs kind name prefix devdir lines=""
    amx=$(amx_flags)
    [ -z "${amx}" ] || lines+="  ok: AMX (${amx}) — CPU instructions, usable in any pod; up labels nodes feature.node.kubernetes.io/cpu-cpuid.AMX*"$'\n'
    isa=$(cpu_isa_labels | sed 's#^feature\.node\.kubernetes\.io/cpu-cpuid\.##; s#=true$##' | paste -sd' ')
    [ -z "${isa}" ] || lines+="  ok: CPU ISA: ${isa} — up labels nodes feature.node.kubernetes.io/cpu-cpuid.<name>=true (NFD names)"$'\n'

    for kind in "DSA dsa dsa" "IAA iax iax"; do
        read -r name prefix devdir <<< "${kind}"
        n=$({ compgen -G "${SYSROOT}/sys/bus/dsa/devices/${prefix}[0-9]*" || true; } | wc -l)
        wqs=$({ compgen -G "${SYSROOT}/dev/${devdir}/wq*" || true; } | wc -l)
        if [ "${wqs}" -gt 0 ]; then
            lines+="  ok: ${name}: ${n} device(s), ${wqs} user work queue(s) — deployed by 'k3d-gpu up' (intel-${name,,}-plugin)"$'\n'
        elif [ "${n}" -gt 0 ]; then
            lines+="  ${YLW}warn${RST}: ${name}: ${n} device(s) but no user work queues — configure them on the host with accel-config"$'\n'
        fi
        if is_active "${name,,}" && [ "${wqs}" -eq 0 ]; then
            lines+="  ${RED}fail${RST}: ${name} requested but no /dev/${devdir}/wq* work queues"$'\n'
            FAIL=1
        fi
    done

    for dev in "${SYSROOT}"/sys/bus/pci/devices/*; do
        [ "$(cat "${dev}/vendor" 2>/dev/null)" = "0x8086" ] || continue
        [[ " ${QAT_PF_IDS} " == *" $(cat "${dev}/device" 2>/dev/null) "* ]] || continue
        bdf=$(basename "${dev}")
        vfs=$({ compgen -G "${dev}/virtfn*" || true; } | wc -l)
        if [ -z "$(bound_driver "${dev}")" ]; then
            lines+="  ${YLW}warn${RST}: QAT ${bdf}: no driver bound — load the QAT driver (qat_4xxx / qat_420xx / qat_6xxx / qat_c62x)"$'\n'
        elif [ "${vfs}" -gt 0 ]; then
            lines+="  ok: QAT ${bdf}: ${vfs} VF(s) — deployed by 'k3d-gpu up' (intel-qat-plugin binds them to vfio-pci)"$'\n'
        else
            lines+="  ${YLW}warn${RST}: QAT ${bdf}: no VFs — enable on the host: echo N > /sys/bus/pci/devices/${bdf}/sriov_numvfs"$'\n'
        fi
    done
    if has_qat && [ ! -d "${SYSROOT}/sys/bus/pci/drivers/vfio-pci" ]; then
        lines+="  ${YLW}warn${RST}: vfio-pci is not loaded — the QAT plugin needs it (sudo modprobe vfio-pci; IOMMU on: intel_iommu=on)"$'\n'
    fi
    if is_active qat && ! has_qat; then
        lines+="  ${RED}fail${RST}: QAT requested but no QAT PF with VFs"$'\n'
        FAIL=1
    fi
    if has_hybrid; then
        lines+="  ok: hybrid CPU: P-cores $(hybrid_cpus core), E-cores $(hybrid_cpus atom) — up deploys the NRI balloons policy; label pods k3d-gpu.io/cores=performance|efficient"$'\n'
    elif is_active hybrid; then
        lines+="  ${RED}fail${RST}: hybrid requested but the CPU has no online P-core and E-core PMUs (/sys/devices/cpu_core, cpu_atom)"$'\n'
        FAIL=1
    fi
    doctor_numa
    doctor_accel_sockets
    if is_active amx && [ -z "${amx}" ]; then
        lines+="  ${RED}fail${RST}: AMX requested but the CPU reports no amx_* flags"$'\n'
        FAIL=1
    fi

    [ -n "${lines}" ] || return 0
    info "Intel CPU built-in accelerators..."
    printf '%s' "${lines}"
}

doctor() {
    FAIL=0
    resolve_vendors
    doctor_common

    if [ "${#ACTIVE[@]}" -eq 0 ]; then
        echo ""
        echo "  ${RED}fail${RST}: no supported accelerator detected (NVIDIA, Intel GPU/NPU/Gaudi, Xeon DSA/IAA/QAT/AMX, hybrid P/E cores)"
        FAIL=1
    else
        info "Detected accelerators: ${ACTIVE[*]}"
        if is_active nvidia; then doctor_nvidia; fi
        if is_active intel;  then doctor_intel;  fi
        if is_active npu;    then doctor_npu;    fi
        if is_active gaudi;  then doctor_gaudi;  fi
    fi
    doctor_intel_unbound
    doctor_cpu_accels

    echo ""
    [ "${FAIL}" -eq 0 ] && info "All checks passed." || { err "One or more checks failed."; }
}

# ---- doctor --perf: host tuning advisor --------------------------------------
# Reads sysfs/procfs (and asks docker / nvidia-smi) only. Every finding names the
# file it came from; every suggestion prints the one-line command to apply it and
# the one to put the current value back. Nothing here writes to the host.

PERF_SUGGESTIONS=0
PERF_MODEL_GB="${K3D_GPU_MODEL_GB:-}"

# rd <path>: first line of ${SYSROOT}<path>, empty when missing or unreadable.
rd() { local v; v=$(head -n1 "${SYSROOT}$1" 2>/dev/null) || return 0; printf '%s' "${v}"; }

# rf <file>: whole file, empty when missing or unreadable (absolute path).
rf() { cat "$1" 2>/dev/null || true; }

# meminfo_kb <field>: a /proc/meminfo value in kB.
meminfo_kb() { awk -v k="$1:" '$1 == k {print $2; exit}' "${SYSROOT}/proc/meminfo" 2>/dev/null || true; }

# lt <a> <b>: true when both are integers and a < b.
lt() { [[ "$1" =~ ^[0-9]+$ && "$2" =~ ^[0-9]+$ ]] && [ "$1" -lt "$2" ]; }

# bracketed <"a [b] c">: the selected word of a sysfs choice list -> "b".
bracketed() { sed -n 's/.*\[\(.*\)\].*/\1/p' <<< "$1"; }

# kb_gib <kB>: one-decimal GiB.
kb_gib() { awk -v k="${1:-0}" 'BEGIN {printf "%.1f", k / 1048576}'; }

# Kernel CPU list -> a shell glob word for /sys/devices/system/cpu/cpu<word>:
# "16-31" -> "{16..31}", "0,2-3" -> "{0,2,3}", "5" -> "5".
cpu_word() {
    if [[ "$1" =~ ^[0-9]+-[0-9]+$ ]]; then echo "{${1%-*}..${1#*-}}"
    elif [[ "$1" =~ ^[0-9]+$ ]]; then echo "$1"
    else echo "{$(cpulist_expand "$1" | paste -sd,)}"; fi
}

# The CPU groups the advisor reports on: P-cores and E-cores on hybrid parts.
perf_groups() {
    if has_hybrid; then
        echo "P-cores|$(hybrid_cpus core)"
        echo "E-cores|$(hybrid_cpus atom)"
    else
        echo "CPUs|$(rd /sys/devices/system/cpu/online)"
    fi
}

# group_values <cpulist> <cpufreq attr>: "value" when every CPU agrees, else
# "mixed: a x N, b x M". Empty when no CPU has the attribute.
group_values() {
    local cpu
    for cpu in $(cpulist_expand "$1"); do rd "/sys/devices/system/cpu/cpu${cpu}/cpufreq/$2"; echo; done \
        | awk 'NF {n[$0]++} END {k = 0; for (v in n) k++; if (k == 1) for (v in n) print v;
               else if (k > 1) {s = "mixed:"; for (v in n) s = s " " v " x" n[v]; print s}}'
}

# cpulist_compress <"0,1,3">: CPU numbers (comma/space separated) -> kernel list "0-1,3".
cpulist_compress() {
    tr -cs '0-9' '\n' <<< "$1" | awk 'NF' | sort -n | awk '
        {if (NR > 1 && $1 == e + 1) {e = $1; next}
         if (NR > 1) o = o (o == "" ? "" : ",") (s == e ? s : s "-" e); s = e = $1}
        END {if (NR) print o (o == "" ? "" : ",") (s == e ? s : s "-" e)}'
}

# value_groups: "<cpu> <value>" lines -> "<value>|<cpulist>" lines, one per value.
value_groups() {
    local v l
    sort -k2,2 -k1,1n | awk 'NF {if ($2 != v) {if (n++) print v "|" l; v = $2; l = $1} else l = l "," $1}
                             END {if (n) print v "|" l}' \
        | while IFS='|' read -r v l; do echo "${v}|$(cpulist_compress "${l}")"; done
}

# values_desc <pairs>: "power" when one value, else "a on 0-1, b on 3".
values_desc() {
    local v l out=""
    while IFS='|' read -r v l; do out+="${out:+, }${v} on ${l}"; done < <(value_groups <<< "$1")
    if [[ "${out}" == *", "* ]]; then echo "${out}"; else echo "${out% on *}"; fi
}

# values_revert <pairs> <cpufreq attr>: commands that write each CPU's observed value back.
values_revert() {
    local v l out=""
    while IFS='|' read -r v l; do
        out+="${out:+ && }echo ${v} | sudo tee /sys/devices/system/cpu/cpu$(cpu_word "${l}")/cpufreq/$2"
    done < <(value_groups <<< "$1")
    echo "${out}"
}

# cpus_of <pairs>: the kernel CPU list of the pairs.
cpus_of() { cpulist_compress "$(awk 'NF {print $1}' <<< "$1" | paste -sd,)"; }

perf_section() { info "$1"; echo "  good: $2"; echo "  src:  $3"; }
perf_ok()      { echo "  ok:   $1"; echo "        from: $2"; }
perf_info()    { echo "  info: $1"; echo "        from: $2"; }
# perf_flag <warn|note> <finding> <evidence> <why> <apply> <revert>
perf_flag() {
    local tag="${YLW}warn${RST}"
    [ "$1" = warn ] || tag="note"
    echo "  ${tag}: $2"
    echo "        from:   $3"
    echo "        why:    $4"
    [ -z "$5" ] || echo "        apply:  $5"
    [ -z "$6" ] || echo "        revert: $6"
    PERF_SUGGESTIONS=$((PERF_SUGGESTIONS + 1))
}

# msr <cpu> <address>: the MSR as 16 hex digits, read through the msr driver
# (/dev/cpu/<cpu>/msr needs root and the msr module). Empty when unreadable.
msr() {
    local f="${SYSROOT}/dev/cpu/$1/msr" v=""
    [ -r "${f}" ] || return 0
    v=$(dd if="${f}" bs=8 count=1 skip=$(($2)) iflag=skip_bytes status=none 2>/dev/null | od -An -tx8 2>/dev/null) || true
    v=${v//[[:space:]]/}
    if [[ "${v}" =~ ^[0-9a-f]{16}$ ]]; then printf '%s' "${v}"; fi
}

# msr_bits <hex> <bit:name>...: the names whose bit is set, comma separated ("none").
msr_bits() {
    local v=$((16#$1)) b out=""
    shift
    for b in "$@"; do
        if (( (v >> ${b%%:*}) & 1 )); then out+="${out:+, }${b#*:}"; fi
    done
    printf '%s' "${out:-none}"
}

# cpuinfo_field <name>: the first CPU's value of a /proc/cpuinfo field.
cpuinfo_field() {
    awk -F': *' -v k="$1" '{sub(/[ \t]+$/, "", $1)} $1 == k {print $2; exit}' "${SYSROOT}/proc/cpuinfo" 2>/dev/null || true
}
cpu_flag() { [[ " $(cpuinfo_field flags) " == *" $1 "* ]]; }

# proc_running <comm>: true when a process with that comm (15 characters at most) runs.
proc_running() {
    local c
    for c in "${SYSROOT}"/proc/[0-9]*/comm; do
        [ "$(rf "${c}")" = "$1" ] && return 0
    done
    return 1
}

# throttle_pct: whole percent of uptime the package spent thermally throttled; empty when unknown.
throttle_pct() {
    local t up
    t=$(rd /sys/devices/system/cpu/cpu0/thermal_throttle/package_throttle_total_time_ms)
    up=$(rd /proc/uptime); up=${up%%[. ]*}
    if [[ "${t}" =~ ^[0-9]{1,15}$ && "${up}" =~ ^[1-9][0-9]{0,11}$ ]]; then echo $(( t / (up * 10) )); fi
}

# bytes_h <bytes>: "256 MiB" / "32 GiB".
bytes_h() {
    if [ "$1" -ge 1073741824 ]; then echo "$(( $1 / 1073741824 )) GiB"; else echo "$(( $1 / 1048576 )) MiB"; fi
}

perf_cpu() {
    local base=/sys/devices/system/cpu pst status driver label list w gov epp nt mx mn smax cmax dyn cpu capped cvals hw cw undo bad_epp bad_gov cg ce cdrv cl
    pst="${base}/intel_pstate"
    status=$(rd "${pst}/status")
    driver=$(rd "${base}/cpu0/cpufreq/scaling_driver")
    perf_section "CPU frequency (driver ${driver:-none}${status:+, mode ${status}})" \
        "cores ramp to full turbo the moment a request arrives: EPP performance or balance_performance, turbo on, no frequency caps — token generation is a latency-bound loop and every ramp-up shows in time-to-first-token" \
        "https://docs.kernel.org/admin-guide/pm/intel_pstate.html#energy-vs-performance-hints, https://docs.kernel.org/admin-guide/pm/cpufreq.html"
    if [ -z "${driver}" ]; then
        perf_info "no cpufreq policy exposed (VM or cpufreq disabled) — nothing to tune here" "${base}/cpu0/cpufreq/"
        return
    fi

    while IFS='|' read -r label list; do
        [ -n "${list}" ] || continue
        w="${base}/cpu$(cpu_word "${list}")/cpufreq"
        gov=$(group_values "${list}" scaling_governor)
        epp=$(group_values "${list}" energy_performance_preference)
        # Classify each CPU on its own values; a group can hold mixed settings.
        # intel_pstate active + HWP: the governor only picks how EPP is set;
        # performance forces EPP 0, powersave passes the sysfs EPP through.
        # Raw EPP numbers: 0 = performance, 128 = balance_performance, 255 = power.
        # intel_pstate active without HWP (no EPP file): its powersave algorithm
        # picks P-states proportional to CPU utilization, like schedutil.
        bad_epp=""; bad_gov=""
        for cpu in $(cpulist_expand "${list}"); do
            cg=$(rd "${base}/cpu${cpu}/cpufreq/scaling_governor")
            ce=$(rd "${base}/cpu${cpu}/cpufreq/energy_performance_preference")
            cdrv=$(rd "${base}/cpu${cpu}/cpufreq/scaling_driver")
            if [ -n "${ce}" ]; then
                [ "${cg}" != performance ] || continue
                if [[ "${ce}" =~ ^[0-9]{1,9}$ ]] && [ "${ce}" -le 128 ]; then continue; fi
                case "${ce}" in performance|balance_performance) continue ;; esac
                bad_epp+="${cpu} ${ce}"$'\n'
            else
                case "${cg}" in ""|performance|schedutil) continue ;; esac
                [ "${cg}:${cdrv}" != powersave:intel_pstate ] || continue
                bad_gov+="${cpu} ${cg}"$'\n'
            fi
        done
        if [ -n "${bad_epp}" ]; then
            cl=$(cpus_of "${bad_epp}")
            perf_flag warn "${label} ${cl}: EPP $(values_desc "${bad_epp}") (governor $(group_values "${cl}" scaling_governor)) — HWP is told to favour energy over speed" \
                "${base}/cpu$(cpu_word "${cl}")/cpufreq/energy_performance_preference" \
                "with HWP the CPU picks its own P-state from the EPP hint; balance_power/power keep it from ramping up quickly. Kernel docs: set the same hint on all CPUs or tasks migrating between them behave inconsistently" \
                "echo performance | sudo tee ${base}/cpu$(cpu_word "${cl}")/cpufreq/energy_performance_preference" \
                "$(values_revert "${bad_epp}" energy_performance_preference)"
        fi
        if [ -n "${bad_gov}" ]; then
            cl=$(cpus_of "${bad_gov}")
            perf_flag warn "${label} ${cl}: governor $(values_desc "${bad_gov}")" "${base}/cpu$(cpu_word "${cl}")/cpufreq/scaling_governor" \
                "without HWP the generic powersave governor requests the LOWEST frequency; ondemand/conservative ramp late. performance requests the highest within scaling_max_freq" \
                "echo performance | sudo tee ${base}/cpu$(cpu_word "${cl}")/cpufreq/scaling_governor" \
                "$(values_revert "${bad_gov}" scaling_governor)"
        fi
        if [ -z "${bad_epp}${bad_gov}" ] && [ -n "${gov}" ]; then
            if [ -n "${epp}" ] && [ "${gov}" = performance ]; then
                perf_ok "${label} ${list}: governor performance (forces EPP 0)" "${w}/scaling_governor"
            elif [ -n "${epp}" ]; then
                perf_ok "${label} ${list}: governor ${gov}, EPP ${epp}" "${w}/energy_performance_preference"
            elif [ "${gov}" = powersave ] && [ "${driver}" = intel_pstate ]; then
                perf_ok "${label} ${list}: governor powersave (intel_pstate active, no HWP: P-state follows CPU utilization)" "${w}/scaling_governor"
            else
                perf_ok "${label} ${list}: governor ${gov}" "${w}/scaling_governor"
            fi
        fi

        # Per CPU: favoured cores can have a higher hardware max than their siblings.
        capped=""; cvals=""; hw=""; undo=""
        for cpu in $(cpulist_expand "${list}"); do
            smax=$(rd "${base}/cpu${cpu}/cpufreq/scaling_max_freq")
            cmax=$(rd "${base}/cpu${cpu}/cpufreq/cpuinfo_max_freq")
            [[ "${cmax}" =~ ^[0-9]{1,12}$ ]] || continue   # offline CPU or unparsable value
            [[ " ${hw} " == *" $((cmax / 1000)) "* ]] || hw+=" $((cmax / 1000))"
            if lt "${smax}" "${cmax}"; then
                capped+="${capped:+,}${cpu}"; cvals+=" ${cpu}:$((smax / 1000))"
                undo+="${undo:+ && }echo ${smax} | sudo tee ${base}/cpu${cpu}/cpufreq/scaling_max_freq"
            fi
        done
        mn=$(group_values "${list}" scaling_min_freq)
        if [ -n "${capped}" ]; then
            cw="${base}/cpu$(cpu_word "${capped}")/cpufreq"
            perf_flag warn "${label} ${capped}: scaling_max_freq below the hardware max (cpu:MHz${cvals}; hardware max${hw} MHz)" \
                "${cw}/scaling_max_freq" \
                "the policy cap stops turbo short of what the part can do" \
                "for p in ${cw}; do sudo tee \$p/scaling_max_freq < \$p/cpuinfo_max_freq; done" \
                "${undo}"
        elif [ -n "${hw// /}" ] && [ "${hw// /}" != 0 ]; then
            perf_ok "${label} ${list}: no frequency cap (hardware max${hw} MHz)$([[ "${mn}" =~ ^[0-9]+$ ]] && echo ", min $((mn / 1000)) MHz")" "${w}/{scaling,cpuinfo}_max_freq"
        fi
    done < <(perf_groups)

    # power-profiles-daemon drives the governor and EPP itself on intel_pstate active.
    if [ "${status}" = active ] && proc_running power-profiles-; then
        perf_flag note "power-profiles-daemon is running: it sets the governor and EPP itself, so an EPP or governor write here lasts only until its next profile change" \
            "/proc/*/comm" \
            "power-profiles-daemon's README (https://gitlab.freedesktop.org/upower/power-profiles-daemon, 'Operations on Intel-based machines'): on intel_pstate in active mode it applies the selected profile through the governor and the energy-performance hints. Either keep it and pick its performance profile (powerprofilesctl set performance), or stop it for a benchmark run so EPP writes stick" \
            "sudo systemctl stop power-profiles-daemon" "sudo systemctl start power-profiles-daemon"
    fi

    nt=$(rd "${pst}/no_turbo")
    if [ "${nt}" = 1 ]; then
        perf_flag warn "turbo is disabled (no_turbo=1)" "${pst}/no_turbo" \
            "no_turbo forbids every turbo P-state, so cores stay at base clock" \
            "echo 0 | sudo tee ${pst}/no_turbo" "echo 1 | sudo tee ${pst}/no_turbo"
    elif [ "${nt}" = 0 ]; then
        perf_ok "turbo enabled (no_turbo=0)" "${pst}/no_turbo"
    fi

    mx=$(rd "${pst}/max_perf_pct"); mn=$(rd "${pst}/min_perf_pct")
    if lt "${mx}" 100; then
        perf_flag warn "max_perf_pct=${mx}: P-states capped at ${mx}% of max turbo" "${pst}/max_perf_pct" \
            "a global cap below 100 limits every CPU's top P-state" \
            "echo 100 | sudo tee ${pst}/max_perf_pct" "echo ${mx} | sudo tee ${pst}/max_perf_pct"
    elif [ -n "${mx}" ]; then
        perf_ok "max_perf_pct=${mx}, min_perf_pct=${mn}" "${pst}/max_perf_pct"
    fi

    dyn=$(rd "${pst}/hwp_dynamic_boost")
    if [ "${dyn}" = 0 ]; then
        perf_flag note "hwp_dynamic_boost=0" "${pst}/hwp_dynamic_boost" \
            "when 1, a task waking from I/O wait gets a short min-P-state boost; it can help request handlers that block on the network or disk. Unmeasured for inference here — benchmark before keeping it" \
            "echo 1 | sudo tee ${pst}/hwp_dynamic_boost" "echo 0 | sudo tee ${pst}/hwp_dynamic_boost"
    elif [ "${dyn}" = 1 ]; then
        perf_ok "hwp_dynamic_boost=1" "${pst}/hwp_dynamic_boost"
    fi
}

perf_cstates() {
    local base=/sys/devices/system/cpu drv maxc s name lat dis deep="" deep_names="" deepest=""
    drv=$(rd "${base}/cpuidle/current_driver")
    [ -n "${drv}" ] || return 0
    maxc=$(rd /sys/module/intel_idle/parameters/max_cstate)
    perf_section "CPU idle states (${drv}${maxc:+, intel_idle.max_cstate=${maxc}})" \
        "for latency-critical serving, no idle state whose exit latency is large next to a token step; for throughput or power budgets, leave them all on" \
        "https://docs.kernel.org/admin-guide/pm/cpuidle.html#representation-of-idle-states, https://docs.kernel.org/admin-guide/pm/intel_idle.html"
    for s in "${SYSROOT}${base}"/cpu0/cpuidle/state[0-9]*; do
        [ -d "${s}" ] || continue
        name=$(rf "${s}/name"); lat=$(rf "${s}/latency"); dis=$(rf "${s}/disable")
        [ "${dis}" = 0 ] || continue
        deepest="${name} (${lat} us exit latency)"
        if ! lt "${lat}" 100 && [[ "${lat}" =~ ^[0-9]+$ ]]; then
            deep+="${deep:+,}${s##*state}"; deep_names+="${deep_names:+ }${name}/${lat}us"
        fi
    done
    if [ -z "${deep}" ]; then
        perf_ok "deepest enabled state ${deepest:-none}" "${base}/cpu0/cpuidle/state*/latency"
        return
    fi
    local w="${base}/cpu*/cpuidle/state${deep}"
    [[ "${deep}" == *,* ]] && w="${base}/cpu*/cpuidle/state{${deep}}"
    perf_flag note "enabled idle states with >=100 us exit latency: ${deep_names}" \
        "${base}/cpu0/cpuidle/state*/{name,latency,disable}" \
        "a core woken from these pays that latency before it runs; disabling them trims tail latency at the cost of idle power. The 100 us cut-off is this tool's heuristic, not a kernel rule. Runtime disable needs no reboot (intel_idle.max_cstate does)" \
        "echo 1 | sudo tee ${w}/disable" "echo 0 | sudo tee ${w}/disable"
}

perf_thermal() {
    local tt=/sys/devices/system/cpu/cpu0/thermal_throttle pc ptot pmax pct c v cmax=0 ccpu="" desc
    local h l n tj="" now="" hwf="" f off="" offf="" tcc pkg core plr fam model
    pc=$(rd "${tt}/package_throttle_count")
    for h in "${SYSROOT}"/sys/class/hwmon/hwmon*; do
        [ "$(rf "${h}/name")" = coretemp ] || continue
        for l in "${h}"/temp*_label; do
            [ "$(rf "${l}")" = "Package id 0" ] || continue
            n=${l%_label}; tj=$(rf "${n}_crit"); now=$(rf "${n}_input"); hwf=${n#"${SYSROOT}"}
        done
    done
    for f in "${SYSROOT}"/sys/bus/pci/devices/*/tcc_offset_degree_celsius; do
        [ -f "${f}" ] || continue
        off=$(rf "${f}"); offf=${f#"${SYSROOT}"}; break
    done
    pkg=$(msr 0 0x1B1)
    [ -n "${pc}${tj}${off}${pkg}" ] || return 0
    perf_section "CPU thermal throttling" \
        "no throttle time under load: the package stays below its TCC activation point (TjMax minus the TCC offset), so cores keep the frequency they request" \
        "kernel source drivers/thermal/intel/therm_throt.c (thermal_throttle/*), drivers/thermal/intel/int340x_thermal/processor_thermal_device.c (tcc_offset_degree_celsius), drivers/hwmon/coretemp.c (tempN_crit = TjMax), Intel SDM vol. 4 335592-093 (IA32_THERM_STATUS 19CH, IA32_PACKAGE_THERM_STATUS 1B1H, MSR_CORE_PERF_LIMIT_REASONS 64FH in table 2-39)"
    if [[ "${tj}" =~ ^[0-9]{1,9}$ ]]; then
        tcc="TjMax $((tj / 1000)) C"
        if [[ "${off}" =~ ^[0-9]{1,3}$ ]]; then tcc="TCC activation $((tj / 1000 - off)) C (${tcc} - TCC offset ${off} C)"; fi
        if [[ "${now}" =~ ^[0-9]{1,9}$ ]]; then tcc+="; package now $((now / 1000)) C"; fi
        perf_info "${tcc}" "${hwf}_{crit,input}${offf:+, ${offf}}"
    elif [ -n "${off}" ]; then
        perf_info "TCC offset ${off} C" "${offf}"
    fi

    if [[ "${pc}" =~ ^[0-9]{1,15}$ ]]; then
        ptot=$(rd "${tt}/package_throttle_total_time_ms"); pmax=$(rd "${tt}/package_throttle_max_time_ms")
        pct=$(throttle_pct)
        for c in "${SYSROOT}"/sys/devices/system/cpu/cpu[0-9]*/thermal_throttle/core_throttle_count; do
            v=$(rf "${c}")
            if [[ "${v}" =~ ^[0-9]{1,15}$ ]] && [ "${v}" -gt "${cmax}" ]; then
                cmax=${v}; ccpu=${c%/thermal_throttle/*}; ccpu=${ccpu##*/}
            fi
        done
        desc="${pc} events, ${ptot:-?} ms in total, longest ${pmax:-?} ms; core events peak at ${cmax}${ccpu:+ on ${ccpu}}"
        if [ -n "${pct}" ] && [ "${pct}" -ge 1 ]; then
            perf_flag warn "package thermally throttled ${pct}% of uptime: ${desc}" \
                "${tt}/package_throttle_{count,total_time_ms,max_time_ms}, /proc/uptime" \
                "therm_throt counts each time the package raised its thermal or PROCHOT status; while it is set the cores run below the frequency they request, so sustained inference speed follows the cooler, not the clock settings. The 1%-of-uptime cut-off is this tool's heuristic" \
                "none on the host: improve cooling (airflow, heatsink, BIOS fan or thermal profile); the host-side lever is a lower PL1, see CPU package power limits" \
                "none"
        elif [ "${pc}" -gt 0 ]; then
            perf_info "package throttle events: ${desc}${pct:+ (${pct}% of uptime)}" "${tt}/package_throttle_*"
        else
            perf_ok "no package throttle events since boot" "${tt}/package_throttle_count"
        fi
    fi

    if [ -z "${pkg}" ]; then
        if [ -n "${pc}" ]; then
            perf_info "MSR decode (0x19C, 0x1B1, 0x64F) skipped: /dev/cpu/0/msr needs root and the msr module (sudo modprobe msr; sudo k3d-gpu doctor --perf)" "/dev/cpu/0/msr"
        fi
        return 0
    fi
    local -a st=(0:thermal 2:PROCHOT "4:critical temperature" "6:threshold #1" "8:threshold #2" "10:power limit")
    local -a lg=(1:thermal 3:PROCHOT "5:critical temperature" "7:threshold #1" "9:threshold #2" "11:power limit")
    perf_info "MSR 0x1B1 IA32_PACKAGE_THERM_STATUS 0x${pkg}: now $(msr_bits "${pkg}" "${st[@]}"); logged $(msr_bits "${pkg}" "${lg[@]}"); $(( (16#${pkg} >> 16) & 0x7f )) C below TjMax" \
        "/dev/cpu/0/msr (root)"
    core=$(msr 0 0x19C)
    if [ -n "${core}" ]; then
        perf_info "MSR 0x19C IA32_THERM_STATUS (CPU 0) 0x${core}: now $(msr_bits "${core}" "${st[@]}" "12:current limit" "14:cross-domain limit"); logged $(msr_bits "${core}" "${lg[@]}" "13:current limit" "15:cross-domain limit")$( (( (16#${core} >> 31) & 1 )) && echo "; $(( (16#${core} >> 16) & 0x7f )) C below TjMax")" \
            "/dev/cpu/0/msr (root)"
    fi
    plr=$(msr 0 0x64F)
    fam=$(cpuinfo_field "cpu family"); model=$(cpuinfo_field model)
    if [ -n "${plr}" ] && [ "${fam}" = 6 ]; then
        case "${model}" in
            92|95|122)  # Goldmont: a different layout (SDM table 2-12)
                perf_info "MSR 0x64F 0x${plr}: not decoded (Goldmont layout)" "/dev/cpu/0/msr (root)" ;;
            *)
                local -a pl=(0:PROCHOT 1:thermal "4:residency state regulation" "5:running average thermal limit" "6:VR thermal alert" "7:VR thermal design current" "8:other (electrical)" 10:PL1 11:PL2 "12:max turbo limit" "13:turbo transition attenuation")
                local -a pll=() b
                for b in "${pl[@]}"; do pll+=("$(( ${b%%:*} + 16 )):${b#*:}"); done
                perf_info "MSR 0x64F MSR_CORE_PERF_LIMIT_REASONS 0x${plr}: now $(msr_bits "${plr}" "${pl[@]}"); logged $(msr_bits "${plr}" "${pll[@]}")" \
                    "/dev/cpu/0/msr (root)" ;;
        esac
    fi
    perf_info "the log bits are sticky: the SDM says they stay set until software writes 0, so they cover the time since boot or the last clear. doctor --perf only reads them" \
        "Intel SDM vol. 4 335592-093 (R/WC0 log bits)"
}

perf_rapl() {
    local z name en zn i cname lim max found=0 d pct
    pct=$(throttle_pct)
    for z in "${SYSROOT}"/sys/class/powercap/intel-rapl:[0-9] "${SYSROOT}"/sys/class/powercap/intel-rapl-mmio:[0-9]; do
        [ -d "${z}" ] || continue
        name=$(rf "${z}/name")
        [[ "${name}" == package* ]] || continue
        if [ "${found}" -eq 0 ]; then
            perf_section "CPU package power limits (RAPL)" \
                "PL1 (long_term) at or above the thermal spec power (TDP, reported as constraint_0_max_power_uw) so sustained inference is not clamped below spec; PL1 decides the clock under a long run, PL2 only covers short bursts. On a package that thermally throttles, a PL1 far above TDP only moves the limit from power to temperature" \
                "https://docs.kernel.org/power/powercap/powercap.html, kernel source drivers/powercap/intel_rapl_common.c (PL1 max_power = PKG_POWER_INFO thermal spec power)"
            found=1
        fi
        zn=${z#"${SYSROOT}"}
        en=$(rf "${z}/enabled")
        if [ "${en}" != 1 ]; then
            perf_info "${zn##*/} ${name}: PL1 not enabled on this interface (enabled=${en:-?})" "${zn}/enabled"
            continue
        fi
        d=""
        for i in 0 1 2; do
            cname=$(rf "${z}/constraint_${i}_name"); [ -n "${cname}" ] || continue
            lim=$(rf "${z}/constraint_${i}_power_limit_uw")
            if [[ "${lim}" =~ ^[0-9]{1,15}$ ]]; then d+="${d:+, }${cname} $((lim / 1000000)) W"; else d+="${d:+, }${cname} ${lim:-?}"; fi
        done
        max=$(rf "${z}/constraint_0_max_power_uw")
        lim=$(rf "${z}/constraint_0_power_limit_uw")
        if lt "${lim}" "${max}"; then
            perf_flag warn "${zn##*/} ${name}: PL1 $((lim / 1000000)) W is below the $((max / 1000000)) W thermal spec power (${d})" \
                "${zn}/constraint_0_power_limit_uw" \
                "under a long run the package settles at PL1, so a PL1 under TDP clocks every core below its rated sustained speed. Firmware may re-apply its own value on reboot" \
                "echo ${max} | sudo tee ${zn}/constraint_0_power_limit_uw" \
                "echo ${lim} | sudo tee ${zn}/constraint_0_power_limit_uw"
        elif lt 0 "${max}" && lt $((2 * max)) "${lim}" && [ -n "${pct}" ] && [ "${pct}" -ge 1 ]; then
            perf_flag warn "${zn##*/} ${name}: PL1 $((lim / 1000000)) W is $(awk -v a="${lim}" -v b="${max}" 'BEGIN {printf "%.1f", a / b}')x the $((max / 1000000)) W thermal spec power while the package is thermally throttled ${pct}% of uptime (${d})" \
                "${zn}/constraint_0_{power_limit_uw,max_power_uw}, /sys/devices/system/cpu/cpu0/thermal_throttle/package_throttle_total_time_ms" \
                "PL1 is the sustained package power. Set above what the cooler removes, it never binds: the package runs into its TCC point and throttles on temperature instead (see CPU thermal throttling). A PL1 the cooler can hold trades peak clocks for steady ones. 2x the thermal spec power is this tool's first step for a sweep, not an Intel figure: measure tokens/s at each step before keeping one. Firmware may re-apply its own value on reboot" \
                "echo $((2 * max)) | sudo tee ${zn}/constraint_0_power_limit_uw" \
                "echo ${lim} | sudo tee ${zn}/constraint_0_power_limit_uw"
        else
            perf_ok "${zn##*/} ${name}: ${d}$(lt 0 "${max}" && echo " (thermal spec power $((max / 1000000)) W)")" "${zn}/constraint_*_power_limit_uw"
        fi
    done
}

perf_memory() {
    local thp defrag sw total avail stot sfree used hp hpsz hfree
    thp=$(rd /sys/kernel/mm/transparent_hugepage/enabled)
    defrag=$(rd /sys/kernel/mm/transparent_hugepage/defrag)
    if [ -n "${thp}" ]; then
        perf_section "Transparent huge pages" \
            "enabled = always or madvise (fewer TLB misses over multi-GB weight and KV buffers), defrag != always (no allocation stalls mid-request)" \
            "https://docs.kernel.org/admin-guide/mm/transhuge.html#global-thp-controls"
        local mode dmode
        mode=$(bracketed "${thp}"); dmode=$(bracketed "${defrag}")
        case "${mode}" in
            never)
                perf_flag warn "THP enabled=never" /sys/kernel/mm/transparent_hugepage/enabled \
                    "huge pages cut TLB misses for large buffers; never also ignores apps that opt in with madvise(MADV_HUGEPAGE) — e.g. PyTorch's CPU allocator with THP_MEM_ALLOC_ENABLE=1 (c10/core/impl/alloc_cpu.cpp)" \
                    "echo madvise | sudo tee /sys/kernel/mm/transparent_hugepage/enabled" \
                    "echo never | sudo tee /sys/kernel/mm/transparent_hugepage/enabled" ;;
            *) perf_ok "THP enabled=${mode}" /sys/kernel/mm/transparent_hugepage/enabled ;;
        esac
        case "${dmode}" in
            always)
                perf_flag warn "THP defrag=always" /sys/kernel/mm/transparent_hugepage/defrag \
                    "always makes a THP allocation stall in direct reclaim + compaction when no huge page is free — a latency spike inside a request. madvise limits that to opted-in regions" \
                    "echo madvise | sudo tee /sys/kernel/mm/transparent_hugepage/defrag" \
                    "echo always | sudo tee /sys/kernel/mm/transparent_hugepage/defrag" ;;
            "") ;;
            *) perf_ok "THP defrag=${dmode}" /sys/kernel/mm/transparent_hugepage/defrag ;;
        esac
        # File-backed weights: ext4 gained large folios in 6.16; before that only
        # executable file mappings are collapsed into huge pages.
        local rootfs
        rootfs=$(awk '$2 == "/" {print $3; exit}' "${SYSROOT}/proc/mounts" 2>/dev/null || true)
        if [ "${rootfs}" = ext4 ] && kernel_lt 6.16; then
            local sz="<model GiB + 1>"
            if [ -n "${PERF_MODEL_GB}" ]; then sz=$(awk -v g="${PERF_MODEL_GB}" 'BEGIN {printf "%d", g + 1.999}'); fi
            perf_flag note "root filesystem is ext4 on Linux $(kernel_release): model files mmapped from it are mapped with 4 KiB pages, whatever THP enabled says" \
                "/proc/mounts, /proc/sys/kernel/osrelease" \
                "on this kernel ext4 page cache holds no large folios (fs/ext4/inode.c calls mapping_set_large_folios from 6.16), and khugepaged collapses file pages only in executable mappings (include/linux/huge_mm.h file_thp_enabled needs VM_EXEC). OpenVINO and llama.cpp mmap weights by default, so THP covers only anonymous copies. A tmpfs with huge=within_size serves the weights from huge pages (docs.kernel.org/admin-guide/mm/transhuge.html, hugepages in tmpfs/shmem); copy the model in and point the server at it" \
                "sudo mkdir -p /mnt/k3d-gpu-models && sudo mount -t tmpfs -o huge=within_size,size=${sz}G tmpfs /mnt/k3d-gpu-models" \
                "sudo umount /mnt/k3d-gpu-models"
        fi
    fi

    hp=$(meminfo_kb HugePages_Total); hfree=$(meminfo_kb HugePages_Free); hpsz=$(meminfo_kb Hugepagesize)
    if [ -n "${hp}" ]; then
        perf_section "Reserved huge pages (hugetlbfs)" \
            "0 unless a server is configured to use hugetlbfs — reserved pages cannot be used for anything else, and OpenVINO, PyTorch and llama.cpp do not use them by default" \
            "https://docs.kernel.org/admin-guide/mm/hugetlbpage.html"
        if [ "${hp}" -gt 0 ] && [ "${hfree:-0}" -gt 0 ]; then
            perf_flag note "${hp} huge pages reserved, ${hfree} free = $(kb_gib $((hfree * ${hpsz:-2048}))) GiB held back from model weights" \
                /proc/meminfo \
                "pages in the hugetlb pool are reserved inside the kernel and cannot be used for other purposes (and never swap); only keep them if a server mmaps hugetlbfs" \
                "echo 0 | sudo tee /proc/sys/vm/nr_hugepages" "echo ${hp} | sudo tee /proc/sys/vm/nr_hugepages"
        else
            perf_ok "HugePages_Total=${hp}${hfree:+, free ${hfree}}" /proc/meminfo
        fi
    fi

    total=$(meminfo_kb MemTotal); avail=$(meminfo_kb MemAvailable)
    stot=$(meminfo_kb SwapTotal); sfree=$(meminfo_kb SwapFree)
    sw=$(rd /proc/sys/vm/swappiness)
    [ -n "${total}" ] || return 0
    perf_section "Memory and swap" \
        "the model plus KV cache fits in MemAvailable with headroom and nothing is swapped; swapped-out buffers fault back in at random-I/O speed" \
        "https://docs.kernel.org/admin-guide/sysctl/vm.html#swappiness, https://docs.openvino.ai/2026/openvino-workflow/running-inference/optimize-inference/optimizing-latency.html"
    perf_info "MemTotal $(kb_gib "${total}") GiB, MemAvailable $(kb_gib "${avail}") GiB, swap $(kb_gib "${stot:-0}") GiB, vm.swappiness=${sw:-?}" /proc/meminfo
    used=$(( ${stot:-0} - ${sfree:-0} ))
    if [ "${used}" -ge 1048576 ]; then
        local apply=""
        [ "${avail:-0}" -gt $((used + 1048576)) ] \
            && apply="sudo swapoff -a && sudo swapon -a   # pulls swapped pages back into RAM; MemAvailable covers them"
        perf_flag warn "$(kb_gib "${used}") GiB of swap in use — the host is under memory pressure" /proc/meminfo \
            "anything a server keeps in anonymous memory (KV cache, runtime buffers, weights it copied) is paged back from disk when touched. Free memory or serve a smaller model before benchmarking$([ -n "${apply}" ] || echo "; MemAvailable is too small to pull the swapped pages back in right now")" \
            "${apply}" ""
    else
        perf_ok "swap in use: $(kb_gib "${used}") GiB" /proc/meminfo
    fi
    if [ -n "${sw}" ] && [ "${sw}" -gt 60 ]; then
        perf_flag note "vm.swappiness=${sw} (kernel default 60)" /proc/sys/vm/swappiness \
            "higher values make the kernel swap anonymous memory sooner. The kernel docs call the right value workload-dependent; note OpenVINO mmaps model files by default, so its weights are page cache and lowering swappiness does not protect them" \
            "sudo sysctl vm.swappiness=60" "sudo sysctl vm.swappiness=${sw}"
    fi

    if [ -n "${PERF_MODEL_GB}" ]; then
        local need_kb
        need_kb=$(awk -v g="${PERF_MODEL_GB}" 'BEGIN {printf "%d", g * 1.2 * 1048576}')
        if lt "${avail:-0}" "${need_kb}"; then
            perf_flag warn "a ${PERF_MODEL_GB} GiB model needs ~$(kb_gib "${need_kb}") GiB (model + 20% for KV cache/runtime, this tool's heuristic); MemAvailable is $(kb_gib "${avail}") GiB" \
                /proc/meminfo \
                "a model that does not fit is paged in from disk or swap on every pass. Integrated GPUs (UHD/Iris Xe/Arc iGPU) and the NPU share system RAM, so this applies to them too" \
                "" ""
        else
            perf_ok "a ${PERF_MODEL_GB} GiB model (+20% headroom = $(kb_gib "${need_kb}") GiB) fits in MemAvailable $(kb_gib "${avail}") GiB" /proc/meminfo
        fi
    else
        perf_info "pass --model-gb <size> (or K3D_GPU_MODEL_GB) to check a model against MemAvailable" /proc/meminfo
    fi
}

# dmi17 <raw file>: "<size MiB> <type> <form> <rated MT/s> <configured MT/s> <total width>
# <data width> <ranks>" of one SMBIOS type 17 (Memory Device) record. Offsets per
# SMBIOS (DSP0134) 7.18, as dmidecode.c decodes them.
dmi17() {
    local -a b
    local len size spd cfg
    read -r -a b <<< "$(od -An -tu1 -v "$1" 2>/dev/null | tr '\n' ' ')" || true
    [ "${b[0]:-}" = 17 ] || return 0
    len=${b[1]:-0}
    { [ "${len}" -ge 34 ] && [ "${#b[@]}" -ge "${len}" ]; } || return 0
    size=$(( b[12] | b[13] << 8 ))
    if [ "${size}" -eq 32767 ]; then size=$(( b[28] | b[29] << 8 | b[30] << 16 | (b[31] & 127) << 24 ))
    elif [ "${size}" -eq 65535 ]; then size=0
    elif (( size & 32768 )); then size=$(( (size & 32767) / 1024 ))
    fi
    spd=$(( b[21] | b[22] << 8 ))
    if [ "${spd}" -eq 65535 ] && [ "${len}" -ge 92 ]; then spd=$(( b[84] | b[85] << 8 | b[86] << 16 | b[87] << 24 )); fi
    cfg=$(( b[32] | b[33] << 8 ))
    if [ "${cfg}" -eq 65535 ] && [ "${len}" -ge 92 ]; then cfg=$(( b[88] | b[89] << 8 | b[90] << 16 | b[91] << 24 )); fi
    echo "${size} ${b[18]} ${b[14]} ${spd} ${cfg} $(( b[8] | b[9] << 8 )) $(( b[10] | b[11] << 8 )) $(( b[27] & 15 ))"
}

mts() { if [ "$1" -gt 0 ]; then echo "$1 MT/s"; else echo unknown; fi; }

dram_type() {
    case "$1" in
        24) echo DDR3 ;; 26) echo DDR4 ;; 29) echo LPDDR3 ;; 30) echo LPDDR4 ;; 34) echo DDR5 ;; 35) echo LPDDR5 ;;
        *) echo "type $1" ;;
    esac
}
dram_form() {
    case "$1" in 9) echo DIMM ;; 11) echo "row of chips" ;; 13) echo SODIMM ;; 16) echo die ;; *) echo "form $1" ;; esac
}

# client_line: "13S", "13HX", "13HPU", "14S" or "14HX" for 13th/14th Gen Core (Raptor
# Lake family 6 models 0xB7, 0xBA) from the model number and brand string. Model
# 0xBF (the 8+8 C0 and 6+0 H0 dies) runs 12th Gen DDR5 speeds (743844 table 25
# note 16), so it gets no line.
client_line() {
    local model name gen sfx
    [ "$(cpuinfo_field "cpu family")" = 6 ] || return 0
    model=$(cpuinfo_field model); name=$(cpuinfo_field "model name")
    [[ "${name}" =~ i[3579]-(1[34])[0-9]{3}([A-Z]*) ]] || return 0
    gen=${BASH_REMATCH[1]}; sfx=${BASH_REMATCH[2]}
    case "${model}" in
        183) if [ "${sfx}" = HX ]; then echo "${gen}HX"; else echo "${gen}S"; fi ;;
        186) if [ "${gen}" = 13 ]; then echo 13HPU; fi ;;
    esac
    return 0
}

# dram_por <line> <DIMM|SODIMM> <slots per channel> <modules per channel> <ranks>:
# "<MT/s>|<row>" of DDR5 table 25 in Intel datasheet 743844 rev. 015 (13th/14th Gen
# Core); empty when the table has no such row.
dram_por() {
    local line=$1 form=$2 dpc=$3 per=$4 rank=$5 r
    if [ "${dpc}" -le 1 ]; then
        case "${line}:${form}:${rank}" in
            13S:DIMM:1|13S:SODIMM:1|13HX:SODIMM:1) echo "5600|1DPC 1R" ;;
            13S:DIMM:2|13S:SODIMM:2|13HX:SODIMM:2) echo "5200|1DPC 2R" ;;
            13HPU:SODIMM:[12]) echo "5200|1DPC ${rank}R" ;;
            14S:DIMM:[12]|14S:SODIMM:[12]|14HX:SODIMM:[12]) echo "5600|1DPC ${rank}R" ;;
        esac
        return 0
    fi
    case "${line}:${form}" in
        13S:DIMM|14S:DIMM) r=(4400 4000 3600) ;;
        13HX:SODIMM) r=(4000 4000 3600) ;;
        14HX:SODIMM) r=(4400 4400 4000) ;;
        *) return 0 ;;
    esac
    if [ "${per}" -le 1 ]; then echo "${r[0]}|2DPC, 1 DIMM"
    elif [ "${rank}" -eq 1 ]; then echo "${r[1]}|2DPC, 2 DIMMs 1R"
    elif [ "${rank}" -eq 2 ]; then echo "${r[2]}|2DPC, 2 DIMMs 2R"
    fi
    return 0
}

perf_dram() {
    local e raw rec slots=0 n=0 size type form spd cfg tw dw rk desc="" cmin="" rated="" ecc=1 eccu=0 widths=0
    local line ch=2 dpc per por row peak t1 hb mc ce ue mcs="" mcf=""
    for e in "${SYSROOT}"/sys/firmware/dmi/entries/17-*; do
        [ -d "${e}" ] || continue
        slots=$((slots + 1))
        [ -r "${e}/raw" ] && raw=1 || raw=0
        [ "${raw}" -eq 1 ] || continue
        rec=$(dmi17 "${e}/raw")
        [ -n "${rec}" ] || continue
        read -r size type form spd cfg tw dw rk <<< "${rec}"
        [ "${size}" -gt 0 ] || continue
        n=$((n + 1))
        t1="$(dram_type "${type}") $(dram_form "${form}") $(( size / 1024 )) GiB ${rk}R"
        if [[ " ${desc} " != *"|${t1}|"* ]]; then desc+="|${t1}|"; fi
        if [ -z "${cmin}" ] || [ "${cfg}" -lt "${cmin}" ]; then cmin=${cfg}; fi
        if [ -z "${rated}" ] || [ "${spd}" -lt "${rated}" ]; then rated=${spd}; fi
        if [ "${tw}" -eq 65535 ] || [ "${dw}" -eq 65535 ]; then eccu=1; elif [ "${tw}" -le "${dw}" ]; then ecc=0; fi
        if [ "${dw}" -lt 65535 ]; then widths=$((widths + dw / 8)); fi
    done
    [ "${slots}" -gt 0 ] || return 0
    perf_section "DRAM speed, bandwidth and ECC" \
        "modules at the platform's plan-of-record (POR) speed for how the slots are populated; single-stream CPU and iGPU decode is bound by DRAM bandwidth. Memory errors counted by an EDAC driver" \
        "SMBIOS DSP0134 7.18 (type 17, as dmidecode.c decodes it), Intel datasheet 743844 rev. 015 table 25 (13th/14th Gen Core DDR support matrix, https://cdrdv2.intel.com/v1/dl/getContent/743844), https://docs.kernel.org/driver-api/edac.html"
    if [ "${n}" -eq 0 ]; then
        if [ "${raw}" -eq 0 ]; then
            perf_info "SMBIOS memory records are root-only: sudo k3d-gpu doctor --perf (or sudo dmidecode -t 17)" "/sys/firmware/dmi/entries/17-*/raw"
        else
            perf_info "no populated memory device in SMBIOS (VM or firmware without type 17)" "/sys/firmware/dmi/entries/17-*/raw"
        fi
        return 0
    fi
    desc=${desc#|}; desc=${desc%|}; desc=${desc//||/, }
    form=$(dram_form "${form}")
    perf_info "${n}x ${desc}$([ "${ecc}${eccu}" = 10 ] && echo ", ECC (${tw}/${dw}-bit)"): rated $(mts "${rated}"), configured $(mts "${cmin}"); ${n} of ${slots} slots populated" \
        "/sys/firmware/dmi/entries/17-*/raw (root)"

    line=$(client_line)
    if [ "${cmin}" -eq 0 ]; then
        perf_info "configured speed not reported by firmware: no POR comparison or peak bandwidth" "/sys/firmware/dmi/entries/17-*/raw (root)"
    elif [ -n "${line}" ]; then
        dpc=$(( (slots + ch - 1) / ch ))
        per=1; if [ "${n}" -gt "${ch}" ]; then per=2; fi
        por=$(dram_por "${line}" "${form}" "${dpc}" "${per}" "${rk}")
        if [ -z "${por}" ] && [ "${dpc}" -ge 2 ] && [ "${form}" = SODIMM ] && [[ "${line}" == *S ]]; then
            por=$(dram_por "${line}" DIMM "${dpc}" "${per}" "${rk}")
            if [ -n "${por}" ]; then
                perf_info "SODIMMs at 2 slots per channel are not a supported configuration on the ${line%S}th Gen Core S line (743844 table 25 note 9); the nearest POR row, UDIMM ${por#*|}, is ${por%%|*} MT/s" \
                    "/proc/cpuinfo (model ${line}), /sys/firmware/dmi/entries/17-*/raw"
            fi
        fi
        if [ -n "${por}" ]; then
            row=${por#*|}; por=${por%%|*}
            if lt "${cmin}" "${por}" && lt "${cmin}" "${rated}"; then
                perf_flag warn "configured ${cmin} MT/s is below the ${por} MT/s POR for ${row} (modules rated ${rated})" \
                    "/sys/firmware/dmi/entries/17-*/raw (root)" \
                    "peak DRAM bandwidth scales with the transfer rate; the platform supports ${por} MT/s for this population (743844 table 25). That POR is the top SKU's speed (743844 table 25 note 17); a lower SKU can be specified lower: check ark.intel.com for $(cpuinfo_field "model name") before raising it" \
                    "BIOS: set the memory frequency to $(( por < rated ? por : rated )) MT/s (or Auto/JEDEC), then reboot" \
                    "BIOS: set it back to ${cmin} MT/s"
            else
                perf_ok "configured ${cmin} MT/s is at the ${por} MT/s POR for ${row}" "/sys/firmware/dmi/entries/17-*/raw (root)"
            fi
            if [ "${dpc}" -ge 2 ] && [ "${per}" -ge 2 ]; then
                t1=$(dram_por "${line}" "${form}" 1 1 "${rk}"); t1=${t1%%|*}
                if [ -n "${t1}" ]; then
                    t1=$(( t1 < rated ? t1 : rated ))
                    if [ "${t1}" -gt "${cmin}" ]; then
                        perf_info "at one module per channel these modules would run at ${t1} MT/s (the lower of rated ${rated} and the 1DPC ${rk}R POR): $(awk -v m="${t1}" 'BEGIN {printf "%.1f", 2 * m * 8 / 1000}') GB/s peak, with ${ch} of the ${n} modules (less capacity)" \
                            "743844 table 25"
                    fi
                fi
            fi
        fi
        peak=$(awk -v c="$(( n < ch ? n : ch ))" -v m="${cmin}" 'BEGIN {printf "%.1f", c * m * 8 / 1000}')
        perf_info "peak DRAM bandwidth ${peak} GB/s = $(( n < ch ? n : ch )) channels x ${cmin} MT/s x 8 B (computed; CPU and iGPU decode share it)" \
            "/sys/firmware/dmi/entries/17-*/raw (root)"
    else
        peak=$(awk -v w="${widths}" -v m="${cmin}" 'BEGIN {printf "%.1f", w * m / 1000}')
        perf_info "peak DRAM bandwidth ${peak} GB/s = ${cmin} MT/s x ${widths} B of data width (computed, assuming one module per channel; this tool has no POR table for this CPU)" \
            "/sys/firmware/dmi/entries/17-*/raw (root)"
    fi

    for mc in "${SYSROOT}"/sys/devices/system/edac/mc/mc[0-9]*; do
        [ -d "${mc}" ] || continue
        ce=$(rf "${mc}/ce_count"); ue=$(rf "${mc}/ue_count")
        mcs+="${mcs:+, }${mc##*/} $(rf "${mc}/mc_name") ce ${ce:-?} ue ${ue:-?}"
        mcf="${mc#"${SYSROOT}"}"
        if lt 0 "${ue}"; then
            perf_flag warn "${mc##*/}: ${ue} uncorrected memory errors since boot" "${mcf}/ue_count" \
                "an uncorrected error means corrupted data reached software; on an inference node that can be wrong weights or KV cache" \
                "none on the host: run a memory test and replace the failing module (edac-util or the kernel log names the DIMM)" "none"
        fi
    done
    if [ "${eccu}" -eq 1 ]; then
        perf_info "module widths not reported by firmware: ECC state unknown" "/sys/firmware/dmi/entries/17-*/raw (root)"
    elif [ "${ecc}" -eq 0 ]; then
        perf_info "non-ECC modules: memory errors are neither corrected nor counted (dram.ecc=none)" "/sys/firmware/dmi/entries/17-*/raw (total width = data width)"
    elif [ -n "${mcs}" ]; then
        perf_ok "ECC modules with EDAC reporting (dram.ecc=active): ${mcs}" "/sys/devices/system/edac/mc/mc*/{ce,ue}_count"
    else
        hb=$(rf "${SYSROOT}/sys/bus/pci/devices/0000:00:00.0/device")
        local apply="load the EDAC driver for host bridge 8086:${hb#0x} if this kernel has one (ls /lib/modules/\$(uname -r)/kernel/drivers/edac)" revert="unload that driver again"
        # ie31200_edac device IDs: Raptor Lake-S a703/4640/4630 from 6.15; a700 and
        # Alder Lake-S 4660 from 6.16 (drivers/edac/ie31200_edac.c at v6.15, v6.16).
        local kv=""
        case "${hb}" in
            0xa703|0x4640|0x4630) kv=6.15 ;;
            0xa700|0x4660) kv=6.16 ;;
        esac
        if [ -n "${kv}" ]; then
            if kernel_lt "${kv}"; then apply="boot Linux ${kv} or newer (ie31200_edac binds host bridge 8086:${hb#0x} from ${kv}), then: sudo modprobe ie31200_edac"
            else apply="sudo modprobe ie31200_edac"; fi
            revert="sudo modprobe -r ie31200_edac"
        fi
        perf_flag note "ECC modules, but no EDAC memory controller is registered: corrected and uncorrected errors are not counted (dram.ecc=unmonitored)" \
            "/sys/devices/system/edac/mc/ (no mc*), /sys/firmware/dmi/entries/17-*/raw" \
            "without an EDAC driver a failing module shows up only as crashes or silent corruption; with one, ce_count/ue_count give early warning" \
            "${apply}" "${revert}"
    fi
}

perf_ksm() {
    local run share
    run=$(rd /sys/kernel/mm/ksm/run)
    [ -n "${run}" ] || return 0
    perf_section "Kernel samepage merging (KSM)" \
        "off (run=0, the kernel default) on a node that runs other tenants' pods: merged pages are shared copy-on-write, and the write fault on a merged page is a timing signal another tenant can observe" \
        "https://docs.kernel.org/admin-guide/mm/ksm.html, Suzaki et al., Memory Deduplication as a Threat to the Guest OS, EuroSec 2011"
    share=$(rd /sys/kernel/mm/ksm/pages_sharing)
    if [ "${run}" = 1 ]; then
        perf_flag note "KSM is running (run=1, pages_sharing=${share:-?})" /sys/kernel/mm/ksm/run \
            "KSM merges identical pages of processes that opted in with madvise(MADV_MERGEABLE) or prctl. Fine for one trusted tenant; on a shared node it opens the dedup timing side channel. run=2 stops ksmd and unmerges every merged page" \
            "echo 2 | sudo tee /sys/kernel/mm/ksm/run" "echo 1 | sudo tee /sys/kernel/mm/ksm/run"
    else
        perf_ok "KSM off (run=${run}${share:+, pages_sharing=${share}})" /sys/kernel/mm/ksm/run
    fi
}

perf_irqbalance() {
    local c running=0 enabled=0
    compgen -G "${SYSROOT}/proc/[0-9]*/comm" >/dev/null || return 0
    compgen -G "${SYSROOT}/etc/systemd/system/*.wants/irqbalance.service" >/dev/null && enabled=1
    perf_section "IRQ balancing" \
        "irqbalance running, so interrupt load (NIC, NVMe, GPU) is spread over CPUs instead of piling onto the cores that serve tokens" \
        "https://github.com/Irqbalance/irqbalance"
    for c in "${SYSROOT}"/proc/[0-9]*/comm; do
        [ "$(rf "${c}")" = irqbalance ] && { running=1; break; }
    done
    if [ "${running}" -eq 1 ]; then
        perf_ok "irqbalance is running" "/proc/*/comm"
    else
        if [ "${enabled}" -eq 1 ]; then
            perf_flag note "irqbalance is enabled but not running" "/proc/*/comm, /etc/systemd/system/*.wants/irqbalance.service" \
                "irqbalance spreads the highest-volume interrupt sources across CPUs. It matters most on a busy NIC or many NVMe queues; a single-user desktop sees little difference" \
                "sudo systemctl start irqbalance" "sudo systemctl stop irqbalance"
        else
            perf_flag note "irqbalance is not running" "/proc/*/comm, /etc/systemd/system/*.wants/irqbalance.service" \
                "irqbalance spreads the highest-volume interrupt sources across CPUs. It matters most on a busy NIC or many NVMe queues; a single-user desktop sees little difference" \
                "sudo systemctl enable --now irqbalance   # install the irqbalance package first if the unit is missing" \
                "sudo systemctl disable --now irqbalance"
        fi
    fi
}

# pcie_gen <"16.0 GT/s PCIe">: the PCIe generation of a link speed, empty when unknown.
pcie_gen() {
    case "${1%% *}" in 2.5) echo 1 ;; 5.0) echo 2 ;; 8.0) echo 3 ;; 16.0) echo 4 ;; 32.0) echo 5 ;; 64.0) echo 6 ;; esac
    return 0
}

perf_pcie() {
    local d dn bdf up ub dg dw ug uw eg ew c cb cg cw hop bad fb rb msg found=0 r line poss bit max start end cur best="" bestn ids nv=0 out
    for d in "${SYSROOT}"/sys/bus/pci/devices/*; do
        [[ "$(rf "${d}/class")" == 0x03* ]] || continue
        bdf=${d##*/}
        ids="$(rf "${d}/vendor" | sed 's/^0x//'):$(rf "${d}/device" | sed 's/^0x//')"
        [ "$(rf "${d}/vendor")" != 0x10de ] || nv=$((nv + 1))
        dg=$(pcie_gen "$(rf "${d}/max_link_speed")"); dw=$(rf "${d}/max_link_width")
        dn=${d#"${SYSROOT}"}
        if [ "${found}" -eq 0 ] && { [ -n "${dg}" ] || compgen -G "${d}/resource[0-5]_resize" >/dev/null; }; then
            perf_section "GPU PCIe links and BAR sizes" \
                "each GPU's link trains at the device's own maximum (its upstream port is not slower or narrower), and the large BAR maps all of VRAM (Resizable BAR)" \
                "https://docs.kernel.org/PCI/sysfs-pci.html, kernel source drivers/pci/pci-sysfs.c (max_link_*, resourceN_resize) and drivers/pci/pci.c pci_rebar_get_possible_sizes (bit 0 = 1 MB)"
            found=1
        fi
        # Links: every hop from the device up to its root port, so a card with its own
        # switch (Arc A/B dGPUs) is judged at the slot link above that switch. The first
        # hop whose port is slower or narrower than the device below it is reported.
        # current_link_* drops at idle, so only max_* is compared.
        if [ -n "${dg}" ] && [[ "${dw}" =~ ^[0-9]{1,2}$ ]]; then
            c=$(readlink -f "${d}"); hop=0; bad=""; fb=""; rb=""
            while up=$(dirname "${c}"); ub=${up##*/}; [[ "${ub}" =~ ^[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-7]$ ]]; do
                cg=$(pcie_gen "$(rf "${c}/max_link_speed")"); cw=$(rf "${c}/max_link_width")
                ug=$(pcie_gen "$(rf "${up}/max_link_speed")"); uw=$(rf "${up}/max_link_width")
                if [ -n "${cg}" ] && [[ "${cw}" =~ ^[0-9]{1,2}$ ]] && [ -n "${ug}" ] && [[ "${uw}" =~ ^[0-9]{1,2}$ ]]; then
                    hop=$((hop + 1)); rb=${ub}
                    [ "${hop}" -gt 1 ] || fb="${ub} (Gen${ug} x${uw})"
                    if [ -z "${bad}" ] && { [ "${ug}" -lt "${cg}" ] || [ "${uw}" -lt "${cw}" ]; }; then
                        bad="${c##*/} ${cg} ${cw} ${ub} ${ug} ${uw}"
                    fi
                fi
                c=${up}
            done
            if [ -n "${bad}" ]; then
                read -r cb cg cw ub ug uw <<< "${bad}"
                eg=$(( cg < ug ? cg : ug )); ew=$(( cw < uw ? cw : uw ))
                if [ "${cb}" = "${bdf}" ]; then
                    msg="device Gen${dg} x${dw}, upstream port ${ub} Gen${ug} x${uw}: the link trains at most Gen${eg} x${ew}"
                else
                    msg="${cb} Gen${cg} x${cw} on its path to the root port sits behind port ${ub} Gen${ug} x${uw}: the GPU's traffic crosses a link of at most Gen${eg} x${ew}"
                fi
                perf_flag warn "${bdf} [${ids}]: ${msg}" \
                    "/sys/bus/pci/devices/${cb}/max_link_{speed,width}, /sys/bus/pci/devices/${ub}/max_link_{speed,width}" \
                    "a link trains to the lower speed and width of its two ends. current_link_* reads lower at idle (link power management), so only max_* is compared. Keep this GPU's weights and KV cache resident (nothing streamed over the link) and give the widest link to the GPU that moves the most data" \
                    "hardware: move the card to a slot whose port is at least x${cw} (no host command changes the link width)" \
                    "hardware: move it back"
            elif [ "${hop}" -gt 0 ]; then
                perf_ok "${bdf} [${ids}]: Gen${dg} x${dw} behind port ${fb}: the link can reach the device maximum$([ "${rb}" = "${fb%% *}" ] || echo "; no narrower link up to root port ${rb}")" \
                    "${dn}/max_link_{speed,width}, /sys/bus/pci/devices/${fb%% *}/max_link_{speed,width}$([ "${rb}" = "${fb%% *}" ] || echo " and each port up to ${rb}")"
            fi
        fi
        # Resizable BAR: the BAR with the largest supported size, against its current size.
        best=""; bestn=""
        for r in "${d}"/resource[0-5]_resize; do
            [ -f "${r}" ] || continue
            poss=$(rf "${r}"); [[ "${poss}" =~ ^[0-9a-f]{1,16}$ ]] || continue
            poss=$((16#${poss})); [ "${poss}" -gt 0 ] || continue
            bit=0; while [ $((poss >> (bit + 1))) -gt 0 ]; do bit=$((bit + 1)); done
            max=$(( (1 << 20) << bit ))
            if [ -z "${best}" ] || [ "${max}" -gt "${best}" ]; then best=${max}; bestn=${r##*/resource}; bestn=${bestn%_resize}; fi
        done
        if [ -n "${best}" ]; then
            line=$(sed -n "$((bestn + 1))p" "${d}/resource" 2>/dev/null || true)
            read -r start end _ <<< "${line}"
            if [[ "${start}" =~ ^0x[0-9a-f]{1,16}$ && "${end}" =~ ^0x[0-9a-f]{1,16}$ ]] && [ "$((start))" -gt 0 ]; then
                cur=$(( end - start + 1 ))
                if [ "${cur}" -lt "${best}" ]; then
                    perf_flag warn "${bdf} [${ids}]: BAR${bestn} is $(bytes_h "${cur}"); the device can map up to $(bytes_h "${best}") (Resizable BAR not in use)" \
                        "${dn}/resource, ${dn}/resource${bestn}_resize" \
                        "the CPU reaches VRAM through this BAR; a small BAR means the driver remaps a window for host-to-device copies instead of mapping all of VRAM. Resizing needs firmware support (Above 4G decoding)" \
                        "BIOS: enable Above 4G Decoding and Re-Size BAR Support, then reboot" \
                        "BIOS: disable Re-Size BAR Support, then reboot"
                else
                    perf_ok "${bdf} [${ids}]: BAR${bestn} $(bytes_h "${cur}"), the largest size it supports" "${dn}/resource, ${dn}/resource${bestn}_resize"
                fi
            fi
        fi
    done
    [ "${found}" -eq 1 ] || return 0
    if [ "${nv}" -ge 2 ]; then
        if command -v nvidia-smi >/dev/null 2>&1; then
            out=$(nvidia-smi topo -p2p r 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' || true)
            local -a row
            local pairs="" i j
            while read -r -a row; do
                [[ "${row[0]:-}" =~ ^GPU([0-9]+)$ ]] || continue
                i=${BASH_REMATCH[1]}
                for ((j = 1; j < ${#row[@]}; j++)); do
                    [ $((j - 1)) -gt "${i}" ] || continue
                    pairs+="${pairs:+, }GPU${i}-GPU$((j - 1)) ${row[j]}"
                done
            done <<< "${out}"
            if [ -z "${pairs}" ]; then
                perf_info "GPU peer-to-peer: nvidia-smi topo -p2p r printed no matrix" "nvidia-smi topo -p2p r"
            elif [[ "${pairs}" =~ \ (NS|CNS|GNS|TNS|U)(,|$) ]]; then
                perf_info "GPU peer-to-peer reads: ${pairs} (NS/CNS/TNS = not supported): tensor parallel across these GPUs goes through host memory; run one replica per GPU instead" \
                    "nvidia-smi topo -p2p r"
            else
                perf_ok "GPU peer-to-peer reads: ${pairs}" "nvidia-smi topo -p2p r"
            fi
        else
            perf_info "GPU peer-to-peer not checked: nvidia-smi not found" "nvidia-smi topo -p2p r"
        fi
    fi
}

perf_igpu() {
    local card gt f drv cur mn mx boost rp0 rp1 rpn act thr d profile slpc huc wb wbf wbk found=0
    for card in "${SYSROOT}"/sys/class/drm/card[0-9]*; do
        [[ "${card##*/}" =~ ^card[0-9]+$ ]] || continue
        drv=$(basename "$(readlink "${card}/device/driver" 2>/dev/null)")
        [ "$(rf "${card}/device/vendor")" = 0x8086 ] || continue
        for gt in "${card}"/gt/gt[0-9]* "${card}"/device/tile[0-9]*/gt[0-9]*/freq0; do
            [ -d "${gt}" ] || continue
            d=${gt#"${SYSROOT}"}
            if [ "${found}" -eq 0 ]; then
                perf_section "Intel GPU frequency" \
                    "max request at RP0 (no cap); boost at RP0 so a waiting client gets full clock; under GuC SLPC the firmware picks the frequency between min and max" \
                    "kernel source drivers/gpu/drm/i915/gt/intel_gt_sysfs_pm.c + uc/intel_guc_slpc.c + intel_gt_pm_debugfs.c (i915: RP1 floor, waitboost counters), https://docs.kernel.org/gpu/xe/xe_gt_freq.html (xe)"
                found=1
            fi
            if [ -f "${gt}/rps_cur_freq_mhz" ]; then
                cur=$(rf "${gt}/rps_cur_freq_mhz"); act=$(rf "${gt}/rps_act_freq_mhz")
                mn=$(rf "${gt}/rps_min_freq_mhz"); mx=$(rf "${gt}/rps_max_freq_mhz")
                boost=$(rf "${gt}/rps_boost_freq_mhz"); rp0=$(rf "${gt}/rps_RP0_freq_mhz"); rpn=$(rf "${gt}/rps_RPn_freq_mhz")
                # i915 creates slpc_ignore_eff_freq only when GuC SLPC owns frequency.
                if [ -f "${gt}/slpc_ignore_eff_freq" ]; then slpc="GuC SLPC"; else slpc="host RPS (no GuC SLPC)"; fi
                rp1=$(rf "${gt}/rps_RP1_freq_mhz")
                perf_info "${card##*/} ${drv} ${gt##*/}: ${slpc}; cur ${cur} / act ${act:-?} MHz, min ${mn}, max ${mx}, boost ${boost:-?}, RPn ${rpn}${rp1:+, RP1 ${rp1}}, RP0 ${rp0}" "${d}/rps_*_freq_mhz"
                if [ "$(rf "${gt}/slpc_ignore_eff_freq")" = 0 ] && lt "${mn}" "${rp1}"; then
                    perf_info "${card##*/} ${gt##*/}: slpc_ignore_eff_freq=0, so GuC SLPC keeps the efficient frequency RP1 ${rp1} MHz as its floor while busy, above min ${mn} MHz (i915 drops the floor to min only when the flag is 1)" \
                        "${d}/slpc_ignore_eff_freq, ${d}/rps_RP1_freq_mhz"
                fi
                # Waitboost count: debugfs (root). SLPC: uc/guc_slpc_info; host RPS: rps_boost.
                wbf="/sys/kernel/debug/dri/${card##*/card}/${gt##*/}/rps_boost"; wbk="Wait boosts:"
                if [ "${slpc}" = "GuC SLPC" ]; then wbf="/sys/kernel/debug/dri/${card##*/card}/${gt##*/}/uc/guc_slpc_info"; wbk="waitboosts:"; fi
                wb=$(awk -v k="${wbk}" 'index($0, k) {sub(/.*: */, ""); print; exit}' "${SYSROOT}${wbf}" 2>/dev/null || true)
                if [ -n "${wb}" ]; then
                    perf_info "${card##*/} ${gt##*/}: ${wb} waitboosts since boot (a client waiting on the GPU raised the frequency to boost ${boost:-?} MHz)" "${wbf} (root)"
                else
                    perf_info "${card##*/} ${gt##*/}: waitboost count not readable (debugfs needs root: sudo cat ${wbf})" "${wbf}"
                fi
                if lt "${mx}" "${rp0}"; then
                    perf_flag warn "${card##*/} ${gt##*/}: max ${mx} MHz is below RP0 ${rp0} MHz" "${d}/rps_max_freq_mhz" \
                        "the max request caps every kernel the GPU runs" \
                        "echo ${rp0} | sudo tee ${d}/rps_max_freq_mhz" "echo ${mx} | sudo tee ${d}/rps_max_freq_mhz"
                fi
                if lt "${boost}" "${rp0}"; then
                    perf_flag warn "${card##*/} ${gt##*/}: boost ${boost} MHz is below RP0 ${rp0} MHz" "${d}/rps_boost_freq_mhz" \
                        "when a client waits on the GPU, i915 (and SLPC waitboost) raises the min request to the boost frequency" \
                        "echo ${rp0} | sudo tee ${d}/rps_boost_freq_mhz" "echo ${boost} | sudo tee ${d}/rps_boost_freq_mhz"
                fi
                if lt "${mn}" "${rp0}"; then
                    perf_flag note "${card##*/} ${gt##*/}: min ${mn} MHz — the GPU ramps from there on each burst" "${d}/rps_min_freq_mhz" \
                        "pinning min to RP0 removes the ramp for bursty single-user inference but holds full clock (and power) while idle; on a shared-TDP part it also takes power budget from the CPU cores. Benchmark both" \
                        "echo ${rp0} | sudo tee ${d}/rps_min_freq_mhz" "echo ${mn} | sudo tee ${d}/rps_min_freq_mhz"
                fi
                thr=$(rf "${gt}/throttle_reason_status")
                if [ "${thr}" = 1 ]; then
                    local r reasons=""
                    for r in pl1 pl2 pl4 prochot ratl thermal vr_tdc vr_thermalert; do
                        [ "$(rf "${gt}/throttle_reason_${r}")" = 1 ] && reasons+=" ${r}"
                    done
                    perf_info "${card##*/} ${gt##*/}: throttled right now:${reasons:- (reason not reported)}" "${d}/throttle_reason_*"
                fi
            else
                cur=$(rf "${gt}/cur_freq"); act=$(rf "${gt}/act_freq")
                mn=$(rf "${gt}/min_freq"); mx=$(rf "${gt}/max_freq")
                rp0=$(rf "${gt}/rp0_freq"); rpn=$(rf "${gt}/rpn_freq")
                perf_info "${card##*/} ${drv} ${d#*device/}: GuC SLPC (xe); cur ${cur} / act ${act} MHz, min ${mn}, max ${mx}, RPn ${rpn}, RP0 ${rp0}" "${d}/*_freq"
                if lt "${mx}" "${rp0}"; then
                    perf_flag warn "${card##*/}: max ${mx} MHz is below RP0 ${rp0} MHz" "${d}/max_freq" \
                        "the max request caps every kernel the GPU runs" \
                        "echo ${rp0} | sudo tee ${d}/max_freq" "echo ${mx} | sudo tee ${d}/max_freq"
                fi
                profile=$(rf "${gt}/power_profile")
                if [[ "${profile}" == *"[power_saving]"* ]]; then
                    perf_flag warn "${card##*/}: SLPC power_profile is power_saving" "${d}/power_profile" \
                        "power_saving tells GuC SLPC to favour energy; base is the default balance" \
                        "echo base | sudo tee ${d}/power_profile" "echo power_saving | sudo tee ${d}/power_profile"
                fi
            fi
        done
    done
    [ "${found}" -eq 1 ] || return 0
    huc=$(cat "${SYSROOT}"/sys/kernel/debug/dri/*/gt0/uc/huc_info 2>/dev/null | grep -m1 -i 'status' || true)
    perf_info "HuC: ${huc:-not readable (debugfs needs root: sudo cat /sys/kernel/debug/dri/*/gt0/uc/huc_info)} — HuC is the HEVC/AVC media microcontroller, not used by inference" \
        "/sys/kernel/debug/dri/*/gt0/uc/huc_info (see https://docs.kernel.org/gpu/i915.html#huc)"
}

perf_nvidia() {
    has_nvidia || return 0
    command -v nvidia-smi >/dev/null 2>&1 || return 0
    local idx name pm daemon=0 c out rc=0
    perf_section "NVIDIA persistence" \
        "driver state kept initialized between jobs, so a new pod does not pay seconds of GPU init; NVIDIA's preferred way is nvidia-persistenced, legacy is nvidia-smi -pm 1" \
        "https://docs.nvidia.com/deploy/driver-persistence/persistence-mode-legacy.html, https://docs.nvidia.com/deploy/driver-persistence/background.html"
    for c in "${SYSROOT}"/proc/[0-9]*/comm; do
        [ "$(rf "${c}")" = nvidia-persiste ] && { daemon=1; break; }
    done
    [ "${daemon}" -eq 0 ] || perf_ok "nvidia-persistenced is running" "/proc/*/comm"
    out=$(nvidia-smi --query-gpu=index,name,persistence_mode --format=csv,noheader 2>&1) || rc=$?
    if [ "${rc}" -ne 0 ] || { [ -n "${out//[[:space:]]/}" ] && ! grep -qE '^[0-9]+,' <<< "${out}"; }; then
        perf_flag warn "nvidia-smi failed (exit ${rc}): $(head -n1 <<< "${out}")" "nvidia-smi --query-gpu=persistence_mode" \
            "the driver could not be queried, so persistence was not checked. 'Driver/library version mismatch' after a driver upgrade means the loaded kernel module is older than the userspace library; a reboot loads the matching module" \
            "" ""
        return 0
    fi
    while IFS=',' read -r idx name pm; do
        name="${name# }"; pm="${pm# }"
        [ -n "${idx}" ] || continue
        if [ "${pm}" = Enabled ]; then
            perf_ok "GPU ${idx} ${name}: persistence ${pm}" "nvidia-smi --query-gpu=persistence_mode"
        else
            perf_flag warn "GPU ${idx} ${name}: persistence ${pm}" "nvidia-smi --query-gpu=persistence_mode" \
                "with no client attached the driver tears GPU state down; the next CUDA job re-initializes it, which NVIDIA puts at seconds" \
                "sudo systemctl enable --now nvidia-persistenced   # or: sudo nvidia-smi -i ${idx} -pm 1" \
                "sudo systemctl disable --now nvidia-persistenced   # or: sudo nvidia-smi -i ${idx} -pm 0"
        fi
    done < <(grep -E '^[0-9]+,' <<< "${out}")
}

perf_isolation() {
    local km p v kv="" units=0 u d bdf g gn m mb others cls types="" sld mit flags tme cet sc pf f
    [ -n "$(cpuinfo_field flags)" ] || return 0   # procfs files report size 0, so no -s test
    perf_section "Isolation for sandboxed agents" \
        "/dev/kvm usable for microVM sandboxes, each GPU alone in its IOMMU group, split-lock detection on, CET known, GPU observation streams limited to CAP_PERFMON" \
        "https://docs.kernel.org/driver-api/vfio.html (IOMMU groups), https://docs.kernel.org/admin-guide/kernel-parameters.html (split_lock_detect), https://docs.kernel.org/admin-guide/sysctl/kernel.html (split_lock_mitigate), kernel source drivers/gpu/drm/i915/i915_perf.c and drivers/gpu/drm/xe/xe_observation.c (paranoid sysctls), Intel SDM vol. 4 335592-093 (IA32_S_CET 6A2H, IA32_TME_ACTIVATE 982H)"

    # KVM
    km=/sys/module/kvm_intel/parameters
    for p in nested enable_apicv ept; do
        v=$(rd "${km}/${p}"); [ -z "${v}" ] || kv+=" ${p}=${v}"
    done
    if [ -e "${SYSROOT}/dev/kvm" ]; then
        perf_info "/dev/kvm present${kv:+; kvm_intel${kv}}: microVM sandboxes (Kata, Firecracker) can run here" "/dev/kvm, ${km}/*"
    elif cpu_flag vmx; then
        perf_flag note "the CPU has VT-x (vmx) but /dev/kvm is missing: no microVM sandboxes" "/proc/cpuinfo (vmx), /dev/kvm" \
            "kvm_intel creates /dev/kvm; without it Kata or Firecracker cannot start a VM" \
            "sudo modprobe kvm_intel" "sudo modprobe -r kvm_intel"
    else
        perf_info "no VT-x (vmx flag) exposed: no microVM sandboxes (VT-x off in BIOS, or a VM without nested virtualization)" "/proc/cpuinfo"
    fi

    # IOMMU and per-GPU groups
    for u in "${SYSROOT}"/sys/class/iommu/*; do [ -e "${u}" ] && units=$((units + 1)); done
    if [ "${units}" -eq 0 ]; then
        if cpu_flag vmx; then
            perf_flag note "no IOMMU unit registered: no DMA isolation between devices, no GPU passthrough into a microVM" "/sys/class/iommu/" \
                "VFIO hands a device to a VM only with its IOMMU group; without VT-d enabled there are no groups" \
                "BIOS: enable VT-d, then add intel_iommu=on to the kernel command line and reboot" \
                "remove intel_iommu=on from the kernel command line and reboot"
        fi
    else
        for d in "${SYSROOT}"/sys/bus/pci/devices/*; do
            [[ "$(rf "${d}/class")" == 0x03* ]] || continue
            [ -L "${d}/iommu_group" ] || continue
            bdf=${d##*/}; g=$(readlink -f "${d}/iommu_group"); gn=${g##*/}
            [ -z "$(rf "${g}/type")" ] || [[ " ${types} " == *" $(rf "${g}/type") "* ]] || types+=" $(rf "${g}/type")"
            others=""
            for m in "${g}"/devices/*; do
                mb=${m##*/}
                [ "${mb%.*}" != "${bdf%.*}" ] || continue        # the GPU's own functions
                cls=$(rf "${m}/class")
                [[ "${cls}" != 0x0604* ]] || continue             # PCIe bridges/ports
                others+="${others:+, }${mb} (class ${cls:-?})"
            done
            if [ -n "${others}" ]; then
                perf_flag warn "${bdf}: IOMMU group ${gn} also holds ${others}" "/sys/bus/pci/devices/${bdf}/iommu_group/devices/" \
                    "VFIO assigns whole groups, so this GPU can go into a microVM only together with those devices; the group is the smallest unit the hardware isolates. Never use pcie_acs_override: it reports isolation the hardware does not enforce" \
                    "hardware: a slot behind a root port with ACS (or a BIOS ACS option)" "hardware: move it back"
            else
                perf_ok "${bdf}: alone in IOMMU group ${gn} (with its own functions and upstream ports): can be passed to a microVM by itself" \
                    "/sys/bus/pci/devices/${bdf}/iommu_group/devices/"
            fi
        done
        perf_info "${units} IOMMU unit(s); default domain type:${types:- ?}" "/sys/class/iommu/, /sys/kernel/iommu_groups/*/type"
    fi

    # CET
    flags=""; for f in user_shstk ibt; do if cpu_flag "${f}"; then flags+="${flags:+, }${f}"; fi; done
    cet=$(msr 0 0x6A2)
    if [ -n "${flags}" ] || [ -n "${cet}" ]; then
        perf_info "CET flags: ${flags:-none}$([ -n "${cet}" ] && echo "; IA32_S_CET 0x${cet}: kernel IBT $( (( (16#${cet} >> 2) & 1 )) && echo on || echo off)")$(cpu_flag user_shstk && echo "; user shadow stacks are opt-in per process (glibc.cpu.x86_shstk tunable)")" \
            "/proc/cpuinfo${cet:+, /dev/cpu/0/msr (root)}"
    fi

    # Split-lock detection
    if cpu_flag split_lock_detect || cpu_flag bus_lock_detect; then
        sld=$(rf "${SYSROOT}/proc/cmdline" | awk '{for (i = 1; i <= NF; i++) if (index($i, "split_lock_detect=") == 1) v = substr($i, 19)} END {print v}')
        mit=$(rd /proc/sys/kernel/split_lock_mitigate)
        if [ "${sld}" = off ]; then
            perf_flag warn "split-lock detection is off (split_lock_detect=off on the kernel command line)" "/proc/cmdline" \
                "each split lock stalls memory traffic system-wide; one tenant's code can slow every other pod. warn (the default) logs and throttles the offender" \
                "remove split_lock_detect=off from the kernel command line and reboot" "add split_lock_detect=off back and reboot"
        elif [ "${mit}" = 0 ]; then
            perf_flag note "split_lock_mitigate=0: split lockers are logged but not slowed" /proc/sys/kernel/split_lock_mitigate \
                "the kernel docs: 0 exposes the system to denial of service from split lockers; 1 (default) makes them wait and serializes split locks" \
                "sudo sysctl kernel.split_lock_mitigate=1" "sudo sysctl kernel.split_lock_mitigate=0"
        else
            perf_ok "split-lock detection ${sld:-warn (default)}${mit:+, split_lock_mitigate=${mit}}" "/proc/cpuinfo, /proc/cmdline, /proc/sys/kernel/split_lock_mitigate"
        fi
    fi

    # TME
    tme=$(msr 0 0x982)
    if [ -n "${tme}" ]; then
        if (( (16#${tme} & 3) == 3 )); then
            perf_info "TME active (IA32_TME_ACTIVATE 0x${tme}: locked, encryption enabled; mem-encryption=tme-active)" "/dev/cpu/0/msr (root)"
        elif cpu_flag tme || (( 16#${tme} & 1 )); then
            perf_info "TME capable but off (IA32_TME_ACTIVATE 0x${tme}: lock=$(( 16#${tme} & 1 )) enable=$(( (16#${tme} >> 1) & 1 )); mem-encryption=tme-capable-off). Enabling is a BIOS setting" "/dev/cpu/0/msr (root)"
        fi
    elif cpu_flag tme; then
        perf_info "tme flag set: TME capable. Whether firmware enabled it needs root (MSR 0x982); kernels before 6.10 keep the flag either way, 6.10 and later clear it when firmware left TME off" "/proc/cpuinfo"
    fi

    # GPU observation streams
    for pf in /proc/sys/dev/i915/perf_stream_paranoid /proc/sys/dev/xe/observation_paranoid; do
        v=$(rd "${pf}"); [ -n "${v}" ] || continue
        sc=${pf#/proc/sys/}; sc=${sc//\//.}
        if [ "${v}" = 0 ]; then
            perf_flag warn "${sc}=0: any user can open system-wide GPU observation (OA) streams" "${pf}" \
                "the driver gates system-wide OA counters on this sysctl or CAP_PERFMON; with 0 a pod with the render node can watch other tenants' GPU activity" \
                "sudo sysctl ${sc}=1" "sudo sysctl ${sc}=0"
        else
            perf_ok "${sc}=${v}" "${pf}"
        fi
    done
}

perf_docker() {
    command -v docker >/dev/null 2>&1 || return 0
    local drv
    drv=$(docker info --format '{{.Driver}}' 2>/dev/null) || return 0
    [ -n "${drv}" ] || return 0
    perf_section "Docker storage driver" \
        "overlay2 (or the containerd overlayfs snapshotter): multi-GB inference images unpack and start without full copies" \
        "https://docs.docker.com/engine/storage/drivers/select-storage-driver/, https://docs.docker.com/engine/deprecated/"
    case "${drv}" in
        vfs|devicemapper)
            perf_flag warn "storage driver ${drv}" "docker info --format '{{.Driver}}'" \
                "Docker documents vfs as poor performance and not for production (it copies every layer), and devicemapper as removed in Docker Engine 25.0 (deprecated since 18.09)" \
                "set \"storage-driver\": \"overlay2\" in /etc/docker/daemon.json, then sudo systemctl restart docker (images stored under ${drv} are not visible to overlay2)" \
                "set \"storage-driver\": \"${drv}\" back in /etc/docker/daemon.json, then sudo systemctl restart docker" ;;
        *) perf_ok "storage driver ${drv}" "docker info --format '{{.Driver}}'" ;;
    esac
}

doctor_perf() {
    perf_cpu
    perf_cstates
    perf_thermal
    perf_rapl
    perf_memory
    perf_dram
    perf_ksm
    perf_irqbalance
    perf_pcie
    perf_igpu
    perf_nvidia
    perf_isolation
    perf_docker
    echo ""
    info "${PERF_SUGGESTIONS} suggestion(s). Read-only: nothing on this host was changed."
}

cmd_doctor() {
    local perf=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --perf) perf=1 ;;
            --model-gb) [ $# -ge 2 ] || err "--model-gb needs a size in GiB"; PERF_MODEL_GB=$2; shift ;;
            --model-gb=*) PERF_MODEL_GB=${1#*=} ;;
            *) err "unknown doctor option: $1 (use --perf [--model-gb N])" ;;
        esac
        shift
    done
    if [ -n "${PERF_MODEL_GB}" ] && ! [[ "${PERF_MODEL_GB}" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
        err "--model-gb must be a number of GiB, got '${PERF_MODEL_GB}'"
    fi
    if [ "${perf}" -eq 1 ]; then doctor_perf; else doctor; fi
}

cmd_up() {
    require docker
    require k3d
    require kubectl

    resolve_vendors
    [ "${#ACTIVE[@]}" -gt 0 ] || err "no supported accelerator detected (NVIDIA, Intel GPU/NPU/Gaudi, Xeon DSA/IAA/QAT/AMX, hybrid P/E cores) — run 'k3d-gpu doctor' or set K3D_GPU_VENDORS"
    info "Accelerators: ${ACTIVE[*]}"

    local create_args=(
        --image="${IMAGE}"
        --no-lb
        --k3s-arg="--disable=traefik@server:0"
    )
    # NVIDIA: --gpus=all hands the host GPUs to the node container, and
    # --default-runtime=nvidia flips the node's embedded containerd default from
    # runc to the auto-detected nvidia runtime so every pod gets the driver
    # libraries. Without it the device plugin runs under runc, NVML can't load, and
    # the cluster advertises zero GPUs. Both are NVIDIA-only: --gpus fails on a
    # host with no NVIDIA docker runtime, so they are added only when NVIDIA is active.
    if is_active nvidia; then
        create_args+=(--gpus=all --k3s-arg="--default-runtime=nvidia@server:0")
    else
        # Keeps the baked NVIDIA plugin off the node; it cannot start without NVML.
        create_args+=(--k3s-node-label="nvidia.com/gpu.present=false@server:*;agent:*")
    fi
    # Intel (/dev/dri) and Gaudi (/dev/accel): k3d node containers run privileged,
    # so the host /dev tree (including these nodes) is visible with no extra flag.
    # Their device plugins are baked into the image and hand the nodes to pods.
    # Devices that appear after the node container is created need a cluster
    # recreate to show up.
    # The Gaudi and NPU plugins mount /dev/accel and /sys/class/accel, which are
    # absent on hosts without an accel driver, so they only schedule onto nodes
    # carrying their label. The NPU label is upstream's NFD label.
    if is_active gaudi; then
        create_args+=(--k3s-node-label="habana.ai/gaudi.present=true@server:*;agent:*")
    fi
    if is_active npu; then
        create_args+=(--k3s-node-label="intel.feature.node.kubernetes.io/npu=true@server:*;agent:*")
    fi
    # DSA/IAA/QAT plugins are gated by upstream's NFD labels the same way.
    local v label
    for v in dsa iaa qat; do
        if is_active "${v}"; then
            create_args+=(--k3s-node-label="intel.feature.node.kubernetes.io/${v}=true@server:*;agent:*")
        fi
    done
    # The DSA/IAA plugins only accept a work queue whose /dev/char/<major>:<minor>
    # udev symlink exists. A privileged container gets the device nodes but no
    # /dev/char, so share the host's (its links are relative and resolve to the
    # node's own /dev/dsa and /dev/iax).
    if { is_active dsa || is_active iaa; } && [ -d "${SYSROOT}/dev/char" ]; then
        create_args+=(--volume="/dev/char:/dev/char:ro@server:*;agent:*")
    fi
    # Hybrid P/E cores: the baked NRI balloons policy is gated by this label. NRI is
    # on in k3s's containerd for a privileged (non-userns) node, and the node sees
    # the host's cpu_core/cpu_atom PMUs, so balloons can pin by core type. Only the
    # node's own cgroup cpusets change; nothing host-wide (cpufreq, RDT) is touched.
    if is_active hybrid; then
        create_args+=(--k3s-node-label="${HYBRID_LABEL}@server:*;agent:*")
    fi
    # NUMA (multi-socket, SNC, HBM/CXL memory nodes): the same balloons policy also
    # schedules on nodes labelled k3d-gpu.io/numa-nodes, and its replica balloon
    # type keeps a pod's CPUs and memory inside one NUMA node, near its devices.
    if is_active numa; then
        while read -r label; do
            [ -n "${label}" ] && create_args+=(--k3s-node-label="${label}@server:*;agent:*")
        done < <(numa_labels)
    fi
    # AMX is a CPU feature: no plugin, just NFD-style labels pods can select on.
    if is_active amx; then
        while read -r label; do
            [ -n "${label}" ] && create_args+=(--k3s-node-label="${label}@server:*;agent:*")
        done < <(amx_labels)
    fi
    # Facts pods can select on: Intel GPU XMX and media engines, the NPU
    # generation, and the CPU's other ISA extensions under NFD's names.
    while read -r label; do
        [ -n "${label}" ] && create_args+=(--k3s-node-label="${label}@server:*;agent:*")
    done < <(if is_active intel; then intel_gpu_labels; fi
             if is_active npu; then npu_labels; fi
             cpu_isa_labels)
    if is_active intel && ! compgen -G "${SYSROOT}/dev/dri/renderD*" >/dev/null; then
        warn "no /dev/dri/renderD* on host — Intel GPU will not be visible in the node"
    fi
    if { is_active gaudi || is_active npu; } && ! compgen -G "${SYSROOT}/dev/accel/accel[0-9]*" >/dev/null; then
        warn "no /dev/accel/accel* on host — Gaudi/NPU will not be visible in the node"
    fi

    info "Creating k3d cluster '${CLUSTER}' with image ${IMAGE}..."
    k3d cluster create "${CLUSTER}" "${create_args[@]}"

    info "Waiting for nodes Ready..."
    kubectl wait --for=condition=Ready nodes --all --timeout=120s

    # The cryptoandcoffee/k3d-gpu image bakes every device plugin into k3s's
    # auto-deploy dir, so k3s applies them on startup — no action needed here. Give
    # each addon a moment to appear; only apply it ourselves if a custom image
    # (K3D_GPU_IMAGE) didn't ship it.
    local ns ds manifest
    for v in "${ACTIVE[@]}"; do
        read -r ns ds manifest <<< "$(vendor_daemonset "${v}")"
        [ -n "${ds}" ] || continue
        ensure_plugin "${v}" "${ns}" "${ds}" "${manifest}"
    done

    verify_gpus
}

ensure_plugin() {
    local vendor=$1 ns=$2 ds=$3 manifest=$4
    local baked=0 dl=$((SECONDS + 20))
    while [ "${SECONDS}" -lt "${dl}" ]; do
        kubectl -n "${ns}" get daemonset "${ds}" >/dev/null 2>&1 && { baked=1; break; }
        sleep 2
    done
    if [ "${baked}" -eq 1 ]; then
        info "${vendor} device plugin auto-deployed by k3s."
    elif [ -f "${manifest}" ]; then
        info "Applying ${vendor} device plugin (${manifest})..."
        # A manifest that ships its own CRD (nri-balloons) fails on its custom
        # objects until the CRD is established; wait for it, then apply again.
        if ! kubectl apply -f "${manifest}"; then
            kubectl wait --for=condition=Established crd --all --timeout=60s
            kubectl apply -f "${manifest}"
        fi
    elif [ "${vendor}" = "nvidia" ]; then
        warn "${manifest} missing — applying upstream from GitHub"
        kubectl apply -f https://raw.githubusercontent.com/NVIDIA/k8s-device-plugin/main/deployments/static/nvidia-device-plugin.yml
    else
        err "${vendor} device plugin missing from image and ${manifest} not found"
    fi
}

# "<resource> <count>" per extended resource matching a name, or a prefix when
# the name ends in *, summed across all nodes' allocatable. Zero counts dropped.
resource_counts() {
    { kubectl get nodes -o go-template='{{range .items}}{{range $k, $v := .status.allocatable}}{{$k}} {{$v}}{{"\n"}}{{end}}{{end}}' 2>/dev/null || true; } \
        | awk -v want="$1" '
            (want ~ /\*$/ && index($1, substr(want, 1, length(want) - 1)) == 1) || $1 == want { s[$1] += $2 }
            END { for (k in s) if (s[k] > 0) print k, s[k] }' | sort
}

resource_total() { resource_counts "$1" | awk '{s += $2} END {print s + 0}'; }

# Schedulable units for a vendor: summed resources, or for AMX, hybrid and numa
# the number of distinct nodes carrying any of their labels (a node with
# AMXBF16, AMXINT8 and AMXTILE counts once).
vendor_total() {
    local res total=0 nodes=""
    while read -r res; do
        [ -n "${res}" ] || continue
        if [[ " amx hybrid numa " == *" $1 "* ]]; then
            nodes+=$({ kubectl get nodes -l "${res}" -o name 2>/dev/null || true; })$'\n'
        else
            total=$((total + $(resource_total "${res}")))
        fi
    done < <(vendor_resources "$1")
    if [[ " amx hybrid numa " == *" $1 "* ]]; then
        total=$(printf '%s' "${nodes}" | awk 'NF && !seen[$0]++ { n++ } END { print n + 0 }')
    fi
    echo "${total}"
}

# Assert the cluster actually exposes every detected accelerator to the
# scheduler. A "Done" message is worthless if the resource count is 0 — the most
# common failure mode is a cluster that comes up healthy but advertises nothing.
verify_gpus() {
    info "Verifying accelerators are schedulable..."
    local v ns ds manifest total deadline summary="" failed=""
    for v in "${ACTIVE[@]}"; do
        read -r ns ds manifest <<< "$(vendor_daemonset "${v}")"
        if [ -n "${ds}" ]; then
            kubectl -n "${ns}" rollout status "daemonset/${ds}" --timeout=120s \
                || warn "${v} device plugin rollout did not finish cleanly"
        fi

        total=0
        deadline=$((SECONDS + 90))
        while [ "${SECONDS}" -lt "${deadline}" ]; do
            total=$(vendor_total "${v}")
            [ "${total}" -gt 0 ] && break
            sleep 3
        done

        if [ "${total}" -gt 0 ]; then
            summary+=" ${v}=${total}"
        else
            failed+=" ${v}"
            warn "cluster advertises 0 ${v} devices ($(vendor_resources "${v}" | tr '\n' ' '))
       Inspect: ${ds:+kubectl -n ${ns} logs ds/${ds}  — then run }'k3d-gpu doctor'."
        fi
    done
    # An explicit K3D_GPU_VENDORS request must fully succeed. In auto mode one
    # working accelerator is enough (e.g. a spare iGPU that never registers).
    if [ -n "${failed}" ] && { [ "${VENDORS_REQUEST}" != "auto" ] || [ -z "${summary}" ]; }; then
        err "accelerator(s) not schedulable:${failed}"
    fi
    info "Accelerators schedulable:${summary}. Try: k3d-gpu test"
}

cmd_down() {
    require k3d
    info "Deleting k3d cluster '${CLUSTER}'..."
    k3d cluster delete "${CLUSTER}"
}

# Run a one-shot pod requesting one device of the given resource and listing the
# device nodes the plugin injected.
# Run a one-shot pod to completion, print its logs, and succeed only if it did.
# Not `kubectl run --rm -i`: a pod that exits before the attach lands (nvidia-smi
# does) loses its output, so the test passed while showing nothing.
run_pod() {
    local name=$1 image=$2 overrides=$3 phase="" out deadline=$((SECONDS + 300))
    kubectl delete pod "${name}" --ignore-not-found >/dev/null 2>&1 || true
    kubectl run "${name}" --restart=Never --image="${image}" --overrides="${overrides}" >/dev/null || return 1
    while [ "${SECONDS}" -lt "${deadline}" ]; do
        phase=$(kubectl get pod "${name}" -o jsonpath='{.status.phase}' 2>/dev/null || true)
        case "${phase}" in Succeeded|Failed) break ;; esac
        sleep 2
    done
    # $( ) + printf: pod output without a final newline would glue onto the next line.
    out=$(kubectl logs "${name}" 2>&1 || true)
    [ -z "${out}" ] || printf '%s\n' "${out}"
    case "${phase}" in
        Succeeded|Failed) ;;
        *) warn "pod ${name} still ${phase:-not found} after 300s: kubectl describe pod ${name}" ;;
    esac
    kubectl delete pod "${name}" --wait=false >/dev/null 2>&1 || true
    [ "${phase}" = Succeeded ]
}

device_test() {
    local name=$1 resource=$2 path=$3
    info "Deploying ${name} test pod (${DEVICE_TEST_IMAGE}, ${resource})..."
    run_pod "${name}" "${DEVICE_TEST_IMAGE}" \
        "{\"spec\":{\"containers\":[{\"name\":\"${name}\",\"image\":\"${DEVICE_TEST_IMAGE}\",\"resources\":{\"limits\":{\"${resource}\":1}},\"command\":[\"ls\",\"-l\",\"${path}\"]}]}}" \
        || err "${name} test pod failed — run 'k3d-gpu doctor'"
}

# Image refs are pasted into the pod overrides JSON, so only accept reference characters.
valid_image() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._/:@+-]*$ ]]; }

cmd_test() {
    valid_image "${TEST_IMAGE}" || err "K3D_GPU_TEST_IMAGE '${TEST_IMAGE}' is not a valid image reference"
    valid_image "${DEVICE_TEST_IMAGE}" || err "K3D_GPU_DEVICE_TEST_IMAGE '${DEVICE_TEST_IMAGE}' is not a valid image reference"
    require kubectl
    resolve_vendors
    [ "${#ACTIVE[@]}" -gt 0 ] || err "no supported accelerator detected — run 'k3d-gpu doctor'"
    local res v path out got
    if is_active nvidia; then
        info "Deploying nvidia-smi test pod (${TEST_IMAGE})..."
        # The container command + GPU resource limit live entirely in the overrides;
        # --image is still required by `kubectl run` but the overrides spec wins.
        run_pod nvidia-smi-test "${TEST_IMAGE}" \
            "{\"spec\":{\"runtimeClassName\":\"nvidia\",\"containers\":[{\"name\":\"nvidia-smi-test\",\"image\":\"${TEST_IMAGE}\",\"resources\":{\"limits\":{\"nvidia.com/gpu\":1}},\"command\":[\"nvidia-smi\"]}]}}" \
            || err "Test pod failed — run 'k3d-gpu doctor'"
    fi
    if is_active intel; then
        while read -r res; do
            [ "$(resource_total "${res}")" -gt 0 ] || continue
            device_test "intel-gpu-test" "${res}" /dev/dri
        done < <(vendor_resources intel)
    fi
    if is_active npu; then
        device_test "npu-test" "npu.intel.com/accel" /dev/accel
    fi
    if is_active gaudi; then
        device_test "gaudi-test" "habana.ai/gaudi" /dev/accel
    fi
    local kind
    for kind in "dsa /dev/dsa" "iaa /dev/iax" "qat /dev/vfio"; do
        read -r v path <<< "${kind}"
        is_active "${v}" || continue
        res=$(resource_counts "$(vendor_resources "${v}")" | awk 'NR == 1 {print $1}')
        [ -n "${res}" ] || err "cluster advertises no ${v} resources — run 'k3d-gpu doctor'"
        device_test "${v}-test" "${res}" "${path}"
    done
    if is_active amx; then
        res=$(amx_labels | sed -n 1p)  # not head: early exit SIGPIPEs amx_labels under pipefail
        info "Deploying AMX test pod (${DEVICE_TEST_IMAGE}, nodeSelector ${res})..."
        run_pod amx-test "${DEVICE_TEST_IMAGE}" \
            "{\"spec\":{\"nodeSelector\":{\"${res%=*}\":\"true\"},\"containers\":[{\"name\":\"amx-test\",\"image\":\"${DEVICE_TEST_IMAGE}\",\"command\":[\"grep\",\"-m1\",\"-o\",\"amx_tile\",\"/proc/cpuinfo\"]}]}}" \
            || err "AMX test pod failed — run 'k3d-gpu doctor'"
    fi
    if is_active hybrid; then
        for kind in "performance core" "efficient atom"; do
            read -r v path <<< "${kind}"
            info "Deploying ${v}-core test pod (${DEVICE_TEST_IMAGE}; host ${v} CPUs: $(hybrid_cpus "${path}"))..."
            out=$(run_pod "cores-${v}-test" "${DEVICE_TEST_IMAGE}" \
                "{\"metadata\":{\"labels\":{\"k3d-gpu.io/cores\":\"${v}\"}},\"spec\":{\"containers\":[{\"name\":\"cores-${v}-test\",\"image\":\"${DEVICE_TEST_IMAGE}\",\"resources\":{\"requests\":{\"cpu\":\"1\"},\"limits\":{\"cpu\":\"1\"}},\"command\":[\"grep\",\"Cpus_allowed_list\",\"/proc/self/status\"]}]}}") \
                || { printf '%s\n' "${out}"; err "${v}-core test pod failed — run 'k3d-gpu doctor'"; }
            printf '%s\n' "${out}"
            # The grep alone passes with NRI off; the CPU list must sit inside the core type.
            got=$(sed -n 's/^Cpus_allowed_list:[[:space:]]*//p' <<< "${out}")
            cpulist_within "${got}" "$(hybrid_cpus "${path}")" \
                || err "${v}-core test pod ran on CPUs '${got}', not on the ${v} CPUs $(hybrid_cpus "${path}") — check: kubectl -n kube-system logs ds/nri-resource-policy-balloons"
        done
    fi
}

# One line per active accelerator: "<vendor> <resource> [<resource>...]".
cmd_detect() {
    resolve_vendors
    local v
    for v in ${ACTIVE[@]+"${ACTIVE[@]}"}; do
        echo "${v} $(vendor_resources "${v}" | paste -sd' ')"
    done
}

cmd_logs() {
    require docker
    docker logs -f "k3d-${CLUSTER}-server-0"
}

# ---- host setup -----------------------------------------------------------------
# `host-setup` checks the host userspace each detected accelerator needs, then
# prints the commands that install it (Intel compute runtime, Level Zero, media
# driver, NPU driver + firmware; NVIDIA container toolkit + CDI spec). --apply
# runs them after a y/N prompt. Kernel boot options are printed, never applied.
#
# Pins, taken from each upstream release page:
#   intel/compute-runtime 26.35.39758.10 with intel-graphics-compiler v2.41.5
#   oneapi-src/level-zero v1.34.0 (libze1, the Ubuntu 24.04 build; also used on 26.04)
#   intel/linux-npu-driver v1.38.0 (UMD, NPU compiler, intel-fw-npu firmware)
#   ppa:kobuk-team/intel-graphics media driver 26.3.2, libva 2.24.1, gmmlib 22.10.1
#     (Intel publishes no media-driver .debs; this is Intel's Ubuntu package source)
#   nvidia-container-toolkit 1.20.1-1 (NVIDIA's apt and dnf repos)
# Ubuntu archive tools (vainfo, clinfo, libtbb12) come from the release itself.
# Arch, Manjaro and Fedora install their own repo builds: those repos serve only
# the current build, so an exact version cannot be requested there. Arch and
# Manjaro always install with -Syu, because a partial upgrade is what leaves the
# media driver ahead of libva or the compute runtime ahead of libstdc++.
HS_CR=26.35.39758.10
HS_NPU_REL=v1.38.0
HS_NPU_BUILD=1.38.0.20260910-34487311128
HS_NVCTK=1.20.1-1
HS_DIR="${K3D_GPU_SETUP_DIR:-${XDG_CACHE_HOME:-${HOME:-}/.cache}/k3d-gpu/host-setup}"
HS_LIBDIRS="usr/lib/x86_64-linux-gnu usr/lib64 usr/lib"

# "<file> <sha256> <download dir>" per Intel GPU compute .deb. The sha256s are
# the ones the compute-runtime and IGC release notes publish.
hs_intel_debs() {
    local cr="https://github.com/intel/compute-runtime/releases/download/${HS_CR}"
    local igc="https://github.com/intel/intel-graphics-compiler/releases/download/v2.41.5"
    cat <<EOF
intel-igc-core-2_2.41.5+22716_amd64.deb 0a6e64a663ae65a0fa02d6912ae3b6b37cf85b90c21cc423fd9fef70aaf4f628 ${igc}
intel-igc-opencl-2_2.41.5+22716_amd64.deb 779e1b9e88098eb25711e9a8f67c2752665bad22f134aa40ed5649f6e1b87058 ${igc}
intel-opencl-icd_${HS_CR}-0_amd64.deb 61712caaddeba3d38e4f79e2a0fb23fea25596ca2d72c3144c6eea2331ec4301 ${cr}
libze-intel-gpu1_${HS_CR}-0_amd64.deb c19a641b953d55aebbf1d51bec364a84bf629f985e02fbbe6dc70224c0e88470 ${cr}
EOF
}
HS_ZE_DEB="libze1_1.34.0+u24.04_amd64.deb 45210e4549cd965ad7b9f160eefe53cbcdba01af341bea7ac7ba0aedeeb613ba https://github.com/oneapi-src/level-zero/releases/download/v1.34.0"

# NPU driver archive per Ubuntu release: "<file> <sha256>" (GitHub asset digests).
hs_npu_tarball() {
    case "$1" in
        24.04) echo "linux-npu-driver-v${HS_NPU_BUILD}-ubuntu2404.tar.gz 1efcd4b60c22abee751d8f2705962cbcc2a569de45c7e0e670cf08afbfcdc1d2" ;;
        26.04) echo "linux-npu-driver-v${HS_NPU_BUILD}-ubuntu2604.tar.gz 83685e6d92f4db1ca65e442846d487c7feb1335634b33994292ceb38f933bcc7" ;;
    esac
}

# ubuntu-24.04 | ubuntu-26.04 | fedora | arch | manjaro, or the raw os-release ID.
hs_distro() {
    local f="${SYSROOT}/etc/os-release" id ver
    [ -r "${f}" ] || f="${SYSROOT}/usr/lib/os-release"
    id=$(sed -n 's/^ID=//p' "${f}" 2>/dev/null | tr -d '"')
    ver=$(sed -n 's/^VERSION_ID=//p' "${f}" 2>/dev/null | tr -d '"')
    case "${id}" in
        ubuntu) echo "ubuntu-${ver}" ;;
        *) echo "${id:-unknown}" ;;
    esac
}

# First file matching <glob> under the library dirs (highest version wins).
hs_find() {
    local d hit
    for d in ${HS_LIBDIRS}; do
        hit=$({ compgen -G "${SYSROOT}/${d}/$1" || true; } | sort -V | tail -1)
        [ -n "${hit}" ] && { echo "${hit}"; return 0; }
    done
    return 1
}

# Highest GLIBCXX_3.4.N symbol version named in a binary (empty when none).
glibcxx_max() { { grep -ao 'GLIBCXX_3\.4\.[0-9]*' "$1" 2>/dev/null || true; } | sort -uV | tail -1; }

# Fills HS_TARGETS (intel npu nvidia) from PCI devices, bound or not, so it works
# before any driver is set up. K3D_GPU_VENDORS narrows or forces the list.
hs_targets() {
    HS_TARGETS=() HS_NPU_GENS=() HS_INTEL_GPUS=() HS_RENDER=""
    local dev vendor class id gen v req
    for dev in "${SYSROOT}"/sys/bus/pci/devices/*; do
        vendor=$(cat "${dev}/vendor" 2>/dev/null) || continue
        class=$(cat "${dev}/class" 2>/dev/null) || continue
        id=$(cat "${dev}/device" 2>/dev/null) || continue
        case "${vendor}:${class}" in
            0x8086:0x03*) HS_INTEL_GPUS+=("${id} $(bound_driver "${dev}")") ;;
            0x10de:0x03*) is_hs_target nvidia || HS_TARGETS+=(nvidia) ;;
        esac
        if [ "${vendor}" = 0x8086 ] && [ -n "$(npu_platform "${id}")" ]; then
            IFS='|' read -r _ _ gen <<< "$(npu_platform "${id}")"
            HS_NPU_GENS+=("${gen}")
        fi
    done
    if [ "${#HS_INTEL_GPUS[@]}" -gt 0 ]; then HS_TARGETS+=(intel); fi
    if [ "${#HS_NPU_GENS[@]}" -gt 0 ]; then HS_TARGETS+=(npu); fi
    if has_nvidia && ! is_hs_target nvidia; then HS_TARGETS+=(nvidia); fi
    for dev in "${SYSROOT}"/sys/class/drm/renderD*; do
        [ "$(cat "${dev}/device/vendor" 2>/dev/null)" = 0x8086 ] || continue
        HS_RENDER="/dev/dri/${dev##*/}"
        break
    done
    if [ "${VENDORS_REQUEST}" != "auto" ]; then
        HS_TARGETS=()
        IFS=',' read -r -a req <<< "${VENDORS_REQUEST// /}"
        for v in "${req[@]}"; do
            case "${v}" in intel|npu|nvidia) is_hs_target "${v}" || HS_TARGETS+=("${v}") ;; esac
        done
    fi
    return 0
}

is_hs_target() {
    local v
    for v in ${HS_TARGETS[@]+"${HS_TARGETS[@]}"}; do [ "${v}" = "$1" ] && return 0; done
    return 1
}

hs_ok()   { echo "  ok: $*"; }
hs_warn() { echo "  ${YLW}warn${RST}: $*"; HS_MISSING=$((HS_MISSING + 1)); }
hs_fail() { echo "  ${RED}fail${RST}: $*"; HS_BROKEN=$((HS_BROKEN + 1)); }

# The one command that brings every package back in step on this distro.
hs_sync_fix() {
    case "${HS_DISTRO}" in
        arch|manjaro) echo "sudo pacman -Syu (a full upgrade; never pacman -Sy <pkg> alone)" ;;
        fedora)       echo "sudo dnf upgrade --refresh" ;;
        ubuntu-*)     echo "sudo apt-get update && sudo apt-get full-upgrade" ;;
        *)            echo "upgrade the whole system with your package manager" ;;
    esac
}

# libva only loads a driver exporting __vaDriverInit_1_<N> with N at most its own
# minor version (libva 2.N implements VA-API 1.N). A driver built against a newer
# libva fails with "has no function __vaDriverInit_1_0": the last name it tried.
hs_check_va() {
    local drv lib dmin="" lmin="" fix out line
    if ! drv=$(hs_find dri/iHD_drv_video.so); then
        hs_warn "intel-media-driver (iHD_drv_video.so) not installed — the plan below installs it"
        return 0
    fi
    dmin=$({ grep -ao '__vaDriverInit_1_[0-9]*' "${drv}" 2>/dev/null || true; } | sed 's/.*_//' | sort -n | tail -1)
    if lib=$(hs_find 'libva.so.2.*'); then
        lmin=${lib##*/libva.so.2.}
        lmin=${lmin%%.*}
        lmin=$((10#${lmin} / 100))
    fi
    case "${HS_DISTRO}" in
        ubuntu-*) fix="sudo add-apt-repository -y ppa:kobuk-team/intel-graphics && sudo apt-get install -y $(hs_libva_pkgs "${HS_DISTRO#ubuntu-}")" ;;
        *) fix=$(hs_sync_fix) ;;
    esac
    if [ -z "${lib}" ]; then
        hs_fail "libva.so.2 not found — install libva (the plan below does)"
    elif [ -n "${dmin}" ] && [ "${dmin}" -gt "${lmin}" ]; then
        hs_fail "${drv#"${SYSROOT}"} exports __vaDriverInit_1_${dmin} (built for libva 2.${dmin}) but libva is 2.${lmin} — vainfo fails with 'has no function __vaDriverInit_1_0'. Fix: ${fix}"
    elif [ -n "${dmin}" ]; then
        hs_ok "media driver exports __vaDriverInit_1_${dmin}, libva is 2.${lmin}"
    fi
    command -v vainfo >/dev/null 2>&1 || { hs_warn "vainfo not installed — cannot run the media driver (the plan below installs it)"; return 0; }
    out=$(timeout 30 vainfo --display drm --device "${HS_RENDER:-/dev/dri/renderD128}" 2>&1 || true)
    if line=$(grep -m1 'has no function __vaDriverInit' <<< "${out}"); then
        hs_fail "vainfo: ${line#libva error: } — the media driver is newer than libva. Fix: ${fix}"
    elif line=$(grep -m1 'dlopen of .* failed' <<< "${out}"); then
        if grep -q "GLIBCXX_" <<< "${line}"; then
            hs_fail "vainfo: ${line#libva error: } — libstdc++ is older than the media driver needs. Fix: $(hs_sync_fix)"
        else
            hs_fail "vainfo: ${line#libva error: }"
        fi
    elif line=$(grep -m1 'Driver version:' <<< "${out}"); then
        hs_ok "vainfo: ${line#*Driver version: }"
    else
        hs_fail "vainfo did not initialise the driver: $(tail -n1 <<< "${out}")"
    fi
}

# A runtime built by a newer GCC than the installed libstdc++ fails to load with
# "version `GLIBCXX_3.4.N' not found"; the OpenCL ICD loader then hides the
# platform silently, so compare the symbol versions directly.
hs_check_cxx() {
    local cxx have need lib name bad=0
    cxx=$(hs_find libstdc++.so.6) || return 0
    have=$(glibcxx_max "${cxx}")
    [ -n "${have}" ] || return 0
    for name in intel-opencl/libigdrcl.so libze_intel_gpu.so.1 libze_intel_npu.so.1 dri/iHD_drv_video.so; do
        lib=$(hs_find "${name}") || continue
        need=$(glibcxx_max "${lib}")
        [ -n "${need}" ] || continue
        if [ "${need##*.}" -gt "${have##*.}" ]; then
            hs_fail "${lib#"${SYSROOT}"} needs ${need} but libstdc++ provides up to ${have} — it was built by a newer GCC than the installed gcc-libs/libstdc++. Fix: $(hs_sync_fix)"
            bad=1
        fi
    done
    [ "${bad}" -eq 1 ] || hs_ok "libstdc++ provides ${have}, enough for the installed Intel runtimes"
}

hs_check_opencl() {
    local out icd line
    command -v clinfo >/dev/null 2>&1 || { hs_warn "clinfo not installed — cannot list OpenCL platforms (the plan below installs it)"; return 0; }
    out=$(timeout 60 clinfo -l 2>&1 || true)
    if line=$(grep -m1 -E 'Intel\(R\) OpenCL.*Graphics' <<< "${out}"); then
        hs_ok "clinfo: ${line#*: }"
        return 0
    fi
    icd=$(head -n1 "${SYSROOT}/etc/OpenCL/vendors/intel.icd" 2>/dev/null || true)
    if [ -z "${icd}" ]; then
        hs_fail "clinfo lists no Intel OpenCL platform and /etc/OpenCL/vendors/intel.icd is missing — the compute runtime is not installed (the plan below installs it)"
        return 0
    fi
    hs_fail "clinfo lists no Intel OpenCL platform although ${icd} is registered"
    while read -r line; do
        [ -n "${line}" ] && echo "         ldd ${icd}: ${line}"
    done < <({ ldd "${icd}" 2>&1 || true; } | grep 'not found')
    echo "         Fix: $(hs_sync_fix); then rerun k3d-gpu host-setup"
}

hs_checks() {
    local lz e id drv name mink fw gen
    if is_hs_target intel || is_hs_target npu; then
        info "Checking Intel userspace..."
        hs_check_cxx
        if lz=$(hs_find libze_loader.so.1); then hs_ok "Level Zero loader: ${lz##*/}"; else hs_warn "Level Zero loader (libze_loader.so.1) not installed"; fi
    fi
    if is_hs_target intel; then
        if hs_find libze_intel_gpu.so.1 >/dev/null; then hs_ok "Level Zero GPU driver (libze_intel_gpu.so.1) installed"; else hs_warn "Level Zero GPU driver (libze_intel_gpu.so.1) not installed"; fi
        hs_check_opencl
        hs_check_va
    fi
    if is_hs_target npu; then
        info "Checking Intel NPU userspace..."
        if hs_find libze_intel_npu.so.1 >/dev/null; then hs_ok "NPU Level Zero driver (libze_intel_npu.so.1) installed"; else hs_warn "NPU Level Zero driver (libze_intel_npu.so.1) not installed"; fi
        for gen in $(printf '%s\n' ${HS_NPU_GENS[@]+"${HS_NPU_GENS[@]}"} | sort -u); do
            if firmware_present "intel/vpu/vpu_${gen}_"; then hs_ok "intel/vpu/vpu_${gen}_* firmware present"; else hs_warn "intel/vpu/vpu_${gen}_* firmware missing"; fi
        done
    fi
    if is_hs_target nvidia; then
        info "Checking NVIDIA container toolkit..."
        if command -v nvidia-ctk >/dev/null 2>&1; then hs_ok "nvidia-ctk installed"; else hs_warn "nvidia-ctk not installed"; fi
        if [ -e "${SYSROOT}/etc/cdi/nvidia.yaml" ] || [ -e "${SYSROOT}/var/run/cdi/nvidia.yaml" ]; then
            hs_ok "NVIDIA CDI spec present"
        else
            hs_warn "no NVIDIA CDI spec in /etc/cdi or /var/run/cdi"
        fi
    fi
    # Kernel side: parts newer than the kernel's default xe support.
    local notes=""
    for e in ${HS_INTEL_GPUS[@]+"${HS_INTEL_GPUS[@]}"}; do
        is_hs_target intel || break
        read -r id drv <<< "${e}"
        IFS='|' read -r name mink fw <<< "$(intel_gpu_platform "${id}")"
        [ -n "${name}" ] || continue
        if [ -n "${mink}" ] && [ -z "${drv}" ] && kernel_lt "${mink}" && [ "${fw#i915/}" != "${fw}" ]; then
            # i915 is the default driver for this part; xe does not support it on these kernels.
            notes+="  ${YLW}kernel${RST}: Intel ${name} (${id}) needs the boot option i915.force_probe=${id#0x} (or kernel ${mink}+)"$'\n'
        elif [ -z "${mink}" ] || { [ -z "${drv}" ] && kernel_lt "${mink}"; }; then
            notes+="  ${YLW}kernel${RST}: Intel ${name} (${id}) needs the boot options xe.force_probe=${id#0x} i915.force_probe=!${id#0x}${mink:+ (or kernel ${mink}+)}"$'\n'
        elif kernel_lt "${mink}"; then
            notes+="  ${YLW}kernel${RST}: Intel ${name} (${id}) is supported by default from kernel ${mink} (running $(kernel_release))"$'\n'
        fi
    done
    if [ -n "${notes}" ]; then
        info "Kernel (printed only; --apply never changes boot options)..."
        printf '%s' "${notes}"
        case "${HS_DISTRO}" in
            fedora) echo "  add them: sudo grubby --update-kernel=ALL --args='<options>'" ;;
            ubuntu-*) echo "  add them to GRUB_CMDLINE_LINUX_DEFAULT in /etc/default/grub, then: sudo update-grub" ;;
            arch|manjaro) echo "  add them to GRUB_CMDLINE_LINUX_DEFAULT in /etc/default/grub, then: sudo grub-mkconfig -o /boot/grub/grub.cfg (systemd-boot: the options line in /boot/loader/entries/*.conf)" ;;
        esac
    fi
}

hs_add() { HS_PLAN+=("$1"); }

# libva and every libva-* that vainfo depends on, pinned to the PPA build together:
# the release's libva-x11-2/libva-wayland2 depend on libva2 << 2.20.0.1.
hs_libva_pkgs() {
    local p v="2.24.1-1~$1~ppa2" out=""
    for p in libva2 libva-drm2 libva-x11-2 libva-wayland2; do out+=" ${p}=${v}"; done
    echo "${out# }"
}

# The NPU .debs inside the release archive, each as " '<prefix><file>'".
hs_npu_debs() {
    local p
    for p in intel-level-zero-npu intel-driver-compiler-npu intel-fw-npu; do
        printf " '%s'" "$2${p}_${HS_NPU_BUILD}~ubuntu$1_amd64.deb"
    done
}

# Download a pinned file into HS_DIR and check its sha256.
hs_fetch() {
    local file=$1 sum=$2 url=$3
    hs_add "curl -fL --retry 3 -o '${HS_DIR}/${file}' '${url}/${file}'"
    hs_add "echo '${sum}  ${HS_DIR}/${file}' | sha256sum -c -"
}

hs_plan_ubuntu() {
    local rel=$1 debs="" file sum url npu
    hs_add "sudo apt-get update"
    hs_add "sudo apt-get install -y ca-certificates curl gnupg software-properties-common"
    if is_hs_target intel || is_hs_target npu; then
        # A private download dir: the .debs in it are installed as root.
        hs_add "mkdir -p '${HS_DIR}' && [ ! -L '${HS_DIR}' ] && [ -O '${HS_DIR}' ] && chmod 0700 '${HS_DIR}' || { echo 'refusing ${HS_DIR}: not a directory owned by this user' >&2; exit 1; }"
        read -r file sum url <<< "${HS_ZE_DEB}"
        hs_fetch "${file}" "${sum}" "${url}"
        debs+=" '${HS_DIR}/${file}'"
    fi
    if is_hs_target intel; then
        hs_add "sudo add-apt-repository -y ppa:kobuk-team/intel-graphics"
        # The PPA also builds intel-opencl-icd/libze*/libigc*; keep apt on the GitHub .debs.
        hs_add "printf 'Package: intel-opencl-icd libze-intel-gpu1 libze1 libze-dev libze-intel-gpu-dev libigc2 libigc-dev libigc-tools\\nPin: release o=LP-PPA-kobuk-team-intel-graphics\\nPin-Priority: -1\\n' | sudo tee /etc/apt/preferences.d/k3d-gpu-intel-compute >/dev/null"
        hs_add "sudo apt-get install -y intel-media-va-driver-non-free=26.3.2-1~${rel}~ppa1 $(hs_libva_pkgs "${rel}") libigdgmm12=22.10.1-1~${rel}~ppa1 vainfo clinfo ocl-icd-libopencl1"
        while read -r file sum url; do
            hs_fetch "${file}" "${sum}" "${url}"
            debs+=" '${HS_DIR}/${file}'"
        done < <(hs_intel_debs)
    fi
    if is_hs_target npu; then
        read -r file sum <<< "$(hs_npu_tarball "${rel}")"
        hs_fetch "${file}" "${sum}" "https://github.com/intel/linux-npu-driver/releases/download/${HS_NPU_REL}"
        npu="${HS_DIR}/npu-${HS_NPU_REL}"
        hs_add "mkdir -p '${npu}' && tar -xzf '${HS_DIR}/${file}' -C '${npu}'$(hs_npu_debs "${rel}" ./)"
        debs+=" libtbb12$(hs_npu_debs "${rel}" "${npu}/")"
    fi
    [ -z "${debs}" ] || hs_add "sudo apt-get install -y${debs}"
    if is_hs_target nvidia; then
        hs_add "curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey | sudo gpg --batch --yes --dearmor -o /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg"
        hs_add "curl -fsSL https://nvidia.github.io/libnvidia-container/stable/deb/nvidia-container-toolkit.list | sed 's#deb https://#deb [signed-by=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg] https://#g' | sudo tee /etc/apt/sources.list.d/nvidia-container-toolkit.list >/dev/null"
        hs_add "sudo apt-get update"
        hs_add "sudo apt-get install -y nvidia-container-toolkit=${HS_NVCTK} nvidia-container-toolkit-base=${HS_NVCTK} libnvidia-container-tools=${HS_NVCTK} libnvidia-container1=${HS_NVCTK}"
        hs_plan_nvidia_runtime refresh
    fi
}

hs_plan_fedora() {
    local pkgs=""
    is_hs_target intel && pkgs+=" intel-opencl intel-level-zero oneapi-level-zero libva-intel-media-driver libva-utils clinfo intel-gpu-firmware"
    is_hs_target npu && pkgs+=" intel-npu-driver intel-npu-firmware"
    is_hs_target intel || { is_hs_target npu && pkgs+=" oneapi-level-zero"; }
    [ -z "${pkgs}" ] || hs_add "sudo dnf install -y --refresh${pkgs}"
    if is_hs_target nvidia; then
        hs_add "curl -fsSL https://nvidia.github.io/libnvidia-container/stable/rpm/nvidia-container-toolkit.repo | sudo tee /etc/yum.repos.d/nvidia-container-toolkit.repo >/dev/null"
        hs_add "sudo dnf install -y nvidia-container-toolkit-${HS_NVCTK} nvidia-container-toolkit-base-${HS_NVCTK} libnvidia-container-tools-${HS_NVCTK} libnvidia-container1-${HS_NVCTK}"
        hs_plan_nvidia_runtime refresh
    fi
}

hs_plan_arch() {
    local pkgs=""
    is_hs_target intel && pkgs+=" intel-compute-runtime level-zero-loader intel-media-driver libva libva-utils clinfo linux-firmware-intel"
    is_hs_target npu && pkgs+=" intel-npu-driver"
    is_hs_target npu && ! is_hs_target intel && pkgs+=" level-zero-loader linux-firmware-intel"
    is_hs_target nvidia && pkgs+=" nvidia-container-toolkit"
    [ -z "${pkgs}" ] || hs_add "sudo pacman -Syu --needed${pkgs}"
    # Arch's package ships the nvidia-cdi-refresh units from 1.20.1-1; older builds
    # (Manjaro lags) do not, so those get the spec written directly.
    is_hs_target nvidia && hs_plan_nvidia_runtime "${SYSROOT}/usr/lib/systemd/system/nvidia-cdi-refresh.service"
    return 0
}

# CDI spec + Docker runtime registration. NVIDIA's own packages (1.18+) keep
# /var/run/cdi/nvidia.yaml current through nvidia-cdi-refresh. Given a unit file
# path instead of "refresh", the refresh runs when that file exists, else the
# spec is generated.
hs_plan_nvidia_runtime() {
    local refresh="sudo systemctl enable --now nvidia-cdi-refresh.path && sudo systemctl restart nvidia-cdi-refresh.service"
    if [ "$1" = refresh ]; then
        hs_add "${refresh}"
    else
        hs_add "if [ -e '$1' ]; then ${refresh}; else sudo nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml; fi"
    fi
    hs_add "sudo nvidia-ctk runtime configure --runtime=docker"
    hs_add "sudo systemctl restart docker"
}

cmd_host_setup() {
    local apply=0 plan=0 cmd ans
    HS_DISTRO=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --apply) apply=1 ;;
            --plan) plan=1 ;;
            --distro) [ $# -ge 2 ] || err "--distro needs a value"; HS_DISTRO=$2; shift ;;
            --distro=*) HS_DISTRO=${1#--distro=} ;;
            *) err "unknown host-setup option '$1' (use --apply, --plan, --distro ubuntu-24.04|ubuntu-26.04|fedora|arch|manjaro)" ;;
        esac
        shift
    done
    [ -n "${HS_DISTRO}" ] || HS_DISTRO=$(hs_distro)
    case "${HS_DISTRO}" in
        ubuntu-24.04|ubuntu-26.04|fedora|arch|manjaro) ;;
        *) err "host-setup supports Ubuntu 24.04/26.04, Fedora, Arch and Manjaro (this host: ${HS_DISTRO}); pass --distro to print another distro's plan" ;;
    esac

    hs_targets
    if [ "${#HS_TARGETS[@]}" -eq 0 ]; then
        info "No Intel GPU, Intel NPU or NVIDIA GPU found — nothing to set up (K3D_GPU_VENDORS=intel,npu,nvidia forces a plan)"
        return 0
    fi
    info "Host setup for ${HS_DISTRO}: ${HS_TARGETS[*]}"
    HS_BROKEN=0 HS_MISSING=0
    hs_checks

    # A host whose every check passed needs nothing; proposing a full system
    # upgrade and a docker restart there would only risk a working setup.
    if [ "${HS_BROKEN}" -eq 0 ] && [ "${HS_MISSING}" -eq 0 ] && [ "${plan}" -eq 0 ]; then
        echo ""
        info "Every check passed: nothing to install. ('k3d-gpu host-setup --plan' prints the full install plan anyway.)"
        return 0
    fi

    HS_PLAN=()
    case "${HS_DISTRO}" in
        ubuntu-*) hs_plan_ubuntu "${HS_DISTRO#ubuntu-}" ;;
        fedora) hs_plan_fedora ;;
        arch|manjaro) hs_plan_arch ;;
    esac
    echo ""
    info "Install plan (${#HS_PLAN[@]} commands):"
    printf '    %s\n' "${HS_PLAN[@]}"
    if is_hs_target nvidia; then
        echo "  note: the NVIDIA kernel driver itself is not part of this plan; install it from your distro first"
    fi
    if is_hs_target npu; then
        echo "  note: new NPU firmware loads on the next boot (or: sudo modprobe -r intel_vpu && sudo modprobe intel_vpu)"
    fi
    if [ "${HS_DISTRO}" = manjaro ]; then
        echo "  note: Manjaro syncs Arch packages later; install only from Manjaro's own repos, never Arch [extra] or AUR binaries of these"
    fi
    [ "${HS_BROKEN}" -eq 0 ] || warn "${HS_BROKEN} check(s) failed — each line above names its fix"

    if [ "${apply}" -eq 0 ]; then
        echo ""
        info "Dry run: nothing was changed. Run 'k3d-gpu host-setup --apply' to execute the plan."
        return 0
    fi
    printf 'Run these %d commands now? [y/N] ' "${#HS_PLAN[@]}"
    ans=""
    read -r ans || true  # an answer without a trailing newline still counts
    case "${ans}" in
        y|Y|yes|YES) ;;
        *) info "Aborted: nothing was run."; return 0 ;;
    esac
    for cmd in "${HS_PLAN[@]}"; do
        info "+ ${cmd}"
        bash -c "set -euo pipefail; ${cmd}" || err "command failed: ${cmd}"
    done
    info "Host setup done. Check again with: k3d-gpu host-setup && k3d-gpu doctor"
}

case "${1:-help}" in
    up)      cmd_up      ;;
    down)    cmd_down    ;;
    test)    cmd_test    ;;
    detect)  cmd_detect  ;;
    doctor)  shift; cmd_doctor "$@" ;;
    logs)    cmd_logs    ;;
    host-setup) shift; cmd_host_setup "$@" ;;
    version|--version|-v) echo "k3d-gpu ${VERSION}" ;;
    help|--help|-h) usage ;;
    *) usage; exit 1 ;;
esac
