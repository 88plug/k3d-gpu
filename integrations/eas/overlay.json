        "evidence": "https://github.com/intel/enterprise-ai-solutions/blob/97f6157d6a72f7173c698c474d4e51d2c79f1fd6/docs/deploy/topologies.md#L189"
      }
    },
    {
      "id": "0006",
      "what": "envoy_gateway: select control-plane nodes by label presence (k3s stamps \"true\", kubeadm \"\")",
      "variants": [
        {"name": "a", "files": ["0006-eas-envoy-control-plane-affinity.patch"], "for": "main after EAS #42 (roles/envoy_gateway/tasks/controller.yaml)"},
        {"name": "b", "files": ["0006-release-1.2-envoy-control-plane-affinity.patch"], "for": "release-1.2 (roles/envoy_gateway/tasks/install.yaml)"}
      ],
      "needed_when": "always",
      "fixed_probe": [
        {
          "glob": "roles/envoy_gateway/**",
          "regex": "matchExpressions:\\s*-[ \\t]*key:[ \\t]*[\"']?node-role\\.kubernetes\\.io/control-plane[\"']?\\s+operator:[ \\t]*[\"']?Exists",
          "absent": "node-role\\.kubernetes\\.io/control-plane[\"']?[ \\t]*:[ \\t]*(?:\"\"|'')",
          "knob": null,
          "what": "a file of the role selects control-plane nodes with a matchExpressions Exists term, and no file of the role keeps an exact \"\" selector"
        },
        {
          "glob": "roles/envoy_gateway/vars/k3s.yaml",
          "regex": "(?m)^_envoy_gateway_proxy_shape:[ \\t]*(?![\"']?controlplane_daemonset\\b)\\S",
          "knob": null,
          "what": "a k3s entry in the per-distribution vars layout of EAS #50 that selects a shape other than controlplane_daemonset, the one with the exact \"\" selector"
        }
      ],
      "moved": [
        {
          "glob": "roles/envoy_gateway/tasks/controller.yaml",
          "regex": "_eg_k8s_provider:",
          "upstream": "https://github.com/intel/enterprise-ai-solutions/pull/50",
          "what": "the EnvoyProxy provider moved into the _eg_k8s_provider var, still an exact \"\" selector (#52 carries the same change)"
        }
      ],
      "upstream": {
        "filed": false,
        "evidence": "https://github.com/k3s-io/k3s/blob/843c32de489c25ccc1bde53d21c5fd7df23c706e/pkg/server/server.go#L550"
      }
    }
