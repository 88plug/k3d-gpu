  "rows": [
    {
      "id": "0002",
      "what": "istio: pass istio_platform to the Istio chart as global.platform, so istio-cni uses the k3s/k3d CNI paths",
      "variants": [
        {"name": "a", "files": ["0002-eas-istio-global-platform.patch"], "for": "main and release-1.2"}
      ],
      "needed_when": "always",
      "fixed_probe": [
        {
          "glob": "roles/istio/**",
          "regex": "(?m)global\\.platform\\s*=|['\"]platform['\"]\\s*:|global:\\s*\\{\\s*platform\\s*:|^\\s*global:[ \\t]*\\n\\s+platform:",
          "knob": "istio_platform",
          "what": "an Istio task or default sets global.platform from a variable"
        }
      ],
      "moved": [
        {
          "glob": "configs/defaults/global_config.yaml",
          "regex": "(?m)^headlamp_enabled:",
          "upstream": "https://github.com/intel/enterprise-ai-solutions/pull/61",
          "what": "headlamp_enabled now follows velero_enabled, the context of 0002's global_config.yaml hunk"
        }
      ],
      "upstream": {
        "filed": false,
        "evidence": "https://istio.io/latest/docs/ambient/install/platform-prerequisites/"
      }
    },
    {
      "id": "0003",
      "what": "nri_cpu_balloons: pin the nri-plugins balloons chart to v0.15.0",
      "variants": [
        {"name": "a", "files": ["0003-eas-pin-nri-balloons-chart.patch"], "for": "main and release-1.2"}
      ],
      "needed_when": "eas_owns_nri",
      "fixed_probe": [
        {
          "glob": "roles/nri_cpu_balloons/tasks/install_advanced.yaml",
          "regex": "(?m)^\\s*chart_version:",
          "knob": null,
          "what": "the balloons Helm task passes a chart_version"
        }
      ],
      "moved": [],
      "upstream": {
        "filed": false,
        "evidence": "https://github.com/containers/nri-plugins/releases/tag/v0.15.0"
      }
    },
