exit=0
--- calls
k3d cluster create gpu
  --image=cryptoandcoffee/k3d-gpu:<version>
  --no-lb
  --k3s-arg=--disable=traefik@server:0
  --k3s-arg=--disable=intel-gpu-plugin@server:0
  --k3s-arg=--disable=intel-gpu-dra@server:0
  --k3s-node-label=nvidia.com/gpu.present=false@server:*;agent:*
  --k3s-arg=--disable=nri-balloons@server:*
  --k3s-node-label=feature.node.kubernetes.io/cpu-cpuid.AMXBF16=true@server:*;agent:*
  --k3s-node-label=feature.node.kubernetes.io/cpu-cpuid.AMXFP16=true@server:*;agent:*
  --k3s-node-label=feature.node.kubernetes.io/cpu-cpuid.AMXINT8=true@server:*;agent:*
  --k3s-node-label=feature.node.kubernetes.io/cpu-cpuid.AMXTILE=true@server:*;agent:*
  --k3s-node-label=feature.node.kubernetes.io/cpu-cpuid.AVX512BF16=true@server:*;agent:*
  --k3s-node-label=feature.node.kubernetes.io/cpu-cpuid.AVX512F=true@server:*;agent:*
  --k3s-node-label=feature.node.kubernetes.io/cpu-cpuid.AVX512VNNI=true@server:*;agent:*
  --k3s-node-label=feature.node.kubernetes.io/cpu-cpuid.AVXVNNI=true@server:*;agent:*
  --k3s-node-label=feature.node.kubernetes.io/cpu-cpuid.CETIBT=true@server:*;agent:*
  --k3s-node-label=feature.node.kubernetes.io/cpu-cpuid.CETSS=true@server:*;agent:*
  --k3s-node-label=feature.node.kubernetes.io/cpu-cpuid.GFNI=true@server:*;agent:*
  --k3s-node-label=feature.node.kubernetes.io/cpu-cpuid.SHA=true@server:*;agent:*
  --k3s-node-label=feature.node.kubernetes.io/cpu-cpuid.VAES=true@server:*;agent:*
  --k3s-node-label=experimental.k3d-gpu.io/dra=true@server:*;agent:*
  --k3s-node-label=experimental.k3d-gpu.io/image-volume=true@server:*;agent:*
  --kubeconfig-update-default=false
k3d kubeconfig get gpu
  
kubectl --context k3d-gpu wait --for=condition=Ready nodes --all --timeout=120s
kubectl --context k3d-gpu -n kube-system get deployment/coredns
kubectl --context k3d-gpu -n kube-system rollout status deployment/coredns --timeout=180s
kubectl --context k3d-gpu get nodes -l feature.node.kubernetes.io/cpu-cpuid.AMXBF16=true -o name
kubectl --context k3d-gpu get nodes -l feature.node.kubernetes.io/cpu-cpuid.AMXFP16=true -o name
kubectl --context k3d-gpu get nodes -l feature.node.kubernetes.io/cpu-cpuid.AMXINT8=true -o name
kubectl --context k3d-gpu get nodes -l feature.node.kubernetes.io/cpu-cpuid.AMXTILE=true -o name
