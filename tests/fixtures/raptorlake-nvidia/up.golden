==> Accelerators: nvidia intel hybrid
==> Creating k3d cluster 'gpu' with image cryptoandcoffee/k3d-gpu:latest...
==> Waiting for nodes Ready...
==> nvidia device plugin auto-deployed by k3s.
==> intel device plugin auto-deployed by k3s.
==> hybrid device plugin auto-deployed by k3s.
==> Verifying accelerators are schedulable...
==> Accelerators schedulable: nvidia=2 intel=1 hybrid=1. Try: k3d-gpu test
exit=0
--- calls
k3d cluster create gpu
  --image=cryptoandcoffee/k3d-gpu:latest
  --no-lb
  --k3s-arg=--disable=traefik@server:0
  --gpus=all
  --k3s-arg=--default-runtime=nvidia@server:0
  --k3s-node-label=k3d-gpu.io/hybrid-cpu=true@server:*;agent:*
  --k3s-node-label=gpu.intel.com/xmx=false@server:*;agent:*
  --k3s-node-label=gpu.intel.com/media-vcs=2@server:*;agent:*
  --k3s-node-label=gpu.intel.com/media-vecs=1@server:*;agent:*
  --k3s-node-label=feature.node.kubernetes.io/cpu-cpuid.AVXVNNI=true@server:*;agent:*
  --k3s-node-label=feature.node.kubernetes.io/cpu-cpuid.CETIBT=true@server:*;agent:*
  --k3s-node-label=feature.node.kubernetes.io/cpu-cpuid.CETSS=true@server:*;agent:*
  --k3s-node-label=feature.node.kubernetes.io/cpu-cpuid.GFNI=true@server:*;agent:*
  --k3s-node-label=feature.node.kubernetes.io/cpu-cpuid.SHA=true@server:*;agent:*
  --k3s-node-label=feature.node.kubernetes.io/cpu-cpuid.VAES=true@server:*;agent:*
kubectl wait --for=condition=Ready nodes --all --timeout=120s
kubectl -n kube-system get daemonset nvidia-device-plugin-daemonset
kubectl -n kube-system get daemonset intel-gpu-plugin
kubectl -n kube-system get daemonset nri-resource-policy-balloons
kubectl -n kube-system rollout status daemonset/nvidia-device-plugin-daemonset --timeout=120s
kubectl get nodes -o go-template={{range .items}}{{range $k, $v := .status.allocatable}}{{$k}} {{$v}}{{"\n"}}{{end}}{{end}}
kubectl -n kube-system rollout status daemonset/intel-gpu-plugin --timeout=120s
kubectl get nodes -o go-template={{range .items}}{{range $k, $v := .status.allocatable}}{{$k}} {{$v}}{{"\n"}}{{end}}{{end}}
kubectl -n kube-system rollout status daemonset/nri-resource-policy-balloons --timeout=120s
kubectl get nodes -l k3d-gpu.io/hybrid-cpu=true -o name
