{
  "defaults": {
    "namespace": "llm-inference",
    "replicas": 1,
    "require_amx": true,
    "runtime": "vllm"
  },
  "models": [
    {
      "args": [
        "--block-size",
        "128",
        "--dtype",
        "bfloat16",
        "--distributed_executor_backend",
        "mp",
        "--enable_chunked_prefill",
        "--enforce-eager",
        "--max-num-batched-tokens",
        "2048",
        "--max-num-seqs",
        "256",
        "--enable-prefix-caching",
        "--enable-auto-tool-choice",
        "--tool-call-parser",
        "hermes",
        "--tensor-parallel-size",
        "1"
      ],
      "category": "llm",
      "cpu": 8,
      "env": {
        "HF_HUB_DISABLE_XET": "1",
        "TRITON_CACHE_DIR": "/tmp/.triton",
        "USER": "vllm",
        "VLLM_ALLOW_LONG_MAX_MODEL_LEN": "1",
        "VLLM_CPU_KVCACHE_SPACE": "6",
        "VLLM_CPU_NUM_OF_RESERVED_CPU": "0",
        "VLLM_CPU_SGL_KERNEL": "1",
        "VLLM_ENGINE_ITERATION_TIMEOUT_S": "120",
        "VLLM_RPC_TIMEOUT": "100000"
      },
      "memory": "11Gi",
      "model_id": "Qwen/Qwen3-1.7B",
      "name": "qwen3-1-7b",
      "runtime": "vllm",
      "server_version": "0.28.0"
    },
    {
      "args": [
        "--block-size",
        "128",
        "--dtype",
        "bfloat16",
        "--max-num-seqs",
        "8",
        "--tensor-parallel-size",
        "1"
      ],
      "category": "llm",
      "cpu": 8,
      "env": {
        "HF_HUB_DISABLE_XET": "1",
        "HOME": "/tmp",
        "USER": "vllm",
        "VLLM_ALLOW_LONG_MAX_MODEL_LEN": "1",
        "VLLM_CACHE_ROOT": "/tmp/vllm",
        "VLLM_CPU_KVCACHE_SPACE": "4",
        "VLLM_CPU_SGL_KERNEL": "1",
        "XDG_CACHE_HOME": "/tmp/.cache"
      },
      "memory": "16Gi",
      "model_id": "Qwen/Qwen3Guard-Gen-0.6B",
      "name": "qwen3guard",
      "runtime": "vllm",
      "server_version": "0.28.0"
    }
  ],
  "runtimes": {
    "vllm": {
      "categories": {
        "llm": {
          "args": [
            "--dtype",
            "bfloat16",
            "--max-num-seqs",
            "128",
            "--max-num-batched-tokens",
            "2048",
            "--enable-prefix-caching",
            "--enable-chunked-prefill"
          ],
          "defaults": {
            "cpu": 8,
            "kv_cache_gb": 8,
            "memory": "16Gi"
          },
          "env": {
            "VLLM_CPU_KVCACHE_SPACE": "${KV_CACHE_GB}"
          }
        }
      },
      "default_version": "0.24.0"
    }
  }
}
