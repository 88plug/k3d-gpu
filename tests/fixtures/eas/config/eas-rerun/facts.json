      ],
      "schema": "k3d-gpu.fit/v1",
      "summary": "fit: Qwen/Qwen2.5-Coder-7B-Instruct on CPU via vllm"
    },
    "meta-llama/Llama-3.1-8B-Instruct": {
      "fits": true,
      "flags": [
        "--max-model-len=32768",
        "--max-num-seqs=4",
        "VLLM_CPU_KVCACHE_SPACE=64"
      ],
      "schema": "k3d-gpu.fit/v1",
      "summary": "fit: meta-llama/Llama-3.1-8B-Instruct on CPU via vllm"
