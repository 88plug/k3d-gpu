==> Accelerators: intel npu hybrid
==> Experimental features (auto): dra image-volume npu-turbo
==> Creating k3d cluster 'gpu' with image cryptoandcoffee/k3d-gpu:<version>...
==> kubectl for this cluster: export KUBECONFIG=<run>/home/.local/state/k3d-gpu/kubeconfig-gpu
==> Waiting for nodes Ready...
==> Waiting for cluster DNS (CoreDNS)...
==> intel device plugin auto-deployed by k3s.
==> npu device plugin auto-deployed by k3s.
==> hybrid device plugin auto-deployed by k3s.
==> Configuring intel GPU device plugin: -shared-dev-num=8 -allocation-policy=balanced
==> Applying experimental OpenVINO plugin config (ConfigMap default/k3d-gpu-openvino-experimental)...
==> Verifying accelerators are schedulable...
==> Accelerators schedulable: intel=8 npu=1 hybrid=1. Try: k3d-gpu test
exit=0
--- calls
k3d cluster create gpu
  --image=cryptoandcoffee/k3d-gpu:<version>
  --no-lb
  --k3s-arg=--disable=traefik@server:0
  --k3s-arg=--disable=intel-gpu-dra@server:0
  --k3s-node-label=nvidia.com/gpu.present=false@server:*;agent:*
  --k3s-node-label=intel.feature.node.kubernetes.io/npu=true@server:*;agent:*
  --k3s-node-label=k3d-gpu.io/npu-render-gid=<gid>@server:*;agent:*
  --k3s-node-label=k3d-gpu.io/hybrid-cpu=true@server:*;agent:*
  --k3s-node-label=gpu.intel.com/xmx=false@server:*;agent:*
  --k3s-node-label=gpu.intel.com/media-vcs=2@server:*;agent:*
  --k3s-node-label=gpu.intel.com/media-vecs=1@server:*;agent:*
  --k3s-node-label=k3d-gpu.io/npu.gen=37xx@server:*;agent:*
  --k3s-node-label=feature.node.kubernetes.io/cpu-cpuid.AVXVNNI=true@server:*;agent:*
  --k3s-node-label=experimental.k3d-gpu.io/dra=true@server:*;agent:*
  --k3s-node-label=experimental.k3d-gpu.io/image-volume=true@server:*;agent:*
  --k3s-node-label=experimental.k3d-gpu.io/npu-turbo=true@server:*;agent:*
  --kubeconfig-update-default=false
k3d kubeconfig get gpu
  
kubectl --context k3d-gpu wait --for=condition=Ready nodes --all --timeout=120s
kubectl --context k3d-gpu -n kube-system get deployment/coredns
kubectl --context k3d-gpu -n kube-system rollout status deployment/coredns --timeout=180s
kubectl --context k3d-gpu -n kube-system get daemonset intel-gpu-plugin
kubectl --context k3d-gpu -n kube-system get daemonset intel-npu-plugin
kubectl --context k3d-gpu -n kube-system get daemonset nri-resource-policy-balloons
kubectl --context k3d-gpu -n kube-system get daemonset intel-gpu-plugin -o jsonpath={.spec.template.spec.containers[0].args}
kubectl --context k3d-gpu -n kube-system rollout status daemonset/intel-gpu-plugin --timeout=60s
kubectl --context k3d-gpu get nodes -o go-template={{range .items}}{{range $k, $v := .status.allocatable}}{{$k}} {{$v}}{{"\n"}}{{end}}{{end}}
kubectl --context k3d-gpu apply -f -
kubectl --context k3d-gpu -n kube-system rollout status daemonset/intel-gpu-plugin --timeout=120s
kubectl --context k3d-gpu get nodes -o go-template={{range .items}}{{range $k, $v := .status.allocatable}}{{$k}} {{$v}}{{"\n"}}{{end}}{{end}}
kubectl --context k3d-gpu -n kube-system rollout status daemonset/intel-npu-plugin --timeout=120s
kubectl --context k3d-gpu get nodes -o go-template={{range .items}}{{range $k, $v := .status.allocatable}}{{$k}} {{$v}}{{"\n"}}{{end}}{{end}}
kubectl --context k3d-gpu -n kube-system rollout status daemonset/nri-resource-policy-balloons --timeout=120s
kubectl --context k3d-gpu get nodes -l k3d-gpu.io/hybrid-cpu=true -o name
