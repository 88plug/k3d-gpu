{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/88plug/k3d-gpu/blob/main/oracle/schema/bundle-v1.json",
  "title": "k3d-gpu capacity-oracle bundle v1",
  "description": "What `k3d-gpu share` sends and nothing else. Every object is closed (additionalProperties false) and every string is an enum, a fixed pattern or a hash, so no free text can carry an identifier. oracle/project.py is the projection that fills it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "week", "content_sha256", "client_signature", "provenance", "tool",
               "comparison_key", "workload", "hardware", "power", "levers", "ab", "results"],
  "properties": {
    "schema": {"const": "k3d-gpu.oracle.bundle/1"},
    "kind": {"enum": ["capacity", "single_stream"]},
    "week": {"type": "string", "pattern": "^20[0-9]{2}-W(0[1-9]|[1-4][0-9]|5[0-3])$",
             "description": "ISO week of the run, never a timestamp"},
    "content_sha256": {"$ref": "#/$defs/hex64"},
    "client_signature": {
      "type": "object", "additionalProperties": false, "required": ["kind"],
      "properties": {"kind": {"enum": ["none"]}}
    },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["source", "note"],
      "properties": {
        "source": {"enum": ["community", "maintainer-lab"]},
        "note": {"enum": ["none", "ledger-H6"]}
      }
    },
    "tool": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "k3s", "server_image", "node_image_digest"],
      "properties": {
        "version": {"type": "string", "pattern": "^([0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}|git-[0-9a-f]{40})$"},
        "k3s": {"type": ["string", "null"], "pattern": "^v[0-9]{1,2}\\.[0-9]{1,3}\\.[0-9]{1,3}\\+k3s[0-9]{1,2}$"},
        "server_image": {"type": ["string", "null"],
                         "pattern": "^[a-z0-9]+([._/-][a-z0-9]+)*@sha256:[0-9a-f]{64}$", "maxLength": 160},
        "node_image_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "comparison_key": {"$ref": "#/$defs/hex64"},
    "workload": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "trace", "slo_s", "stop_slo_s", "reps", "max_agents", "time_scale", "thinking", "model", "single_stream"],
      "properties": {
        "protocol": {"enum": ["apb-v1", "single-stream-v1"]},
        "trace": {"enum": ["support", "coding", null]},
        "slo_s": {"type": ["number", "null"], "minimum": 0.001, "maximum": 3600},
        "stop_slo_s": {"type": ["number", "null"], "minimum": 0.001, "maximum": 3600},
        "reps": {"type": ["integer", "null"], "minimum": 1, "maximum": 100},
        "max_agents": {"type": ["integer", "null"], "minimum": 1, "maximum": 4096},
        "time_scale": {"type": ["number", "null"], "minimum": 0, "maximum": 100,
                       "description": "multiplier on the trace's tool waits; 1 is the real trace"},
        "thinking": {"enum": ["off", "on", "default"]},
        "model": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "revision", "weights_sha256", "weights_bytes", "quant"],
          "properties": {
            "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}/[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"},
            "revision": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
            "weights_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
            "weights_bytes": {"type": ["integer", "null"], "minimum": 1},
            "quant": {"enum": ["int4", "int8", "fp8", "fp16", "bf16", "fp32", "unknown"]}
          }
        },
        "single_stream": {
          "type": ["object", "null"], "additionalProperties": false,
          "required": ["rounds", "per_round", "ignore_eos", "decode", "prefill"],
          "properties": {
            "rounds": {"type": "integer", "minimum": 1, "maximum": 100},
            "per_round": {"type": "integer", "minimum": 1, "maximum": 1000},
            "ignore_eos": {"type": "boolean"},
            "decode": {"$ref": "#/$defs/shape"},
            "prefill": {"$ref": "#/$defs/shape"}
          }
        }
      }
    },
    "hardware": {
      "type": "object", "additionalProperties": false,
      "required": ["cpu", "memory", "intel_gpus", "npus", "gaudi", "dsa", "iaa", "qat", "nvidia", "kernel"],
      "properties": {
        "cpu": {
          "type": "object", "additionalProperties": false,
          "required": ["model", "family", "model_id", "stepping", "microcode", "sockets", "numa_nodes", "snc",
                       "hybrid", "p_core_cpus", "e_core_cpus", "logical_cpus", "isa", "amx"],
          "properties": {
            "model": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9 ()@.,+_-]{0,95}$"},
            "family": {"type": ["integer", "null"], "minimum": 0, "maximum": 4095},
            "model_id": {"type": ["integer", "null"], "minimum": 0, "maximum": 4095},
            "stepping": {"type": ["integer", "null"], "minimum": 0, "maximum": 255},
            "microcode": {"type": ["string", "null"], "pattern": "^0x[0-9a-f]{1,8}$"},
            "sockets": {"type": ["integer", "null"], "minimum": 1, "maximum": 64},
            "numa_nodes": {"type": ["integer", "null"], "minimum": 1, "maximum": 1024},
            "snc": {"type": ["integer", "null"], "minimum": 2, "maximum": 8},
            "hybrid": {"type": "boolean"},
            "p_core_cpus": {"type": ["integer", "null"], "minimum": 1, "maximum": 65536},
            "e_core_cpus": {"type": ["integer", "null"], "minimum": 1, "maximum": 65536},
            "logical_cpus": {"type": ["integer", "null"], "minimum": 1, "maximum": 65536},
            "isa": {"type": "array", "maxItems": 64, "items": {"type": "string", "pattern": "^(avx[a-z0-9_]{0,20}|fma|f16c)$"}},
            "amx": {"type": "array", "maxItems": 16, "items": {"type": "string", "pattern": "^amx_[a-z0-9_]{1,16}$"}}
          }
        },
        "memory": {
          "type": "object", "additionalProperties": false,
          "required": ["total_gib", "type", "channels", "configured_mts"],
          "properties": {
            "total_gib": {"type": ["integer", "null"], "minimum": 1, "maximum": 65536},
            "type": {"enum": ["DDR4", "DDR5", "LPDDR4", "LPDDR5", "LPDDR5X", "HBM", null]},
            "channels": {"type": ["integer", "null"], "minimum": 1, "maximum": 64},
            "configured_mts": {"type": ["integer", "null"], "minimum": 400, "maximum": 20000}
          }
        },
        "intel_gpus": {"type": "array", "maxItems": 16, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["device_id", "platform", "driver", "xmx", "engines", "guc", "huc"],
          "properties": {
            "device_id": {"$ref": "#/$defs/pci_id"},
            "platform": {"$ref": "#/$defs/platform"},
            "driver": {"enum": ["i915", "xe", null]},
            "xmx": {"type": ["boolean", "null"]},
            "engines": {
              "type": "object", "additionalProperties": false,
              "required": ["render", "copy", "compute", "video", "video_enhance"],
              "properties": {
                "render": {"$ref": "#/$defs/count"}, "copy": {"$ref": "#/$defs/count"},
                "compute": {"$ref": "#/$defs/count"}, "video": {"$ref": "#/$defs/count"},
                "video_enhance": {"$ref": "#/$defs/count"}
              }
            },
            "guc": {"$ref": "#/$defs/fw_version"},
            "huc": {"$ref": "#/$defs/fw_version"}
          }
        }},
        "npus": {"type": "array", "maxItems": 8, "items": {
          "type": "object", "additionalProperties": false, "required": ["device_id", "platform"],
          "properties": {"device_id": {"$ref": "#/$defs/pci_id"}, "platform": {"$ref": "#/$defs/platform"}}
        }},
        "gaudi": {
          "type": "object", "additionalProperties": false, "required": ["devices"],
          "properties": {"devices": {"$ref": "#/$defs/count"}}
        },
        "dsa": {"$ref": "#/$defs/idxd"},
        "iaa": {"$ref": "#/$defs/idxd"},
        "qat": {"type": "array", "maxItems": 32, "items": {
          "type": "object", "additionalProperties": false, "required": ["device_id", "vfs"],
          "properties": {"device_id": {"$ref": "#/$defs/pci_id"}, "vfs": {"$ref": "#/$defs/count"}}
        }},
        "nvidia": {
          "type": "object", "additionalProperties": false, "required": ["driver", "gpus"],
          "properties": {
            "driver": {"type": ["string", "null"], "pattern": "^[0-9]{2,4}\\.[0-9]{1,3}$"},
            "gpus": {"type": "array", "maxItems": 16, "items": {
              "type": "object", "additionalProperties": false, "required": ["device_id", "model"],
              "properties": {
                "device_id": {"$ref": "#/$defs/pci_id"},
                "model": {"type": ["string", "null"], "pattern": "^NVIDIA [A-Za-z0-9 ()._-]{1,80}$"}
              }
            }}
          }
        },
        "kernel": {"type": ["string", "null"], "pattern": "^[0-9]{1,2}\\.[0-9]{1,3}$"}
      }
    },
    "power": {
      "type": "object", "additionalProperties": false,
      "required": ["pl1_w", "pl2_w", "epp", "platform_profile"],
      "properties": {
        "pl1_w": {"type": ["integer", "null"], "minimum": 1, "maximum": 2000},
        "pl2_w": {"type": ["integer", "null"], "minimum": 1, "maximum": 4000},
        "epp": {"enum": ["default", "performance", "balance_performance", "balance_power", "power", null]},
        "platform_profile": {"enum": ["low-power", "cool", "quiet", "balanced", "balanced-performance", "performance", "custom", null]}
      }
    },
    "levers": {"type": "array", "maxItems": 32, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "detected", "state"],
      "properties": {
        "id": {"$ref": "#/$defs/lever"},
        "detected": {"type": "boolean"},
        "state": {"enum": ["on", "off", "unknown"]}
      }
    }},
    "ab": {
      "type": ["object", "null"], "additionalProperties": false, "required": ["lever", "arm", "pair_nonce"],
      "properties": {
        "lever": {"$ref": "#/$defs/lever"},
        "arm": {"enum": ["on", "off"]},
        "pair_nonce": {"type": "string", "pattern": "^[0-9a-f]{24}$",
                       "description": "random per A/B session; links its two arms and nothing else"}
      }
    },
    "results": {
      "type": "object", "additionalProperties": false, "required": ["engine", "server", "capacity", "single_stream"],
      "properties": {
        "engine": {"enum": ["cpu", "igpu", "npu", "gaudi", "nvidia", "unspecified"]},
        "server": {"enum": ["ovms", "vllm", "unknown"]},
        "capacity": {
          "type": ["object", "null"], "additionalProperties": false,
          "required": ["agents_per_box", "binding_limit", "idle_pkg_w", "drift_ratio", "quiet_check_ok", "steps"],
          "properties": {
            "agents_per_box": {"type": "integer", "minimum": 0, "maximum": 4096,
                               "description": "claimed by the client; the validator recomputes it from the samples"},
            "binding_limit": {"enum": ["slo", "errors", "tool_validity", "insufficient_data", "fail", "max_reached", "ramp_incomplete"]},
            "idle_pkg_w": {"type": ["number", "null"], "minimum": 0, "maximum": 4000},
            "drift_ratio": {"type": ["number", "null"], "minimum": 0, "maximum": 1000},
            "quiet_check_ok": {"type": "boolean"},
            "steps": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/step"}}
          }
        },
        "single_stream": {
          "type": ["object", "null"], "additionalProperties": false, "required": ["decode", "prefill"],
          "properties": {"decode": {"$ref": "#/$defs/ss_samples"}, "prefill": {"$ref": "#/$defs/ss_samples"}}
        }
      }
    }
  },
  "$defs": {
    "hex64": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pci_id": {"type": "string", "pattern": "^0x[0-9a-f]{4}$"},
    "count": {"type": "integer", "minimum": 0, "maximum": 4096},
    "platform": {"type": ["string", "null"], "pattern": "^[A-Z][A-Za-z0-9 /-]{1,31}$"},
    "fw_version": {"type": ["string", "null"], "pattern": "^[0-9]{1,3}(\\.[0-9]{1,4}){1,3}$"},
    "idxd": {
      "type": "object", "additionalProperties": false, "required": ["devices", "work_queues"],
      "properties": {"devices": {"$ref": "#/$defs/count"}, "work_queues": {"$ref": "#/$defs/count"}}
    },
    "lever": {"enum": ["pe_pinning", "prefill_guard", "xmx_gate", "amx", "numa_replica", "openvino_int4",
                       "npu_offload", "media_engines", "qat", "iaa_zswap", "dsa_dto", "rdt", "kv_u4",
                       "spec_decode", "itd"]},
    "shape": {
      "type": "object", "additionalProperties": false, "required": ["prompt_tokens", "max_tokens"],
      "properties": {
        "prompt_tokens": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "max_tokens": {"type": "integer", "minimum": 1, "maximum": 1048576}
      }
    },
    "us": {"type": ["integer", "null"], "minimum": 0, "maximum": 86400000000},
    "us_list": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/us"}},
    "int_list": {"type": "array", "maxItems": 100000, "items": {"type": ["integer", "null"], "minimum": 0, "maximum": 10000000}},
    "bit_list": {"type": "array", "maxItems": 100000, "items": {"enum": [0, 1]}},
    "rep": {
      "description": "One rep of one step, column-wise: row i is request i. All columns have the same length. session is renumbered 0..k-1; times are integer microseconds from the rep start.",
      "type": "object", "additionalProperties": false,
      "required": ["session", "sent_us", "e2e_us", "ttft_us", "out_tok", "err", "expect_tool", "tool_valid"],
      "properties": {
        "session": {"$ref": "#/$defs/int_list"},
        "sent_us": {"$ref": "#/$defs/us_list"},
        "e2e_us": {"$ref": "#/$defs/us_list"},
        "ttft_us": {"$ref": "#/$defs/us_list"},
        "out_tok": {"$ref": "#/$defs/int_list"},
        "err": {"$ref": "#/$defs/bit_list"},
        "expect_tool": {"$ref": "#/$defs/bit_list"},
        "tool_valid": {"$ref": "#/$defs/bit_list"}
      }
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["agents", "claimed_p95_us", "claimed_verdict", "j_per_turn_pkg", "pkg_w_mean",
                   "energy_seconds", "energy_turns", "throttle_events", "cpu_busy_mean", "reps"],
      "properties": {
        "agents": {"type": "integer", "minimum": 1, "maximum": 4096},
        "claimed_p95_us": {"$ref": "#/$defs/us"},
        "claimed_verdict": {"enum": ["pass", "fail", "insufficient"]},
        "j_per_turn_pkg": {"type": ["number", "null"], "minimum": 0, "maximum": 1000000},
        "pkg_w_mean": {"type": ["number", "null"], "minimum": 0, "maximum": 4000},
        "energy_seconds": {"type": ["number", "null"], "minimum": 0, "maximum": 1000000},
        "energy_turns": {"type": ["integer", "null"], "minimum": 0, "maximum": 10000000},
        "throttle_events": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000000},
        "cpu_busy_mean": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "reps": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"$ref": "#/$defs/rep"}}
      }
    },
    "ss_samples": {
      "description": "Single-stream requests, column-wise: round index, end-to-end and time-to-first-token in microseconds, output and prompt tokens.",
      "type": "object", "additionalProperties": false,
      "required": ["round", "e2e_us", "ttft_us", "out_tok", "prompt_tok"],
      "properties": {
        "round": {"$ref": "#/$defs/int_list"},
        "e2e_us": {"$ref": "#/$defs/us_list"},
        "ttft_us": {"$ref": "#/$defs/us_list"},
        "out_tok": {"$ref": "#/$defs/int_list"},
        "prompt_tok": {"$ref": "#/$defs/int_list"}
      }
    }
  }
}
