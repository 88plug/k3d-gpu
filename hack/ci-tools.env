# Tool versions the CI and release workflows install, one KEY=value per line. They
# live here, outside .github/workflows/, so a bump is a change to this file: a token
# without the `workflows` permission can push it, and pins/classes classes it ours.
# A job loads them in its first step after checkout:
#   grep -E '^[A-Z0-9_]+=' hack/ci-tools.env >> "$GITHUB_ENV"
# and reads them as ${{ env.KEY }} (action inputs) or $KEY (run steps).
# tests/ci_wiring_test.sh fails on a version literal left in a workflow.

# prometheus/prometheus: promtool checks the telemetry rules (ci.yml telemetry-tests).
PROMETHEUS_VERSION=3.16.0
PROMETHEUS_SHA256=68727009472a2c02e1ff7f062fd5b3e637285bffc8fc2d340c76fb449d6e0f34

# yannh/kubeconform: the release binary (chat-ui-manifest, kserve-example) and the
# image (telemetry-tests and tests/kubeconform.sh, agent_kubeconform.sh,
# share_kubeconform.sh), the same release.
KUBECONFORM_VERSION=v0.8.0
KUBECONFORM_SHA256=9bc2bffbf71f261128533edaf912153948b7ff238f9a531ae6d34466ec287883
KUBECONFORM_IMAGE=ghcr.io/yannh/kubeconform:v0.8.0@sha256:faffaf43f95aa6425306e1ab8d6fcad72acb9049158f38e574c085ea1ec0f64e

# Chrome for Testing: report.html's offline load (report-html).
CHROME_VERSION=157.0.8103.38

# python-jsonschema: the facts/v1 schema cross-check (console-tests).
JSONSCHEMA_VERSION=4.26.0

# helm v4 for the KServe example's install path (kserve-example). Rendering share/
# uses the v3 line in hack/tools.env.
HELM4_VERSION=v4.3.1

# koalaman/shellcheck, run by ludeeus/action-shellcheck (shellcheck).
SHELLCHECK_VERSION=v0.11.0

# pypa/packaging for hack/bump-convert-pins (freshness.yml bump, ci.yml pins).
PACKAGING_VERSION=26.3
