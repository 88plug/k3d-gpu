# Container images the CI workflow (.github/workflows/ci.yml) runs, pinned by
# digest. They live here, outside .github/workflows/, so the Freshness workflow
# moves them: its GITHUB_TOKEN cannot push a workflow file.

# rhysd/actionlint 1.7.12 (bundles shellcheck for run: blocks).
ACTIONLINT_IMAGE=rhysd/actionlint:1.7.12@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667

# Arch is rolling: pacman needs a current keyring, so the tag stays latest and
# scripts/images-lock repin moves the digest beside it (images.unpinned).
ARCHLINUX_IMAGE=archlinux:latest@sha256:b1c2fe6e717bfd5673af8fc217e1e1c3ce0dcbb1d53c3414c8425e7ce79fc6d9
